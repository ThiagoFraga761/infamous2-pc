+/*
+ * Edge Geometry's EdgeGeomViewportInfo, as an SPU job reads it: a 128-byte
+ * GET starting u16 scissor {0, 0, 1280, 720}, depth range {-1, 1}. The job
+ * culls triangles that cover no pixel centre of that viewport. Rendering at
+ * N times the resolution, those triangles do cover pixels, and the culled ones
+ * show as holes in skin and other dense meshes. Scaling the job's copy of
+ * scissor, viewportScales (+80) and viewportOffsets (+96) makes it cull for
+ * the raster the host draws. PS3RECOMP_EDGE_VP=0 turns it off.
+ */
+static inline void spu_edge_viewport_scale(uint8_t* p)
+{
+    static const uint8_t sig[16] = { 0,0,0,0, 0x05,0x00,0x02,0xD0, 0xBF,0x80,0,0, 0x3F,0x80,0,0 };
+    static _Atomic int s_n = -1;
+    int n = __atomic_load_n(&s_n, __ATOMIC_RELAXED);
+    if (n < 0) {
+        const char* e = getenv("PS3RECOMP_EDGE_VP");
+        const char* r = getenv("PS3RECOMP_RES_SCALE");
+        n = (e && e[0] == '0') ? 1 : (r ? atoi(r) : 1);
+        if (n < 1) n = 1;
+        if (n > 4) n = 4;   /* vk_res_scale's clamp */
+        __atomic_store_n(&s_n, n, __ATOMIC_RELAXED);
+    }
+    if (n == 1 || memcmp(p, sig, 16)) return;
+    const uint32_t w = 1280u * (uint32_t)n, h = 720u * (uint32_t)n;
+    p[4] = (uint8_t)(w >> 8); p[5] = (uint8_t)w;
+    p[6] = (uint8_t)(h >> 8); p[7] = (uint8_t)h;
+    static const int offs[4] = { 80, 84, 96, 100 };
+    for (int i = 0; i < 4; i++) {
+        uint8_t* q = p + offs[i];
+        uint32_t u = ((uint32_t)q[0] << 24) | ((uint32_t)q[1] << 16) | ((uint32_t)q[2] << 8) | q[3];
+        float f; memcpy(&f, &u, 4); f *= (float)n; memcpy(&u, &f, 4);
+        q[0] = (uint8_t)(u >> 24); q[1] = (uint8_t)(u >> 16); q[2] = (uint8_t)(u >> 8); q[3] = (uint8_t)u;
+    }
+}
