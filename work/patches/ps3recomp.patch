+static void hle_sys_spu_printf_initialize(ppu_context* ctx)
+{
+    for (int i = 0; i < 4; i++) s_spu_printf_cb[i] = (uint32_t)ctx->gpr[3 + i];
+    ctx->gpr[3] = 0;
