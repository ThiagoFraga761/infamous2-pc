+    __m128i r, ok, a, b, c;
+    memcpy(&r, &p->r, 16); memcpy(&ok, &p->ok, 16);
+    memcpy(&a, &p->a, 16); memcpy(&b, &p->b, 16); memcpy(&c, &p->c, 16);
+    /* SPU_FIX_STATS=1: why float lanes take this path -- an exponent-255
+     * operand, a denormal operand, or neither (the result at or past FLT_MAX,
+     * or a boundary the vector could not settle) -- every 2^20 lanes. */
+    { static int st = -1;
+      if (st < 0) st = getenv("SPU_FIX_STATS") ? 1 : 0;
+      if (st && p->op != SPU_COLD_CXFLT) {
+          static unsigned long long n[3][3];
+          uint32_t m[4], x[4], y[4], z[4];
+          memcpy(m, &ok, 16); memcpy(x, &a, 16); memcpy(y, &b, 16); memcpy(z, &c, 16);
+          const int k = p->op == SPU_COLD_FA ? 0 : p->op == SPU_COLD_FM ? 1 : 2;
+          for (int i = 0; i < 4; i++) {
+              if (m[i]) continue;
+              const uint32_t v[3] = { x[i], y[i], k == 2 ? z[i] : 0 };
+              int e255 = 0, den = 0;
