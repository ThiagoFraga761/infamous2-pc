+SPU__AV_INLINE u128 spu__av_fa(u128 a, u128 b, uint32_t negb) {
+    const __m128i xa = spu__av_ld(a), yb = spu__av_ld(b);
+    const __m128i x = xa, y = _mm_xor_si128(yb, _mm_set1_epi32((int)negb));
+    /* the exponent-gap limit applies only between two nonzero terms */
+    const __m128i near = _mm_cmpgt_epi32(_mm_set1_epi32(30),
+                                         _mm_abs_epi32(_mm_sub_epi32(spu__av_bexp(x), spu__av_bexp(y))));
+    const __m128i pre = _mm_and_si128(_mm_and_si128(spu__av_plain0(x), spu__av_plain0(y)),
+                                      _mm_or_si128(near, _mm_or_si128(spu__av_iszero(x), spu__av_iszero(y))));
+    __m128i ok;
+    __m128i r = spu__av_trunc0(_mm256_add_pd(spu__av_wide(x), spu__av_wide(y)), &ok, NULL);
+    ok = _mm_and_si128(ok, pre);
+    if (!spu__av_all4(ok)) r = spu__av_fa_fix(r, ok, xa, yb, negb);
+    return spu__av_st(r);
