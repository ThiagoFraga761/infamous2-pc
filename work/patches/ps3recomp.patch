+ * 15 characters; elsewhere a no-op. */
+#ifndef PS3_THREAD_NAME_H
+#define PS3_THREAD_NAME_H
+
+#if defined(__linux__)
+#include <pthread.h>
+#include <stdio.h>
+#endif
+
+#ifdef __cplusplus
+static inline void ps3_thread_name(const char* prefix, const char* name)
+#else
+static __inline void ps3_thread_name(const char* prefix, const char* name)
+#endif
+{
+#if defined(__linux__)
+    char b[16];
+    snprintf(b, sizeof b, "%s%s", prefix ? prefix : "", name ? name : "");
+    pthread_setname_np(pthread_self(), b);
+#else
+    (void)prefix; (void)name;
+#endif
+}
