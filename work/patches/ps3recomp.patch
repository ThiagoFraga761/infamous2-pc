+SPU__AV_INLINE u128 spu__av_fm(u128 a, u128 b) {
+    const __m128i x = spu__av_ld(a), y = spu__av_ld(b);
+    __m128i ok;
+    __m128i r = spu__av_trunc0(_mm256_mul_pd(spu__av_wide(x), spu__av_wide(y)), &ok, NULL);
+    ok = _mm_and_si128(ok, _mm_and_si128(spu__av_plain0(x), spu__av_plain0(y)));
+    if (!spu__av_all4(ok)) r = spu__av_fm_fix(r, ok, x, y);
+    return spu__av_st(r);
+}
+/* spu__nv_twosum. The product feeding it is exact in double, so a compiler that contracts the
+ * multiply into the add (GCC defaults to -ffp-contract=fast) computes the same sum. */
+SPU__AV_INLINE __m256d spu__av_twosum(__m256d p, __m256d z, __m256d* err) {
+    const __m256d s = _mm256_add_pd(p, z), bb = _mm256_sub_pd(s, p);
+    *err = _mm256_add_pd(_mm256_sub_pd(p, _mm256_sub_pd(s, bb)), _mm256_sub_pd(z, bb));
+    return s;
+}
+SPU__AV_INLINE u128 spu__av_fma(u128 a, u128 b, u128 c, uint32_t negp, uint32_t negc) {
+    const __m128i xa = spu__av_ld(a), y = spu__av_ld(b), zc = spu__av_ld(c);
+    const __m128i x = _mm_xor_si128(xa, _mm_set1_epi32((int)negp)), z = _mm_xor_si128(zc, _mm_set1_epi32((int)negc));
+    __m256d e;
+    const __m256d s = spu__av_twosum(_mm256_mul_pd(spu__av_wide(x), spu__av_wide(y)), spu__av_wide(z), &e);
+    __m128i ok;
+    __m128i r = spu__av_trunc0(s, &ok, &e);
+    ok = _mm_and_si128(ok, _mm_and_si128(_mm_and_si128(spu__av_plain0(x), spu__av_plain0(y)), spu__av_plain0(z)));
+    if (!spu__av_all4(ok)) r = spu__av_fma_fix(r, ok, xa, y, zc, negp, negc);
+    return spu__av_st(r);
