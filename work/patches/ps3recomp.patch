+            ops[0] = 0;
+            rsx_fp_decompile_buffered_ex2(prog, sizeof(prog), CTRL_32BIT, 0, ops,
+                                          hlsl, sizeof(hlsl), &nk);
+            check_absent("texop_bx2_float_untouched", hlsl, "* 2.0 - 1.0");
+            check_absent("texop_none_no_helper", hlsl, "rsx_texop(");
+            put_word(prog + 0, OPC(0x17) | OUTMASK_ALL | OUTREG(1) | INSRC(4) | TEXU(0));
