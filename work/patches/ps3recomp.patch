+static pthread_t s_pcache_thread;
+static int s_pcache_thread_on;           /* started, not yet joined */
+static void* vk_pcache_writer(void* arg)
+{
+    const u64 n = (u64)(uintptr_t)arg;
+    /* Not written: those pipelines count towards the next write. */
+    if (vk_pcache_write()) __atomic_add_fetch(&s_pcache_new, n, __ATOMIC_RELAXED);
+    __atomic_store_n(&s_pcache_writing, 0, __ATOMIC_RELEASE);
+    return NULL;
