+/* Mode 1: the GPU's lighting is what the game samples (set by a successful
+ * substitution, cleared by a failure; s_nlt_sub_latch is the pair it was of),
+ * and the job just started may skip. */
+static volatile int s_nlt_live, s_nlt_skip;
+static volatile u32 s_nlt_sub_latch;
