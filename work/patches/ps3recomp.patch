+# ---------------------------------------------------------------------------
+# Register localization (--local-regs)
+# ---------------------------------------------------------------------------
+# Every lifted statement reads and writes the guest registers in ctx. Guest
+# memory goes through char pointers (vm_base), so after ctx has been handed to
+# any call the compiler cannot prove a guest store does not reach it: each
+# register value reaches its next use through memory, and dead register stores
+# cannot be dropped. With --local-regs, a function keeps GPRs, CR, XER, LR and
+# CTR in C locals and syncs them with ctx only where something else can look
+# at ctx:
+#   - a "sync" line (a call to a lifted function, an indirect call, a syscall,
+#     an HLE call, anything else handed ctx) runs unchanged against ctx: the
+#     locals that may be dirty are written back before it, and the locals that
+#     are live after it are reloaded;
+#   - an exit (return, trampoline hand-off, the default arm of a jump table)
+#     runs unchanged against ctx after a write-back of the dirty locals.
+# Dirty = may have been written since the last write-back or reload (forward
+# dataflow over the line CFG); live = may be read before the next definite
+# write (backward dataflow, a write-back counting as a read). Clang turns the
+# locals into SSA values (their address only reaches always-inline helpers), so
+# guest memory accesses no longer pin them. FPRs, VRs, FPSCR, VSCR and the
+# reservation stay in ctx. A function with a line shape the pass does not
+# recognise is emitted unchanged (counted in LOCAL_REGS_STATS).
+# Limitation: diagnostics that sample a thread's ctx from inside a guest
+# memory slow path (g_active_ctx) can see registers a few instructions stale.
+_LR_REG_RE = re.compile(r"ctx->(?:gpr\[(\d+)\]|(cr|xer|lr|ctr)\b)")
+_LR_SPECIAL = {"cr": 32, "xer": 33, "lr": 34, "ctr": 35}
+_LR_NAMES = [f"_r{n}" for n in range(32)] + ["_cr", "_xer", "_lr", "_ctr"]
+_LR_CTX = [f"ctx->gpr[{n}]" for n in range(32)] + ["ctx->cr", "ctx->xer", "ctx->lr", "ctx->ctr"]
+_LR_TYPES = ["uint64_t"] * 32 + ["uint32_t", "uint32_t", "uint64_t", "uint64_t"]
+# ctx fields the pass leaves in ctx, and helpers that touch only those.
+_LR_SAFE_CTX_RE = re.compile(
+    r"&?ctx->(?:fpr|vr)\[\d+\]|&?ctx->(?:fpscr|vscr|vrsave|reserve_value|reserve_addr|reserve_valid)\b|"
+    r"PPU_RESV_ADDR\(ctx\)|\bppu_(?:mtfsf|mtfsb|mcrfs)\(ctx,")
+_LR_COMMENT_RE = re.compile(r"/\*.*?\*/")
+_LR_LABEL_RE = re.compile(r"loc_[0-9A-Fa-f]+:")
+_LR_GOTO_RE = re.compile(r"\bgoto (loc_[0-9A-Fa-f]+);")
+_LR_WRITE_RE = re.compile(
+    r"ctx->(?:gpr\[(\d+)\]|(cr|xer|lr|ctr)\b)\s*(?:[-+*/%&|^]|<<|>>)?=(?!=)|"
+    r"(?:\+\+|--)\s*ctx->(?:gpr\[(\d+)\]|(cr|xer|lr|ctr)\b)|"
+    r"ctx->(?:gpr\[(\d+)\]|(cr|xer|lr|ctr)\b)\s*(?:\+\+|--)|"
+    r"&ctx->(?:gpr\[(\d+)\]|(cr|xer|lr|ctr)\b)")
+_LR_SWITCH_RE = re.compile(
+    r"switch \((?P<expr>[^{}]*)\) \{(?P<cases>(?:\s*case [^:;{}]+: (?:goto loc_[0-9A-Fa-f]+;|"
+    r"\{ g_trampoline_fn = \(void\(\*\)\(void\*\)\)func_[0-9A-Fa-f_]+; return; \}))+)"
+    r"\s*default: (?P<dflt>[^{}]*return;) \} return;")
+_LR_KW_RE = re.compile(r"^(?:if|else|for|while|do|switch)\b")
+
+LOCAL_REGS_STATS: Counter = Counter()
+
+
+class _LocalRegsUnsupported(Exception):
+    pass
+
+
+def _lr_idx(m) -> int:
+    return int(m.group(1)) if m.group(1) is not None else _LR_SPECIAL[m.group(2)]
+
+
+def _lr_mask(s: str) -> int:
+    mask = 0
+    for m in _LR_REG_RE.finditer(s):
+        mask |= 1 << _lr_idx(m)
+    return mask
+
+
+_LR_PLAIN_LHS_RE = re.compile(r"ctx->(?:gpr\[\d+\]|(?:cr|xer|lr|ctr)\b)\s*=(?!=)")
+
+
+def _lr_reads(s: str) -> int:
+    """Registers s may read: every mention but the target of a plain `=`."""
+    return _lr_mask(_LR_PLAIN_LHS_RE.sub("=", s))
+
+
+def _lr_maydef(s: str) -> int:
+    mask = 0
+    for m in _LR_WRITE_RE.finditer(s):
+        g = m.groups()
+        for k in range(0, 8, 2):
+            if g[k] is not None:
+                mask |= 1 << int(g[k])
+            elif g[k + 1] is not None:
+                mask |= 1 << _LR_SPECIAL[g[k + 1]]
+    return mask
+
+
+def _lr_split_top(s: str, sep: str = ";") -> list[str]:
+    if s.count(sep) <= 1 and "{" not in s:
+        return s.split(sep)
+    out, depth, cur = [], 0, []
+    for ch in s:
+        if ch in "([{":
+            depth += 1
+        elif ch in ")]}":
+            depth -= 1
+        if ch == sep and depth == 0:
+            out.append("".join(cur))
+            cur = []
+        else:
+            cur.append(ch)
+    out.append("".join(cur))
+    return out
+
+
+def _lr_mustdef(t: str) -> int:
+    """Registers a pure line always writes: plain assignments that are
+    top-level statements of the line (or of a plain `{ ... }` block)."""
+    if _LR_KW_RE.match(t):
+        return 0
+    if t.startswith("{") and t.endswith("}"):
+        t = t[1:-1].strip()
+    mask = 0
+    for st in _lr_split_top(t):
+        st = st.strip()
+        if _LR_KW_RE.match(st):
+            continue
+        m = re.match(r"ctx->(?:gpr\[(\d+)\]|(cr|xer|lr|ctr)\b)\s*=(?!=)", st)
+        if m:
+            mask |= 1 << _lr_idx(m)
+    return mask
+
+
+def _lr_rewrite(s: str) -> str:
+    return _LR_REG_RE.sub(lambda m: _LR_NAMES[_lr_idx(m)], s)
+
+
+@functools.lru_cache(maxsize=1 << 18)
+def _lr_rewrite_cached(line: str) -> str:
+    return _lr_rewrite(line)
+
+
+def _lr_touches_ctx(t: str) -> bool:
+    """t hands ctx (or a ctx register it cannot rewrite) to something."""
+    return re.search(r"\bctx\b", _LR_SAFE_CTX_RE.sub("", _LR_REG_RE.sub("", t))) is not None
+
+
+def _lr_balanced(t: str) -> bool:
+    d = {"(": 0, "[": 0, "{": 0}
+    close = {")": "(", "]": "[", "}": "{"}
+    for ch in t:
+        if ch in d:
+            d[ch] += 1
+        elif ch in close:
+            d[close[ch]] -= 1
+            if d[close[ch]] < 0:
+                return False
+    return not any(d.values())
+
+
+def _lr_split_if(t: str):
+    """`if (COND) REST` -> (COND, REST), or None."""
+    if not t.startswith("if ("):
+        return None
+    i, depth = 4, 1
+    while i < len(t) and depth:
+        depth += {"(": 1, ")": -1}.get(t[i], 0)
+        i += 1
+    if depth:
+        return None
+    return t[4:i - 1], t[i:].strip()
+
+
+def _lr_is_exit_body(t: str) -> bool:
+    """t always leaves the function and does not branch inside it."""
+    if t.startswith("{") and t.endswith("}"):
+        t = t[1:-1].strip()
+    if not t.endswith("return;") or len(re.findall(r"\breturn\b", t)) != 1:
+        return False
+    return re.search(r"\b(?:if|else|goto|for|while|do|switch|break|continue)\b", t) is None
+
+
+def _lr_classify(line: str):
+    t = _LR_COMMENT_RE.sub("", line).strip()
+    if _LR_LABEL_RE.fullmatch(t):
+        return ("label", t[:-1])
+    if not t:
+        return ("pure", [])
+    if "/*" in t or "*/" in t or "//" in t or not _lr_balanced(t):
+        raise _LocalRegsUnsupported("comment/unbalanced: " + t[:120])
+    if t.endswith(")") or t.endswith("else") or (not t.endswith(";") and not t.endswith("}")):
+        raise _LocalRegsUnsupported("dangling statement: " + t[:120])
+    exits = re.search(r"\breturn\b|\bg_trampoline_fn\b|longjmp", t) is not None
+    if not exits:
+        if _lr_touches_ctx(t):
+            if re.search(r"\b(?:goto|break|continue)\b", t):
+                raise _LocalRegsUnsupported("control transfer in a sync line: " + t[:120])
+            return ("sync", None)
+        targets = _LR_GOTO_RE.findall(t)
+        if len(re.findall(r"\bgoto\b", t)) != len(targets) or re.search(r"\b(?:break|continue)\b", t):
+            raise _LocalRegsUnsupported("odd goto: " + t[:120])
+        falls = not re.fullmatch(r"goto loc_[0-9A-Fa-f]+;", t)
+        return ("pure", targets, falls)
+    m = _LR_SWITCH_RE.fullmatch(t)
+    if m:
+        if _lr_touches_ctx(m.group("expr")) or not _lr_is_exit_body(m.group("dflt")):
+            raise _LocalRegsUnsupported("switch: " + t[:120])
+        targets = _LR_GOTO_RE.findall(m.group("cases"))
+        if len(re.findall(r"\bgoto\b", t)) != len(targets):
+            raise _LocalRegsUnsupported("switch: " + t[:120])
+        return ("switch", m.group("expr"), targets)
+    sp = _lr_split_if(t)
+    if sp is not None:
+        cond, rest = sp
+        if (_lr_touches_ctx(cond) or re.search(r"\breturn\b|\bg_trampoline_fn\b|\bgoto\b", cond)
+                or not _lr_is_exit_body(rest)):
+            raise _LocalRegsUnsupported("conditional exit: " + t[:120])
+        return ("cond_exit", cond)
+    if _lr_is_exit_body(t):
+        return ("exit", None)
+    raise _LocalRegsUnsupported("unknown exit: " + t[:120])
+
+
+def _lr_strip_comments(line: str) -> tuple[str, str]:
+    """(code without comments, the comments re-joined as a suffix)."""
+    coms = _LR_COMMENT_RE.findall(line)
+    return _LR_COMMENT_RE.sub("", line).strip(), "".join(" " + c for c in coms)
+
+
+@functools.lru_cache(maxsize=1 << 18)
+def _lr_classify_cached(line: str):
+    return _lr_classify(line)
+
+
+@functools.lru_cache(maxsize=1 << 18)
+def _lr_info(s: str, line: bool) -> tuple[int, int, int, int]:
+    """(reads, may-writes, must-writes, mentions) of a pure line or a condition."""
+    t = _LR_COMMENT_RE.sub("", s).strip() if line else s
+    maydef = _lr_maydef(t)
+    return _lr_reads(t), maydef, (_lr_mustdef(t) & maydef) if line else 0, _lr_mask(t)
+
+
+def _lr_wb(mask: int) -> str:
+    return " ".join(f"{_LR_CTX[n]} = {_LR_NAMES[n]};" for n in range(36) if mask >> n & 1)
+
+
+def _lr_reload(mask: int) -> str:
+    return " ".join(f"{_LR_NAMES[n]} = {_LR_CTX[n]};" for n in range(36) if mask >> n & 1)
+
+
+def localize_ppu_registers(lines: list[str]) -> list[str]:
+    """--local-regs pass over one function body (the lines between the opening
+    and the closing brace, labels unindented). See the comment block above."""
+    try:
+        return _localize_ppu_registers(lines)
+    except _LocalRegsUnsupported as e:
+        LOCAL_REGS_STATS["unsupported"] += 1
+        LOCAL_REGS_STATS["why: " + str(e).split(":")[0]] += 1
+        return lines
+
+
+def _localize_ppu_registers(lines: list[str]) -> list[str]:
+    n = len(lines)
+    kinds = [_lr_classify_cached(line) for line in lines]
+    labels = {k[1]: i for i, k in enumerate(kinds) if k[0] == "label"}
+    for k in kinds:
+        tg = k[1] if k[0] == "pure" else k[2] if k[0] == "switch" else ()
+        if any(x not in labels for x in tg):
+            raise _LocalRegsUnsupported("goto to a missing label: " + str(tg)[:120])
+    END = n
+    succ: list[list[int]] = []
+    use = [0] * n       # registers the line's rewritten part may read
+    maydef = [0] * n
+    mustdef = [0] * n
+    used_all = 0
+    for i, k in enumerate(kinds):
+        kind = k[0]
+        if kind == "label" or kind == "sync":
+            succ.append([i + 1])
+            continue
+        if kind == "exit":
+            succ.append([])
+            continue
+        use[i], maydef[i], mustdef[i], mention = _lr_info(lines[i] if kind == "pure" else k[1], kind == "pure")
+        used_all |= mention
+        if kind == "pure":
+            s = [labels[x] for x in k[1]] if len(k) > 1 else []
+            if len(k) < 3 or k[2]:
+                s.append(i + 1)
+            succ.append(s)
+        elif kind == "cond_exit":
+            succ.append([i + 1])
+        else:  # switch
+            succ.append([labels[x] for x in k[2]])
+    if not used_all:
+        LOCAL_REGS_STATS["no registers"] += 1
+        return lines
+    preds: list[list[int]] = [[] for _ in range(n + 1)]
+    for i, s in enumerate(succ):
+        for j in s:
+            preds[j].append(i)
+
+    # Forward: registers that may be dirty on entry to each line.
+    din = [0] * (n + 1)
+    dout = [0] * n
+    seen = [False] * (n + 1)
+    work = [0]
+    seen[0] = True
+    while work:
+        i = work.pop()
+        if i == END:
+            continue
+        kind = kinds[i][0]
+        out = 0 if kind == "sync" else din[i] | maydef[i]
+        dout[i] = out
+        for j in succ[i]:
+            nv = din[j] | out
+            if nv != din[j] or not seen[j]:
+                din[j] = nv
+                seen[j] = True
+                work.append(j)
+    wb = [0] * (n + 1)
+    for i, k in enumerate(kinds):
+        if not seen[i]:
+            continue
+        if k[0] == "sync" or k[0] == "exit":
+            wb[i] = din[i]
+        elif k[0] in ("cond_exit", "switch"):
+            wb[i] = din[i] | maydef[i]
+    wb[END] = din[END] if seen[END] else 0
+
+    # Backward: registers live on entry to each line.
+    lin = [0] * (n + 1)
+    lin[END] = wb[END]
+    lout = [0] * n
+    work = list(range(n + 1))
+    inq = [True] * (n + 1)
+    while work:
+        i = work.pop()
+        inq[i] = False
+        if i == END:
+            new = wb[END]
+        else:
+            out = 0
+            for j in succ[i]:
+                out |= lin[j]
+            lout[i] = out
+            kind = kinds[i][0]
+            if kind == "sync" or kind == "exit":
+                new = wb[i]
+            elif kind in ("cond_exit", "switch"):
+                new = use[i] | wb[i] | out
+            else:
+                new = use[i] | (out & ~mustdef[i])
+        if new != lin[i]:
+            lin[i] = new
+            for p in preds[i]:
+                if not inq[p]:
+                    inq[p] = True
+                    work.append(p)
+
+    allregs = used_all
+    for i in range(n + 1):
+        allregs |= wb[i]
+    decl = []
+    for ty in ("uint64_t", "uint32_t"):
+        parts = [f"{_LR_NAMES[r]} = {_LR_CTX[r]}" for r in range(36)
+                 if allregs >> r & 1 and _LR_TYPES[r] == ty]
+        if parts:
+            decl.append(f"{ty} " + ", ".join(parts) + ";")
+    out_lines = ["    " + " ".join(decl)]
+    LOCAL_REGS_STATS["localized"] += 1
+    for i, line in enumerate(lines):
+        kind = kinds[i][0]
+        ind = line[:len(line) - len(line.lstrip())]
+        if kind == "label":
+            out_lines.append(line)
+        elif kind == "pure":
+            out_lines.append(_lr_rewrite_cached(line))
+        elif kind == "sync":
+            if wb[i]:
+                out_lines.append(ind + _lr_wb(wb[i]))
+            out_lines.append(line)
+            if lout[i]:
+                out_lines.append(ind + _lr_reload(lout[i]))
+        elif kind == "exit":
+            if wb[i]:
+                out_lines.append(ind + _lr_wb(wb[i]))
+            out_lines.append(line)
+        elif kind == "cond_exit":
+            t, comment = _lr_strip_comments(line)
+            cond, rest = _lr_split_if(t)
+            inner = rest[1:-1].strip() if rest.startswith("{") else rest
+            w = _lr_wb(wb[i])
+            out_lines.append(f"{ind}if ({_lr_rewrite(cond)}) {{ {w + ' ' if w else ''}{inner} }}{comment}")
+        else:  # switch
+            t, comment = _lr_strip_comments(line)
+            m = _LR_SWITCH_RE.fullmatch(t)
+            w = _lr_wb(wb[i])
+            cases = m.group("cases")
+            if w:
+                cases = cases.replace("{ g_trampoline_fn = ", "{ " + w + " g_trampoline_fn = ")
+            new = (t[:m.start("expr")] + _lr_rewrite(m.group("expr")) + t[m.end("expr"):m.start("cases")]
+                   + cases + t[m.end("cases"):m.start("dflt")] + (w + " " if w else "") + t[m.start("dflt"):])
+            out_lines.append(ind + new + comment)
+    if seen[END] and wb[END]:
+        out_lines.append("    " + _lr_wb(wb[END]))
+    return out_lines
+
