+#if !(defined(__AVX512F__) && defined(__AVX512VL__))
+SPU__AV_INLINE u128 spu_fa(u128 a, u128 b) { return spu__av_fa(a, b, 0); }
+SPU__AV_INLINE u128 spu_fs(u128 a, u128 b) { return spu__av_fa(a, b, 0x80000000u); }
