+        /* magnitude * 2^32: (2^13 + base) * 2^19 - step * y */
+        uint64_t m = ((((uint64_t)1 << 13) | base) << 19) - step * y;
+        if (m < ((uint64_t)1 << 32)) {                        /* below 1.0: normalise */
