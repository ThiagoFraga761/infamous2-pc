+/* spu_cold.c -- the far side of spu_cold_call (spu_context.h, SPU_COLD_THUNK).
+ *
+ * Lifted SPU code reaches its rare paths -- the float fix-ups for an
+ * exponent-255 or denormal lane, the local-store debug probes -- through a call
+ * made from inline assembly, so the compiler keeps the function's vector values
+ * in registers across it. spu_cold_thunk is that call's target: it saves every
+ * register a C function may change (zmm0-31, k0-7, the caller-saved GPRs),
+ * runs spu_cold_dispatch on the argument block in rdi and restores them.
+ *
+ * Build this with the lifted sources and the same -march: the fix-ups it calls
+ * are the header's, for that instruction set. */
+#include "spu_helpers.h"
+#include <stdio.h>
+#include <stdlib.h>
+
+#ifdef SPU_COLD_THUNK
+__asm__(
+    ".text\n"
+    ".globl spu_cold_thunk_full\n"
+    ".type spu_cold_thunk_full,@function\n"
+    "spu_cold_thunk_full:\n"
+    "    push %rbp\n"
+    "    mov  %rsp, %rbp\n"
+    "    push %rax\n    push %rcx\n    push %rdx\n    push %rsi\n    push %rdi\n"
+    "    push %r8\n     push %r9\n     push %r10\n    push %r11\n"
+    "    and  $-64, %rsp\n"
+    "    sub  $2112, %rsp\n"                       /* 32 x 64 (zmm) + 8 x 8 (k) */
+    "    vmovdqu64 %zmm0,     0(%rsp)\n    vmovdqu64 %zmm1,    64(%rsp)\n"
+    "    vmovdqu64 %zmm2,   128(%rsp)\n    vmovdqu64 %zmm3,   192(%rsp)\n"
+    "    vmovdqu64 %zmm4,   256(%rsp)\n    vmovdqu64 %zmm5,   320(%rsp)\n"
+    "    vmovdqu64 %zmm6,   384(%rsp)\n    vmovdqu64 %zmm7,   448(%rsp)\n"
+    "    vmovdqu64 %zmm8,   512(%rsp)\n    vmovdqu64 %zmm9,   576(%rsp)\n"
+    "    vmovdqu64 %zmm10,  640(%rsp)\n    vmovdqu64 %zmm11,  704(%rsp)\n"
+    "    vmovdqu64 %zmm12,  768(%rsp)\n    vmovdqu64 %zmm13,  832(%rsp)\n"
+    "    vmovdqu64 %zmm14,  896(%rsp)\n    vmovdqu64 %zmm15,  960(%rsp)\n"
+    "    vmovdqu64 %zmm16, 1024(%rsp)\n    vmovdqu64 %zmm17, 1088(%rsp)\n"
+    "    vmovdqu64 %zmm18, 1152(%rsp)\n    vmovdqu64 %zmm19, 1216(%rsp)\n"
+    "    vmovdqu64 %zmm20, 1280(%rsp)\n    vmovdqu64 %zmm21, 1344(%rsp)\n"
+    "    vmovdqu64 %zmm22, 1408(%rsp)\n    vmovdqu64 %zmm23, 1472(%rsp)\n"
+    "    vmovdqu64 %zmm24, 1536(%rsp)\n    vmovdqu64 %zmm25, 1600(%rsp)\n"
+    "    vmovdqu64 %zmm26, 1664(%rsp)\n    vmovdqu64 %zmm27, 1728(%rsp)\n"
+    "    vmovdqu64 %zmm28, 1792(%rsp)\n    vmovdqu64 %zmm29, 1856(%rsp)\n"
+    "    vmovdqu64 %zmm30, 1920(%rsp)\n    vmovdqu64 %zmm31, 1984(%rsp)\n"
+    "    kmovq %k0, 2048(%rsp)\n    kmovq %k1, 2056(%rsp)\n"
+    "    kmovq %k2, 2064(%rsp)\n    kmovq %k3, 2072(%rsp)\n"
+    "    kmovq %k4, 2080(%rsp)\n    kmovq %k5, 2088(%rsp)\n"
+    "    kmovq %k6, 2096(%rsp)\n    kmovq %k7, 2104(%rsp)\n"
+    "    call spu_cold_dispatch\n"
