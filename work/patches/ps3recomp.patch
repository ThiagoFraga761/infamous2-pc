+SPU__AV_INLINE u128 spu_fma(u128 a, u128 b, u128 c)  { return spu__av_fma(a, b, c, 0, 0); }            /* a*b + c */
+SPU__AV_INLINE u128 spu_fms(u128 a, u128 b, u128 c)  { return spu__av_fma(a, b, c, 0, 0x80000000u); }  /* a*b - c */
+SPU__AV_INLINE u128 spu_fnms(u128 a, u128 b, u128 c) { return spu__av_fma(a, b, c, 0x80000000u, 0); }  /* c - a*b */
+#endif
