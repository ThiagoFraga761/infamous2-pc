+SPU__AV_INLINE u128 spu__z_fma(u128 a, u128 b, u128 c, uint32_t negp, uint32_t negc) {
+    const __m128i xa = spu__av_ld(a), y = spu__av_ld(b), zc = spu__av_ld(c);
+    const __m128i x = _mm_xor_si128(xa, _mm_set1_epi32((int)negp));
+    const __m128i z = _mm_xor_si128(zc, _mm_set1_epi32((int)negc));
+    __mmask8 bad = SPU__Z_ODD(x) | SPU__Z_ODD(y) | SPU__Z_ODD(z);
+    __m128i r = spu__z_res(_mm512_fmadd_round_ps(spu__z_ps(x), spu__z_ps(y), spu__z_ps(z), SPU__Z_RZ), &bad);
