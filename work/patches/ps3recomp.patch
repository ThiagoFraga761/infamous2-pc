+/*
+ * ps3recomp - the draw engine's backend calls, recorded on a thread of their own
+ * (PS3RECOMP_BE_THREAD=1; see rsx_be_thread.c).
+ */
+#ifndef PS3RECOMP_RSX_BE_THREAD_H
+#define PS3RECOMP_RSX_BE_THREAD_H
+
+#include "rsx_draw_engine.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* The backend the engine should call: `be` itself, or a wrapper that queues
+ * its calls for a worker thread when PS3RECOMP_BE_THREAD=1. */
