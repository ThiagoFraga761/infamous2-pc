+    const __m128i zero = _mm_cmpeq_epi32(_mm_and_si128(x, _mm_set1_epi32(0x7F800000)), _mm_setzero_si128());
+    return _mm_andnot_si128(zero, _mm_and_si128(x, _mm_set1_epi32(0x7FFFFFFF)));
