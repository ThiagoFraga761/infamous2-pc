+                        ((u64)a.tv_sec * 1000000000ull + (u64)a.tv_nsec);
+        s_fr_flushes++;
+        if (st) {
+            const u64 now = (u64)b.tv_sec * 1000000000ull + (u64)b.tv_nsec;
+            ns += now - ((u64)a.tv_sec * 1000000000ull + (u64)a.tv_nsec);
+            n++;
+            if (!t0) t0 = now;
+            if (now - t0 >= 5000000000ull) {
+                fprintf(stderr, "[vk-stats] %.1f flushes/s, %.1f ms/s waiting on the GPU (%.2f ms each);"
