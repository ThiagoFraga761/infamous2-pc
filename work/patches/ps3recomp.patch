-    spu_lifted_entry_fn fn;
-    int                 image_id;
-    int                 resolved;   /* 0=not tried, 1=found, -1=missing */
-} WklPm;
-static WklPm s_wkl_pm[CELL_SPURS_MAX_WORKLOAD];
-
