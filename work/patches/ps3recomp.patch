+/* p + z, truncated; *ok marks the lanes where that is exact (see above). */
+SPU__AV_INLINE __m128i spu__x_sum(__m256d p, __m256d z, __m128i* ok) {
+    const __m256d s = _mm256_add_pd(p, z), bb = _mm256_sub_pd(s, p);
+    const __m256d e = _mm256_add_pd(_mm256_sub_pd(p, _mm256_sub_pd(s, bb)), _mm256_sub_pd(z, bb));
+    const __m256i on = _mm256_cmpeq_epi64(_mm256_and_si256(_mm256_castpd_si256(s), _mm256_set1_epi64x(0x1FFFFFFF)),
+                                          _mm256_setzero_si256());
+    const __m256i exact = _mm256_castpd_si256(_mm256_cmp_pd(e, _mm256_setzero_pd(), _CMP_EQ_OQ));
+    *ok = spu__av_narrow(_mm256_or_si256(_mm256_andnot_si256(on, _mm256_set1_epi64x(-1)), exact));
+    return spu__x_pack(s);
+}
+SPU__AV_SLOW __m128i spu__av_fa_fix(__m128i r, __m128i ok, __m128i a, __m128i b, uint32_t negb) {
+    __m128i xok;
+    const __m128i xr = spu__x_sum(spu__x_d(a), spu__x_d(_mm_xor_si128(b, _mm_set1_epi32((int)negb))), &xok);
+    r = _mm_blendv_epi8(r, xr, _mm_andnot_si128(ok, xok));
+    ok = _mm_or_si128(ok, xok);
+    if (spu__av_all4(ok)) return r;
+    uint32_t o[4], m[4], x[4], y[4];
+    memcpy(o, &r, 16); memcpy(m, &ok, 16); memcpy(x, &a, 16); memcpy(y, &b, 16);
+    for (int i = 0; i < 4; i++) if (!m[i]) o[i] = spu__fa_any(x[i], y[i] ^ negb);
+    memcpy(&r, o, 16); return r;
+}
+SPU__AV_SLOW __m128i spu__av_fm_fix(__m128i r, __m128i ok, __m128i a, __m128i b) {
+    /* a product of two singles is exact in double: every lane settles */
+    return _mm_blendv_epi8(spu__x_pack(_mm256_mul_pd(spu__x_d(a), spu__x_d(b))), r, ok);
+}
+SPU__AV_SLOW __m128i spu__av_fma_fix(__m128i r, __m128i ok, __m128i a, __m128i b, __m128i c,
+                                     uint32_t negp, uint32_t negc) {
+    __m128i xok;
+    const __m128i xr = spu__x_sum(_mm256_mul_pd(spu__x_d(_mm_xor_si128(a, _mm_set1_epi32((int)negp))), spu__x_d(b)),
+                                  spu__x_d(_mm_xor_si128(c, _mm_set1_epi32((int)negc))), &xok);
+    r = _mm_blendv_epi8(r, xr, _mm_andnot_si128(ok, xok));
+    ok = _mm_or_si128(ok, xok);
+    if (spu__av_all4(ok)) return r;
+    uint32_t o[4], m[4], x[4], y[4], z[4];
+    memcpy(o, &r, 16); memcpy(m, &ok, 16); memcpy(x, &a, 16); memcpy(y, &b, 16); memcpy(z, &c, 16);
+    for (int i = 0; i < 4; i++) if (!m[i]) o[i] = spu__fma_any(x[i], y[i], z[i], negp, negc);
+    memcpy(&r, o, 16); return r;
