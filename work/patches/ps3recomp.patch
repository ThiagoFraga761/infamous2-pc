+        ci.initialDataSize = 0; ci.pInitialData = NULL;    /* data the driver refuses: start empty */
+        if (pvkCreatePipelineCache(s_vk.device, &ci, NULL, &s_pcache) != VK_SUCCESS) s_pcache = VK_NULL_HANDLE;
+    }
