+static void vk_pcache_init(void)
+{
+    const char* e = getenv("PS3RECOMP_VK_PIPECACHE");
+    if (e && e[0] == '0') return;
+    const char* dir = vk_spv_cache_dir();
+    void* data = NULL; size_t n = 0;
+    if (dir) {
+        VkPhysicalDeviceProperties pp;
+        pvkGetPhysicalDeviceProperties(s_vk.phys, &pp);
+        char uuid[2 * VK_UUID_SIZE + 1];
+        for (u32 i = 0; i < VK_UUID_SIZE; i++) snprintf(uuid + 2 * i, 3, "%02x", pp.pipelineCacheUUID[i]);
+        snprintf(s_pcache_path, sizeof s_pcache_path, "%s/../vkpipe-%04x-%04x-%s.bin", dir,
