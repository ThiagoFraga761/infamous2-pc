+    static const char* dir = (const char*)-1;
+    if (dir == (const char*)-1) dir = getenv("SPU_DUMP_STUCK");
+    static _Atomic int n = 0;
+    if (!dir || !*dir) return;
+    const int k = __atomic_fetch_add(&n, 1, __ATOMIC_RELAXED);
+    if (k >= 8) return;
+    char path[512];
+    snprintf(path, sizeof path, "%s/stuck_%d_%d.bin", dir, image_id, k);
+    FILE* f = fopen(path, "wb");
+    if (!f) return;
+    spurs_job_dump_hdr h = { SPURS_JOB_DUMP_MAGIC, (uint32_t)image_id, st->job_ea, st->stack_top,
+                             st->ctx_ls, st->desc_ls, st->size_bin, 0,
+                             spu_workload_fingerprint(st->ls, st->size_bin) };
+    fwrite(&h, sizeof h, 1, f);
+    fwrite(st->ls, 1, SPU_LS_SIZE, f);
+    fclose(f);
+    fprintf(stderr, "[spurs-job] stuck job's staged store -> %s\n", path);
+}
+
+/* Run a job dumped by SPU_DUMP_STUCK twice from the same store: once with its
+ * lifted entry, once with `interp_entry`. Each run is reported (end pc, steps,
+ * whether it got stuck). Both finishing or both stuck means the input; only
+ * the lift stuck means the lift. Returns 0 once both ran. */
+int spu_replay_stuck_job(const char* path, spu_lifted_entry_fn interp_entry)
+{
+    FILE* f = fopen(path, "rb");
+    if (!f) { fprintf(stderr, "[replay] cannot open %s\n", path); return -1; }
+    spurs_job_dump_hdr h;
+    uint8_t* ls = (uint8_t*)malloc(SPU_LS_SIZE);
+    const int ok = ls && fread(&h, sizeof h, 1, f) == 1 && h.magic == SPURS_JOB_DUMP_MAGIC &&
+                   fread(ls, 1, SPU_LS_SIZE, f) == SPU_LS_SIZE;
+    fclose(f);
+    if (!ok) { fprintf(stderr, "[replay] %s is not a stuck-job dump\n", path); free(ls); return -1; }
+    int image_id = -1;
+    spu_lifted_entry_fn lifted = spu_workload_find_img(h.fp, &image_id);
+    fprintf(stderr, "[replay] image %u (registry: %d) job 0x%08X binary %u B fp 0x%016llX\n",
+            h.image_id, image_id, h.job_ea, h.size_bin, (unsigned long long)h.fp);
+    const spurs_job_stage st = { ls, h.job_ea, h.stack_top, h.ctx_ls, h.desc_ls, 0, 0, 0, h.size_bin };
+    if (lifted) {
+        const int rc = spurs_job_enter(&st, lifted, image_id);
+        fprintf(stderr, "[replay] lifted: rc=%d %s\n", rc, g_spurs_job_overrun ? "STUCK (past the step budget)" : "finished");
+    } else {
+        fprintf(stderr, "[replay] no lifted entry for this binary\n");
+    }
+    const int rc = spurs_job_enter(&st, interp_entry, -1);
+    fprintf(stderr, "[replay] interpreter: rc=%d\n", rc);
     free(ls);
     return 0;
 }
