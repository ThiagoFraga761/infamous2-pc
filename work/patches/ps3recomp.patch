+# ---------------------------------------------------------------------------
+# Register localization (--local-regs)
+# ---------------------------------------------------------------------------
+# Every lifted statement reads and writes the guest registers in ctx->gpr[], and
+# the lifted TUs build with -fno-strict-aliasing: each local-store write (a store
+# through a may_alias __m128i pointer) forces the compiler to reload every
+# register it is holding, and each value then reaches its next use through
+# memory, a store-to-load forwarding round trip on the critical path. With
+# --local-regs, a function's registers live in locals between the points where
+# something else can look at ctx: a register is written back before and reloaded
+# after any statement that passes ctx to anything but the local-store
+# accessors, and written back before every exit. The statements that do
+# cross that line run unchanged against ctx->gpr, so they need no knowledge of
+# what each callee reads or writes.
+_GPR_RE = re.compile(r"ctx->gpr\[(\d+)\]")
+_GPR_WRITE_RE = re.compile(
+    r"ctx->gpr\[(\d+)\](?:\._\w+\[\d+\])?\s*(?:[-+*/|&^%]|<<|>>)?=(?!=)|&ctx->gpr\[(\d+)\]")
+# The MFC parameter channel writes only latch ctx->mfc_* (spu_wrch_fast): no
+# register traffic around them.
+_SAFE_CTX_RE = re.compile(r"spu_ls_(?:read|write)128\(ctx,|spu_loop_tick\(ctx|"
+                          r"spu_wrch\(ctx, MFC_(?:LSA|EAH|EAL|Size|TagID),|spu_int_set\(ctx,|"
+                          r"spu_irq_pending\(ctx\)")
+_LABEL_RE = re.compile(r"loc_[0-9A-Fa-f]+:")
+_GOTO_RE = re.compile(r"\bgoto (loc_[0-9A-Fa-f]+);")
+_LOOP_TICK = "    if (__builtin_expect(spu_loop_tick(ctx), 0)) { spu_job_overrun(ctx); return; }"
+
