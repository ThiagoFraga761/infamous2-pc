+        u32 best = ENG_INVALID, stamp = 0;
+        for (u32 i = 0; i < g.n_surfaces; i++) {
+            const eng_surface* s = &g.surfaces[i];
+            if (!s->handle || s->location != location || s->offset != offset) continue;
+            if (best == ENG_INVALID || s->stamp > stamp) { best = i; stamp = s->stamp; }
+        }
+        const eng_surface* s = best != ENG_INVALID ? &g.surfaces[best] : NULL;
+        if (s && s->fmt == RSX_BE_FMT_R8G8B8A8 && s->guest_raster != 2u &&
+            (s->guest_fmt == ENG_SURF_A8R8G8B8 || s->guest_fmt == ENG_SURF_X8R8G8B8_Z8R8G8B8 ||
+             s->guest_fmt == ENG_SURF_X8R8G8B8_O8R8G8B8)) {
+            s_gb.n_slot = best; s_gb.n_offset = offset; s_gb.normals = src = s->handle;
+            s_gb.w[0] = s->w; s_gb.h[0] = s->h;
