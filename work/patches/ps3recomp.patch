+/* PS3RECOMP_VK_FLUSH_CALLERS=1: with PS3RECOMP_VK_STATS, which call sites
+ * flush (offsets into the binary, for addr2line). */
+static struct { uintptr_t at; u32 n; } s_flush_from[32];
+static void vk_flush_note(uintptr_t at)
+{
+    for (u32 i = 0; i < 32; i++) {
