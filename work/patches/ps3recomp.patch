+static void hle_sys_spu_printf_attach_thread(ppu_context* ctx) { lv2_spu_printf_call(ctx, 2); }
+static void hle_sys_spu_printf_detach_thread(ppu_context* ctx) { lv2_spu_printf_call(ctx, 3); }
