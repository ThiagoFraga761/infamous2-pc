+/* Its data only: the entry stays, to remember a skip. */
+static void eng_geo_drop_data(eng_geo* e)
+{
+    if (e->verts)
+        s_geo_bytes -= (u64)e->n_verts * e->stride + (u64)(e->indexed ? e->n_draw : 0) * 4u;
+    if (e->res) { g.be->geo_drop(g.be->user, e->res); e->res = 0; s_geo_res--; }
+    free(e->verts); free(e->indices);
+    e->verts = NULL; e->indices = NULL;
+    e->n_verts = e->n_draw = 0; e->n_ranges = 0;
+}
+
+static void eng_geo_free(eng_geo* e)
+{
+    eng_geo_drop_data(e);
+    memset(e, 0, sizeof *e);
+}
+
+/* The slot for a new key: its own, an empty one, or the least recently used
+ * along the probe. */
+static eng_geo* eng_geo_slot(u64 key)
+{
+    const u32 home = (u32)(key >> 20) & (GEO_SLOTS - 1u);
+    eng_geo* lru = NULL;
+    for (u32 k = 0; k < GEO_PROBE; k++) {
+        eng_geo* e = &s_geo[(home + k) & (GEO_SLOTS - 1u)];
+        if (e->key == key || !e->key) return e;
+        if (!lru || e->last_frame < lru->last_frame) lru = e;
+    }
+    return lru;
+}
+
+/* A draw whose sources cannot be tracked: remember not to try for a while. */
+static void eng_geo_store_skip(eng_geo* old, u64 key)
+{
+    eng_geo* e = old ? old : eng_geo_slot(key);
+    if (e->key && e->key != key) eng_geo_free(e);
+    else eng_geo_drop_data(e);
+    e->key = key; e->last_frame = g.frames; e->skip_until = g.frames + 64u; e->dirty_streak = 0;
+}
+
+/* After a miss built the draw the long way: keep it, armed. */
+static void eng_geo_store(eng_geo* old, u64 key, const rsx_vertex_layout_plan* layout,
+                          int indexed, u32 n_draw)
+{
+    if (old && old->skip_until > g.frames) { s_geo_nostore[0]++; return; }
+    if (!s_geo_arm.ok) { s_geo_nostore[1]++; eng_geo_store_skip(old, key); return; }
+    eng_geo tmp;
+    memset(&tmp, 0, sizeof tmp);
+    tmp.n_ranges = s_geo_arm.n;
+    memcpy(tmp.rp, s_geo_arm.rp, sizeof tmp.rp);
+    memcpy(tmp.rl, s_geo_arm.rl, sizeof tmp.rl);
+    memcpy(tmp.rs, s_geo_arm.rs, sizeof tmp.rs);
+    const u64 vbytes = (u64)dc.n_verts * layout->stride, ibytes = indexed ? (u64)n_draw * 4u : 0;
+    if (!tmp.n_ranges || !vbytes) { s_geo_nostore[3]++; return; }
+    const u32 streak = old ? old->dirty_streak : 0;
+    if (old) eng_geo_free(old);
+    if (s_geo_bytes + vbytes + ibytes > GEO_MAX_BYTES) {
+        /* Full: drop what no draw has used for a second or so -- geometry the
+         * title builds afresh at a new address every frame piles up here --
+         * at most once a frame. */
+        static u32 swept = ~0u;
+        if (swept != g.frames) {
+            swept = g.frames;
+            for (u32 i = 0; i < GEO_SLOTS; i++)
+                if (s_geo[i].key && s_geo[i].last_frame + 60u < g.frames && &s_geo[i] != old)
+                    eng_geo_free(&s_geo[i]);
+        }
+        if (s_geo_bytes + vbytes + ibytes > GEO_MAX_BYTES) { s_geo_nostore[4]++; return; }
+    }
+    tmp.verts = (u8*)malloc(vbytes);
+    tmp.indices = ibytes ? (u32*)malloc(ibytes) : NULL;
+    if (!tmp.verts || (ibytes && !tmp.indices)) { free(tmp.verts); free(tmp.indices); return; }
+    memcpy(tmp.verts, dc.verts, vbytes);
+    if (ibytes) memcpy(tmp.indices, g.indices, ibytes);
+    tmp.key = key; tmp.last_frame = g.frames;
+    tmp.n_verts = dc.n_verts; tmp.stride = layout->stride; tmp.n_draw = n_draw;
+    tmp.n_source_refs = dc.n_source_refs; tmp.indexed = indexed;
+    tmp.dirty_streak = streak;
+    eng_geo* slot = old ? old : eng_geo_slot(key);
+    if (slot->key) eng_geo_free(slot);
+    if (eng_geo_res_on()) {
+        tmp.res = g.be->geo_put(g.be->user, tmp.verts, (u32)vbytes, tmp.indices,
+                                ibytes ? n_draw : 0);
+        if (tmp.res) s_geo_res++; else s_geo_res_full++;
+    }
+    *slot = tmp;
+    s_geo_bytes += vbytes + ibytes;
+}
+
+/* ---- sink ---------------------------------------------------------------- */
+
+/* PS3RECOMP_ENG_VPLOG=1: print each distinct (viewport y scale sign, y
+ * offset, SHADER_WINDOW 0x1D88, color offset 0x0210, surface clip 0x0200)
+ * combination the first time a draw uses it -- which way each pass maps
+ * NDC +y to rows. */
+static void eng_vplog(const rsx_dispatch* r)
+{
+    static int on = -1;
+    if (on < 0) on = getenv("PS3RECOMP_ENG_VPLOG") ? 1 : 0;
+    if (!on) return;
+    rsx_dsp_viewport vp; rsx_dsp_get_viewport(r, &vp);
+    const u32 win = rsx_dsp_reg(r, 0x1D88), coff = rsx_dsp_reg(r, 0x0210), clip = rsx_dsp_reg(r, 0x0200);
+    static u32 seen[64][4]; static int n;
+    const u32 key[4] = { vp.scale[1] < 0.0f, win, coff, (u32)vp.translate[1] };
+    for (int i = 0; i < n; i++) if (!memcmp(seen[i], key, sizeof key)) return;
+    if (n >= 64) return;
+    memcpy(seen[n++], key, sizeof key);
+    fprintf(stderr, "[eng-vp] scale=(%.1f,%.1f) trans=(%.1f,%.1f) vp=%ux%u@%u,%u win=0x%08X color_off=0x%08X clip=0x%08X\n",
+            vp.scale[0], vp.scale[1], vp.translate[0], vp.translate[1], vp.w, vp.h, vp.x, vp.y, win, coff, clip);
+}
+
+static void sink_begin(void* user, const rsx_dispatch* r, u32 prim)
+{
+    (void)user; (void)prim;
+    eng_vplog(r);
+    dc_reset();
+}
+
+/* PS3RECOMP_ENG_DRAWTRACE=<world frame>|f<frame>[,<dir>[,<first>,<last>|t<hex>]]: during
+ * that world frame -- or, with f, the engine's own frame count, which is the
+ * PS3RECOMP_VK_DUMP numbering -- 
+ * (world frames are counted like PS3RECOMP_ENG_DUMP_SURFACES: >1000 guest draws),
+ * read every colour target back after each draw and log its mean colour and
+ * the share of saturated-yellow pixels -- the first draw that turns a target
+ * yellow names the pass. With <dir>, each readback is also kept as
+ * <dir>/d<draw>_p<pipeline>_t<i>_<offset>.ppm -- for draws first..last when
+ * given, for every draw into colour target A at <hex> with t<hex>, else for
+ * full-screen passes only (12 vertices or fewer). With ,fs instead, only
+ * full-screen passes are read back at all -- the per-draw readbacks of a
+ * whole frame can take minutes. */
+static u32 s_world_frames;
+static u32 s_dt_zslot = 0xFFFFFFFFu;   /* the traced draw's zeta slot */
+/* The presented-frame count, for runtime diagnostics outside the engine
+ * (SPU_PARAM_DUMP): the PS3RECOMP_VK_DUMP numbering. */
+volatile uint32_t g_rsx_engine_frame;
+/* LIGHTBUF_TRACE=<frame>,<lo>-<hi> (see cellGcmSys.c nv3089_blit): every draw
+ * that samples a main-memory texture overlapping [lo, hi), with the time and
+ * how much of the texture is nonzero as it is read. */
+static void eng_lightbuf_trace(u32 pipeline, u32 tex_mask)
+{
+    static int on = -1; static u32 fr, lo, hi;
+    if (on < 0) { const char* e = getenv("LIGHTBUF_TRACE"); on = 0;
+        if (e) { char* d; fr = (u32)strtoul(e, &d, 10);
+                 if (*d == ',') { lo = (u32)strtoul(d + 1, &d, 16); if (*d == '-') hi = (u32)strtoul(d + 1, 0, 16); }
+                 on = hi > lo; } }
+    if (!on || g.frames < fr || g.frames > fr + 2) return;
+    for (u32 u = 0; u < RSX_BE_MAX_TEXTURES; u++) {
+        if (!(tex_mask & (1u << u))) continue;
+        rsx_dsp_texture tt;
+        tt = *eng_tex(u);
+        if (!tt.height) continue;
+        const u32 pitch = tt.pitch ? tt.pitch : tt.width;   /* a swizzled B8 has none */
+        const u32 bytes = pitch * tt.height;
+        const u8* q = eng_guest_ptr(NULL, tt.location, tt.offset, bytes);
+        extern uint8_t* vm_base;
+        if (!q || !vm_base) continue;
+        const u32 ea = (u32)(q - vm_base);
+        if (ea >= hi || ea + bytes <= lo) continue;
+        u64 nz = 0, sum = 0;
+        for (u32 i = 0; i < bytes; i++) { nz += q[i] != 0; sum += q[i]; }
+        struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
+        fprintf(stderr, "[lbt] t=%llu f%u draw p%u unit %u fmt 0x%02X reads 0x%08X..0x%08X nonzero bytes %llu/%u mean %.1f\n",
+                (unsigned long long)ts.tv_sec * 1000000000ull + (unsigned long long)ts.tv_nsec,
+                g.frames, pipeline, u, tt.format, ea, ea + bytes, (unsigned long long)nz, bytes,
+                (double)sum / bytes);
+    }
+}
+
+static void eng_drawtrace(u32 pipeline, const u32* targets, u32 n_targets, u32 n,
+                          u32 tex_mask, const u32* textures)
+{
+    eng_lightbuf_trace(pipeline, tex_mask);
+    static const char* e = (const char*)-1; static u32 want; static char dir[400];
+    static u32 ndraw, dfirst = 0, dlast = 0xFFFFFFFFu, ranged, by_frame, tfilt;
+    static int tfilt_on, fs_only;
+    if (e == (const char*)-1) { e = getenv("PS3RECOMP_ENG_DRAWTRACE");
+        if (e) { char* c; by_frame = (*e == 'f'); want = (u32)strtoul(e + by_frame, &c, 10);
+                 if (*c == ',') { snprintf(dir, sizeof dir, "%s", c + 1);
+                     char* r = strchr(dir, ',');
+                     if (r && r[1] == 'f' && r[2] == 's') { *r = 0; fs_only = 1; }
+                     else if (r && r[1] == 't') { *r = 0; tfilt_on = 1; tfilt = (u32)strtoul(r + 2, NULL, 16); }
+                     else if (r) { *r = 0; ranged = 1; dfirst = (u32)strtoul(r + 1, &c, 10);
+                              dlast = (*c == ',') ? (u32)strtoul(c + 1, NULL, 10) : dfirst; } } } }
+    /* PS3RECOMP_ENG_DRAWTRACE_AT=<file>: trace the world frame after the one
+     * in which <file> appears (a script picks the moment), then delete it.
+     * With it the DRAWTRACE frame number is ignored. */
+    { static const char* at = (const char*)-1; static u32 seen_frame = ~0u;
+      if (at == (const char*)-1) at = getenv("PS3RECOMP_ENG_DRAWTRACE_AT");
+      if (at && e && seen_frame != s_world_frames) {
+          seen_frame = s_world_frames;
+          FILE* tf = fopen(at, "rb");
+          if (tf) { fclose(tf); remove(at); by_frame = 0; want = s_world_frames + 1; ndraw = 0;
+                    fprintf(stderr, "[rsx drawtrace] triggered: world frame %u\n", want); }
+          else if (s_world_frames != want) want = ~0u - 1u;
+      } }
+    if (!e || (by_frame ? g.frames : s_world_frames) != want || !g.be->readback) return;
+    const u32 d = ndraw++;
+    if (fs_only && n > 12) return;
+    const int keep = dir[0] && (ranged ? (d >= dfirst && d <= dlast)
+                                : tfilt_on ? (n_targets && g.surfaces[targets[0]].offset == tfilt)
+                                           : n <= 12);
+    /* TEX_COORD_CONTROL (0x0B40 + 4i): bit 0 makes texcoord i 2D, its z and
+     * w read 0 and the fragment's w. Not modelled; log where it is set. */
+    for (u32 i = 0; i < 10; i++) {
+        const u32 v = g.rsx.regs[(0x0B40u >> 2) + i];
+        if (v) fprintf(stderr, "[rsx drawtrace] d%u   texcoord %u control 0x%X\n", d, i, v);
+    }
+    for (u32 u = 0; u < RSX_BE_MAX_TEXTURES; u++) {
+        if (!(tex_mask & (1u << u))) continue;
+        rsx_dsp_texture tt;
+        tt = *eng_tex(u);
+        const char* kind = "";
+        for (u32 i = 0; i < g.n_surfaces; i++)
+            if (g.surfaces[i].handle && g.surfaces[i].location == tt.location &&
+                g.surfaces[i].offset == tt.offset) {
+                kind = " [colour target]";
+                fprintf(stderr, "[rsx drawtrace] d%u   unit %u surface slot %u h%u %ux%u fmt %d stamp %u%s\n",
+                        d, u, i, g.surfaces[i].handle, g.surfaces[i].w, g.surfaces[i].h,
+                        (int)g.surfaces[i].fmt, g.surfaces[i].stamp,
+                        (n_targets && targets[0] == i) ? " [bound]" : "");
+            }
+        for (u32 i = 0; i < g.n_zdepths; i++)
+            if (g.zdepths[i].handle && g.zdepths[i].location == tt.location &&
+                g.zdepths[i].offset == tt.offset) {
+                kind = " [depth target]";
+                /* With a dump directory: the zeta this unit samples, as a
+                 * contrast-stretched PGM (1.0, the clear, stays white). */
+                const eng_zdepth* z = &g.zdepths[i];
+                u32 zw, zh;
+                eng_zdepth_extent(z, &zw, &zh);
+                float* zf = (keep && g.be->depth_readback) ? (float*)malloc((size_t)zw * zh * 4) : NULL;
+                if (zf && !g.be->depth_readback(g.be->user, z->handle, zw, zh, zf)) {
+                    float lo = 1.0f, hi = 0.0f;
+                    for (u32 k = 0; k < zw * zh; k++)
+                        if (zf[k] < 1.0f) { if (zf[k] < lo) lo = zf[k]; if (zf[k] > hi) hi = zf[k]; }
+                    char path[512];
+                    snprintf(path, sizeof path, "%s/d%04u_unit%u_zeta_%08X.pgm", dir, d, u, tt.offset);
+                    FILE* f = fopen(path, "wb");
+                    if (f) {
+                        fprintf(f, "P5\n%u %u\n255\n", zw, zh);
+                        for (u32 k = 0; k < zw * zh; k++) {
+                            const float v = zf[k] >= 1.0f ? 1.0f : (hi > lo ? (zf[k] - lo) / (hi - lo) * 0.9f : 0.0f);
+                            fputc((int)(v * 255.0f), f);
+                        }
+                        fclose(f);
+                    }
+                    fprintf(stderr, "[rsx drawtrace] d%u   unit %u zeta 0x%08X %ux%u depth range %.6f..%.6f\n",
+                            d, u, tt.offset, zw, zh, lo, hi);
+                }
+                free(zf);
+            }
+        fprintf(stderr, "[rsx drawtrace] d%u   unit %u %s 0x%08X fmt 0x%02X %ux%u remap 0x%04X filter 0x%08X wrap 0x%08X%s h%u\n",
+                d, u, tt.location == RSX_LOCATION_LOCAL ? "local" : "main", tt.offset,
+                tt.format, tt.width, tt.height, tt.remap, tt.filter, tt.wrap, kind, textures[u]);
+        /* With a dump directory: a small cube texture's raw guest bytes. */
+        if (keep && tt.cubemap) {
+            const u32 span = eng_texture_span(tt.format, tt.width, tt.height, tt.mipmaps,
+                                              tt.pitch, 1);
+            const u8* src = (span && span <= (1u << 20))
+                          ? eng_guest_ptr(NULL, tt.location, tt.offset, span) : NULL;
+            char path[512];
+            snprintf(path, sizeof path, "%s/d%04u_unit%u_cube_%08X_fmt%02X_%u.bin", dir, d, u,
+                     tt.offset, tt.format, tt.width);
+            FILE* f = src ? fopen(path, "wb") : NULL;
+            if (f) { fwrite(src, 1, span, f); fclose(f); }
+        }
+        /* With a dump directory: a linear A8R8G8B8 texture out of MAIN memory
+         * (what an SPU computed for the GPU) as the guest bytes stand. */
+        if (keep && tt.location == RSX_LOCATION_MAIN && (tt.format & 0x20u) &&
+            (tt.format & 0x9Fu) == 0x85u && tt.width >= 64 && tt.height >= 64 &&
+            tt.pitch >= tt.width * 4u && (u64)tt.pitch * tt.height <= 0x10000000ull) {
+            const u32 pitch = tt.pitch;
+            const u8* src = eng_guest_ptr(NULL, tt.location, tt.offset, pitch * tt.height);
+            char path[512];
+            snprintf(path, sizeof path, "%s/d%04u_unit%u_main_%08X.ppm", dir, d, u, tt.offset);
+            if (src) {
+                u64 nz[4] = { 0, 0, 0, 0 }, sum[4] = { 0, 0, 0, 0 };
+                for (u32 y = 0; y < tt.height; y++)
+                    for (u32 x = 0; x < tt.width; x++)
+                        for (u32 k = 0; k < 4; k++) {
+                            const u8 v = src[y * pitch + x * 4u + k];
+                            nz[k] += v != 0; sum[k] += v;
+                        }
+                fprintf(stderr, "[rsx drawtrace] d%u   unit %u main bytes A,R,G,B nonzero %llu %llu %llu %llu mean %.2f %.2f %.2f %.2f pitch %u\n",
+                        d, u, (unsigned long long)nz[0], (unsigned long long)nz[1],
+                        (unsigned long long)nz[2], (unsigned long long)nz[3],
+                        (double)sum[0] / (tt.width * tt.height), (double)sum[1] / (tt.width * tt.height),
+                        (double)sum[2] / (tt.width * tt.height), (double)sum[3] / (tt.width * tt.height), pitch);
+            }
+            FILE* f = src ? fopen(path, "wb") : NULL;
+            if (f) { fprintf(f, "P6\n%u %u\n255\n", tt.width, tt.height);
+                     for (u32 y = 0; y < tt.height; y++)
+                         for (u32 x = 0; x < tt.width; x++) fwrite(src + y * pitch + x * 4u + 1u, 1, 3, f);
+                     fclose(f); }
+        }
+    }
+    if (n <= 12) {
+        const float* c = (const float*)g.fp_cb;
+        for (u32 k = 0; k < 32 && (k + 1) * 16u <= g.fp_cb_cap; k++)
+            fprintf(stderr, "[rsx drawtrace] d%u   c%u = %g %g %g %g\n", d, k,
+                    c[k * 4], c[k * 4 + 1], c[k * 4 + 2], c[k * 4 + 3]);
+    }
+    /* The zeta as the draw left it: how much is at 0, at 1, in between. */
+    if (s_dt_zslot != ENG_INVALID && s_dt_zslot < g.n_zdepths && g.be->depth_readback) {
+        const eng_zdepth* z = &g.zdepths[s_dt_zslot];
+        const u32 zw = (z->guest_w && z->guest_w < z->w) ? z->guest_w : z->w;
+        const u32 zh = (z->guest_h && z->guest_h < z->h) ? z->guest_h : z->h;
+        float* zf = (z->handle && zw && zh) ? (float*)malloc((size_t)zw * zh * sizeof(float)) : NULL;
+        if (zf && !g.be->depth_readback(g.be->user, z->handle, zw, zh, zf)) {
+            u64 z0 = 0, z1 = 0; double sum = 0;
+            for (u32 k = 0; k < zw * zh; k++) { z0 += zf[k] <= 0.0f; z1 += zf[k] >= 1.0f; sum += zf[k]; }
+            fprintf(stderr, "[rsx drawtrace] d%u   zeta 0x%08X %ux%u: at 0 %llu, at 1 %llu, mean %.4f,"
+                    " mid %.7f, row %u: %.7f %.7f %.7f %.7f\n",
+                    d, z->offset, zw, zh, (unsigned long long)z0, (unsigned long long)z1, sum / (zw * zh),
+                    zf[(zh / 2) * zw + zw / 2], zh * 5 / 8,
+                    zf[(zh * 5 / 8) * zw + zw / 8], zf[(zh * 5 / 8) * zw + zw * 3 / 8],
+                    zf[(zh * 5 / 8) * zw + zw * 5 / 8], zf[(zh * 5 / 8) * zw + zw * 7 / 8]);
+        }
+        free(zf);
+    }
+    for (u32 i = 0; i < n_targets; i++) {
+        const eng_surface* s = &g.surfaces[targets[i]];
+        if (!s->handle || !s->w || !s->h) continue;
+        u8* px = (u8*)malloc((size_t)s->w * s->h * 4);
+        if (!px) return;
+        g.be->readback(g.be->user, s->handle, 0, 0, s->w, s->h, px, s->w * 4);
+        unsigned long long sr = 0, sg = 0, sb = 0, sa = 0, yel = 0;
+        const u32 np = s->w * s->h;
+        for (u32 k = 0; k < np; k++) {
+            const u8* q = px + k * 4;
+            sr += q[0]; sg += q[1]; sb += q[2]; sa += q[3];
+            yel += (q[0] >= 250 && q[1] >= 250 && q[2] <= 5);
+        }
+        const u8* m = px + ((s->h / 2) * s->w + s->w / 2) * 4;
+        fprintf(stderr, "[rsx drawtrace] d%u p%u n%u t%u 0x%08X %ux%u fmt %d mean %.1f %.1f %.1f %.1f yellow %.1f%% mid %u,%u,%u,%u\n",
+                d, pipeline, n, i, s->offset, s->w, s->h, (int)s->fmt,
+                (double)sr / np, (double)sg / np, (double)sb / np, (double)sa / np,
+                100.0 * (double)yel / np, m[0], m[1], m[2], m[3]);
+        /* PS3RECOMP_ENG_DRAWTRACE_PX=<fx>,<fy>: also one pixel at that place
+         * (fractions of the target), marked "changed" when this draw wrote
+         * it -- which draws make what is on screen there. */
+        { static int px_on = -1; static float pfx, pfy;
+          static struct { u32 slot; u32 rgba; } prev[16]; static u32 nprev;
+          if (px_on < 0) { const char* q = getenv("PS3RECOMP_ENG_DRAWTRACE_PX");
+              px_on = q && sscanf(q, "%f,%f", &pfx, &pfy) == 2 && pfx == pfx && pfy == pfy;
+              if (px_on) { pfx = pfx < 0.0f ? 0.0f : pfx > 1.0f ? 1.0f : pfx;
+                           pfy = pfy < 0.0f ? 0.0f : pfy > 1.0f ? 1.0f : pfy; } }
+          if (px_on) {
+              const u32 X = (u32)(pfx * s->w) < s->w ? (u32)(pfx * s->w) : s->w - 1;
+              const u32 Y = (u32)(pfy * s->h) < s->h ? (u32)(pfy * s->h) : s->h - 1;
+              const u8* q = px + ((size_t)Y * s->w + X) * 4;
+              const u32 v = (u32)q[0] | (u32)q[1] << 8 | (u32)q[2] << 16 | (u32)q[3] << 24;
+              u32 k = 0;
+              /* By surface slot: one offset can hold surfaces of several sizes. */
+              while (k < nprev && prev[k].slot != targets[i]) k++;
+              const int changed = k == nprev || prev[k].rgba != v;
+              if (k == nprev && nprev < 16) { prev[nprev].slot = targets[i]; nprev++; }
+              if (k < 16) prev[k].rgba = v;
+              if (changed)
