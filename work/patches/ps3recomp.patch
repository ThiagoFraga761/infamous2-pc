+int rsx_draw_engine_copy_note(u32 location, u32 offset, u32 dst_ea)
+{
+    if (!g.ready || s_guest_reader) return 0;
+    /* The game copies each 1280-wide image as strips (1024 + 256): a later
+     * strip starts inside the first row of the copy. It only follows the
+     * decision the copy's first strip gets. */
+    for (u32 i = 0; i < 2; i++) {
+        const u32 ea = s_gb.skip_ea[i];
+        if (ea && s_gb.skip_frame[i] == g.frames && dst_ea > ea && dst_ea - ea < s_gb.w[i] * 4u)
+            return location == s_gb.skip_loc[i] && offset - s_gb.skip_src[i] == dst_ea - ea;
+    }
+    const int ao = s_nao.d.mode && (dst_ea == s_nao.d.normals_ea || dst_ea == s_nao.d.depth_ea);
+    const int lt = s_nlt.d.mode && (dst_ea == s_nlt.d.normals_ea || dst_ea == s_nlt.d.depth_ea);
+    if (!ao && !lt) return 0;
+    const u32 which = (ao ? dst_ea == s_nao.d.depth_ea : dst_ea == s_nlt.d.depth_ea) ? 1u : 0u;
+    /* A copy of an image the pair already has, or one in another frame than
+     * the pair's (the other copy of that frame failed or never came), starts
+     * a new pair: a pair never spans frames. */
+    if ((s_gb.have & (1u << which)) || (s_gb.have && s_gb.frame != g.frames))
+        s_gb.have = s_gb.latched = 0;
+    if (!s_gb.have) {
+        s_gb.frame = g.frames;
+        /* Mode 2: the first copy of a frame comes after the last frame's job
+         * has finished, and before either buffer is overwritten. */
+        if (lt && s_nlt.check_w) {
+            const u32 cw = s_nlt.check_w, ch = s_nlt.check_h, cp = s_nlt.check_pitch;
+            s_nlt.check_w = 0;
+            for (u32 k = 0; k < 2; k++) {
+                const u32 kea = k ? s_nlt.d.depth_ea : s_nlt.d.normals_ea;
+                if (vm_base && s_nlt.out[k] && (u64)kea + (u64)cp * ch <= (1ull << 32))
