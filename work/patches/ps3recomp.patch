+/* Port-0 state from a button mask and stick positions (0-255, centre 128). */
+static void pad_apply(PadHostState* hs, u16 btns, int lx, int ly, int rx, int ry)
+{
+    hs->buttons = btns;
+    hs->connected = 1;
