+/* Room for `size` bytes at `align` without a flush? Grows (flushing first)
+ * when the ring could never hold it. Returns -1 when no buffer can be had. */
+static int vk_ring_room(vk_ring* r, VkDeviceSize size, VkDeviceSize align)
+{
+    /* A ring that filled up mid-batch made that batch flush and wait for the
+     * GPU; once it is empty again it is replaced by one twice the size, so
+     * the next frame fits (up to 1 GB). */
+    if (r->grow && r->b.buf && !r->off && r->b.size < (1ull << 30)) {
+        r->grow = 0;
+        const VkDeviceSize want = r->b.size * 2u;
+        vk_buffer nb;
+        memset(&nb, 0, sizeof nb);
+        if (vk_create_host_buffer_ex(&nb, want, r->usage, r->cached) || !nb.coherent) {
+            vk_destroy_buffer(&nb);           /* keep the one that works */
+            static int nf;
+            if (nf++ < 4) VK_LOG("ring of usage 0x%X could not grow to %llu MB\n", (unsigned)r->usage,
+                                 (unsigned long long)(want >> 20));
+            goto sized;
+        }
+        vk_destroy_buffer(&r->b);
+        r->b = nb;
+        s_ring_gen++;
+        static int n;
+        if (n++ < 8) VK_LOG("ring of usage 0x%X grown to %llu MB\n", (unsigned)r->usage,
+                            (unsigned long long)(want >> 20));
+    }
+sized:
+    if (!r->b.buf || r->b.size < size) {
+        VkDeviceSize cap = r->b.size ? r->b.size * 2u : r->min;
+        while (cap < size) cap *= 2u;
+        if (r->b.buf) { vk_flush(); vk_destroy_buffer(&r->b); }
+        if (vk_create_host_buffer_ex(&r->b, cap, r->usage, r->cached) || !r->b.coherent) {
+            vk_destroy_buffer(&r->b); return -1;
+        }
+        r->off = 0;
+        s_ring_gen++;
+    }
+    const VkDeviceSize o = (r->off + align - 1u) / align * align;
+    return o + size <= r->b.size;
+}
+
+/* Carve `size` bytes; the caller made sure there is room (vk_ring_room), or
+ * accepts that a full ring flushes the batch here. */
+static u8* vk_ring_alloc(vk_ring* r, VkDeviceSize size, VkDeviceSize align, VkDeviceSize* out)
+{
+    if (!align) align = 16u;
+    const int room = vk_ring_room(r, size, align);
+    if (room < 0) return NULL;
+    if (!room) { r->grow = 1; vk_flush(); }
+    const VkDeviceSize o = (r->off + align - 1u) / align * align;
+    r->off = o + size;
+    *out = o;
+    return (u8*)r->b.ptr + o;
+}
