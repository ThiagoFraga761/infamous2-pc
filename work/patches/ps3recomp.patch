+                    /* Everything is linked into the .exe: its image base. */
+                    extern char __ImageBase;
+#else
+                    Dl_info di;
+#endif
+                    for (u32 i = 0; i < 32 && s_flush_from[i].at; i++) {
+#ifdef _WIN32
+                        const uintptr_t base = (uintptr_t)&__ImageBase;
+#else
+                        const uintptr_t base = dladdr((void*)s_flush_from[i].at, &di) ? (uintptr_t)di.dli_fbase : 0;
+#endif
+                        fprintf(stderr, "[vk-flush] %u from +0x%lx\n", s_flush_from[i].n,
+                                (unsigned long)(s_flush_from[i].at - base));
+                    }
+                    memset(s_flush_from, 0, sizeof s_flush_from);
+                }
+                n = ns = 0; t0 = now; s_vk_compiles = 0; s_vk_compile_ns = 0;
+            }
+        }
+        s_batch_flushes++;
+    }
