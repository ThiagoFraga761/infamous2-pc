+/* ---- engine batching -------------------------------------------------------
+ * The draw engine used to record, submit and wait on a fence for every draw,
+ * clear and upload: ~45 us a draw, ~205 ms of a 4,500-draw inFAMOUS 2 frame.
+ * Its operations now go into one command buffer that is only submitted where
+ * the CPU has to see the GPU's results (readbacks, present, the engine's own
+ * flush) or before something the pending work references is destroyed. Per
+ * draw memory comes from rings that a flush resets; buffers an operation is
+ * done with are freed after the flush. PS3RECOMP_VK_BATCH=0 restores one
+ * submission per operation. */
+#define VK_BATCH_MAX_OPS  16384u
+#define VK_BATCH_MAX_DEAD 512u
+static vk_buffer s_dead_store[2][VK_BATCH_MAX_DEAD];
