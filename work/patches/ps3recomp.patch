+/* ---- resident geometry (geo_put, draw_geo, geo_drop) ---------------------
+ * The engine's geometry cache keeps a draw's vertices and indices across
+ * frames. Each kept entry is written once into this arena and a hit draws
+ * from it; before, every hit copied both into the vertex ring (New Marais:
+ * ~100k hits and ~22 MB a frame). One host-visible buffer -- the VRAM window
+ * when there is one (VK_HOST_VRAM), system memory otherwise -- carved first
+ * fit from a free list sorted by offset. A dropped block goes on the dead list of the set being recorded
+ * and is free again when that set completes: sets complete in submission
+ * order, so no draw still to run can read it.
+ * PS3RECOMP_VK_GEO_MB=<size> (default 512, above the engine's 384 MB budget
+ * plus the rounding; 0 turns it off).
+ *
+ * geo_put may come from another thread than the rest (geo_put_any_thread:
+ * rsx_be_thread.c records draws on a worker and puts from the engine), so the
+ * arena's bookkeeping is under s_ga_lock, and a draw takes a copy of its
+ * block's place rather than a pointer into a table a put may move. */
+#define VK_GEO_ALIGN 256u
+typedef struct { u32 off, size; } vk_ga_span;
+typedef struct { u32 off, size, ioff; } vk_ga_blk;    /* size 0: a free handle */
+static pthread_mutex_t s_ga_lock = PTHREAD_MUTEX_INITIALIZER;
+static struct {
+    vk_buffer   b;
+    int         tried;
+    vk_ga_span* fr;  u32 nfr, capfr;      /* free spans by offset, none adjacent */
+    vk_ga_blk*  blk; u32 nblk, capblk;    /* handle h is blk[h - 1] */
+    u32*        spare; u32 nspare, capspare;
+    u64         used;
+} s_ga;
+
+/* Room for `need` elements of `elt` bytes at *p. */
+static int vk_ga_reserve(void* p, u32* cap, u32 need, size_t elt)
+{
+    void** pp = (void**)p;
+    if (need <= *cap) return 1;
+    u32 nc = *cap ? *cap * 2u : 64u;
+    while (nc < need) nc *= 2u;
+    void* q = realloc(*pp, (size_t)nc * elt);
+    if (!q) return 0;
+    *pp = q; *cap = nc;
+    return 1;
+}
+
+static int vk_ga_ready(void)
+{
+    if (s_ga.b.buf) return 1;
+    if (s_ga.tried) return 0;
+    s_ga.tried = 1;
+    const char* e = getenv("PS3RECOMP_VK_GEO_MB");
+    const u32 mb = e ? (u32)atoi(e) : 512u;
+    if (!mb || mb > 4095u) return 0;
+    if (vk_create_host_buffer_ex(&s_ga.b, (VkDeviceSize)mb << 20,
+                                 VK_BUFFER_USAGE_VERTEX_BUFFER_BIT | VK_BUFFER_USAGE_INDEX_BUFFER_BIT,
+                                 VK_HOST_VRAM) ||
+        !s_ga.b.coherent || !vk_ga_reserve(&s_ga.fr, &s_ga.capfr, 1, sizeof *s_ga.fr)) {
+        vk_destroy_buffer(&s_ga.b);
+        VK_LOG("engine: no %u MB buffer for geometry kept on the GPU; hits copy as before\n", mb);
+        return 0;
+    }
+    s_ga.fr[0].off = 0; s_ga.fr[0].size = mb << 20; s_ga.nfr = 1;
+    VK_LOG("engine: %u MB for geometry kept on the GPU\n", mb);
+    return 1;
+}
+
+/* Back into the free list, merged with the spans on either side. */
+static int vk_ga_free_span(u32 off, u32 size)
+{
+    u32 i = 0;
+    while (i < s_ga.nfr && s_ga.fr[i].off < off) i++;
+    const int prev = i > 0 && s_ga.fr[i - 1].off + s_ga.fr[i - 1].size == off;
+    const int next = i < s_ga.nfr && off + size == s_ga.fr[i].off;
+    if (prev && next) {
+        s_ga.fr[i - 1].size += size + s_ga.fr[i].size;
+        memmove(&s_ga.fr[i], &s_ga.fr[i + 1], (size_t)(s_ga.nfr - i - 1u) * sizeof *s_ga.fr);
+        s_ga.nfr--;
+    } else if (prev) {
+        s_ga.fr[i - 1].size += size;
+    } else if (next) {
+        s_ga.fr[i].off = off; s_ga.fr[i].size += size;
+    } else {
+        if (!vk_ga_reserve(&s_ga.fr, &s_ga.capfr, s_ga.nfr + 1u, sizeof *s_ga.fr)) return 0;
+        memmove(&s_ga.fr[i + 1], &s_ga.fr[i], (size_t)(s_ga.nfr - i) * sizeof *s_ga.fr);
+        s_ga.fr[i].off = off; s_ga.fr[i].size = size;
+        s_ga.nfr++;
+    }
+    return 1;
+}
+
+static void vk_ga_release_locked(u32 h)
+{
+    if (!h || h > s_ga.nblk || !s_ga.blk[h - 1u].size) return;
+    vk_ga_blk* B = &s_ga.blk[h - 1u];
+    vk_ga_free_span(B->off, B->size);       /* on failure the span is lost, not reused */
+    s_ga.used -= B->size;
+    B->size = 0;
+    if (vk_ga_reserve(&s_ga.spare, &s_ga.capspare, s_ga.nspare + 1u, sizeof *s_ga.spare))
+        s_ga.spare[s_ga.nspare++] = h;
+}
+static void vk_ga_release(u32 h)
+{
+    pthread_mutex_lock(&s_ga_lock);
+    vk_ga_release_locked(h);
+    pthread_mutex_unlock(&s_ga_lock);
+}
+/* A live block's place, copied out under the lock: 0 when h names none. */
+static int vk_ga_get(u32 h, vk_ga_blk* out)
+{
+    pthread_mutex_lock(&s_ga_lock);
+    const int ok = h && h <= s_ga.nblk && s_ga.blk[h - 1u].size;
+    if (ok) *out = s_ga.blk[h - 1u];
+    pthread_mutex_unlock(&s_ga_lock);
+    return ok;
+}
+
+static void vk_ga_destroy(void)
+{
+    pthread_mutex_lock(&s_ga_lock);
+    vk_destroy_buffer(&s_ga.b);
+    free(s_ga.fr); free(s_ga.blk); free(s_ga.spare);
+    free(s_geo_dead); free(s_park.geo_dead);
+    s_geo_dead = s_park.geo_dead = NULL;
+    s_geo_ndead = s_geo_capdead = s_park.geo_ndead = s_park.geo_capdead = 0;
+    memset(&s_ga, 0, sizeof s_ga);
+    pthread_mutex_unlock(&s_ga_lock);
+}
+
+static u32 vk_ga_put_locked(const void* vertices, u32 vertex_bytes, const u32* indices, u32 index_count);
+static u32 vk_eng_geo_put(void* user, const void* vertices, u32 vertex_bytes,
+                          const u32* indices, u32 index_count)
+{
+    VK_CS(CS_GEO_PUT);
+    (void)user;
+    if (!vertices || !vertex_bytes) return 0;
+    pthread_mutex_lock(&s_ga_lock);
+    const u32 h = vk_ga_put_locked(vertices, vertex_bytes, indices, index_count);
+    pthread_mutex_unlock(&s_ga_lock);
+    return h;
+}
+static u32 vk_ga_put_locked(const void* vertices, u32 vertex_bytes, const u32* indices, u32 index_count)
+{
+    if (!vk_ga_ready()) return 0;
+    const u64 va = ((u64)vertex_bytes + 15u) & ~15ull, ib = (u64)index_count * 4u;
+    const u64 tot = (va + ib + VK_GEO_ALIGN - 1u) & ~(u64)(VK_GEO_ALIGN - 1u);
+    if (tot > s_ga.b.size) return 0;
+    u32 i = 0;
+    while (i < s_ga.nfr && s_ga.fr[i].size < tot) i++;
+    if (i == s_ga.nfr) return 0;
+    u32 h;
+    if (s_ga.nspare) h = s_ga.spare[--s_ga.nspare];
+    else if (vk_ga_reserve(&s_ga.blk, &s_ga.capblk, s_ga.nblk + 1u, sizeof *s_ga.blk)) h = ++s_ga.nblk;
+    else return 0;
+    vk_ga_blk* B = &s_ga.blk[h - 1u];
+    B->off = s_ga.fr[i].off; B->size = (u32)tot; B->ioff = B->off + (u32)va;
+    s_ga.fr[i].off += (u32)tot; s_ga.fr[i].size -= (u32)tot;
+    if (!s_ga.fr[i].size) {
+        memmove(&s_ga.fr[i], &s_ga.fr[i + 1], (size_t)(s_ga.nfr - i - 1u) * sizeof *s_ga.fr);
+        s_ga.nfr--;
+    }
+    s_ga.used += tot;
+    u8* d = (u8*)s_ga.b.ptr + B->off;
+    memcpy(d, vertices, vertex_bytes);
+    if (ib) memcpy(d + va, indices, (size_t)ib);
+    return h;
+}
+
+static void vk_eng_geo_drop(void* user, u32 h)
+{
+    (void)user;
+    vk_ga_blk b;
+    if (!vk_ga_get(h, &b)) return;
+    /* The frame in flight may read it even when nothing is recording. */
+    if (!s_batch.recording && !vk_park_pending()) { vk_ga_release(h); return; }
+    if (!vk_ga_reserve(&s_geo_dead, &s_geo_capdead, s_geo_ndead + 1u, sizeof *s_geo_dead)) {
+        vk_flush();                          /* nothing submitted is left to read it */
+        vk_ga_release(h);
+        return;
+    }
+    s_geo_dead[s_geo_ndead++] = h;
+}
