+/* The SPIR-V a program translates to, kept on disk by the hash of its HLSL:
+ * glslang's HLSL front end plus legalisation is most of the ~5 ms a new
+ * pipeline costs, and a scene change asks for hundreds at once -- the hitches.
+ * $PS3RECOMP_SHADER_CACHE (a directory; "0" disables), else
+ * $XDG_CACHE_HOME/ps3recomp/spirv, else ~/.cache/ps3recomp/spirv. */
+static const char* vk_spv_cache_dir(void)
+{
+    static int init;
+    static char dir[512];
+    if (!init) {
+        init = 1;
+        const char* e = getenv("PS3RECOMP_SHADER_CACHE");
+        if (e && !strcmp(e, "0")) return NULL;
+        if (e && *e) snprintf(dir, sizeof dir, "%s", e);
+        else {
+            const char* x = getenv("XDG_CACHE_HOME");
+            const char* h = getenv("HOME");
+#ifdef _WIN32
+            const char* la = getenv("LOCALAPPDATA");
+#else
+            const char* la = NULL;
+#endif
+            if (x && *x) snprintf(dir, sizeof dir, "%s/ps3recomp/spirv", x);
+            else if (la && *la) snprintf(dir, sizeof dir, "%s/ps3recomp/spirv", la);
+            else if (h && *h) snprintf(dir, sizeof dir, "%s/.cache/ps3recomp/spirv", h);
+        }
+        if (dir[0]) {
+            /* mkdir -p */
+            char tmp[512];
+            snprintf(tmp, sizeof tmp, "%s", dir);
+            for (char* q = tmp + 1; *q; q++)
+                if (*q == '/') { *q = 0; vk_mkdir(tmp); *q = '/'; }
+            vk_mkdir(tmp);
+        }
+    }
+    return dir[0] ? dir : NULL;
+}
