+/* ---- ZPASS occlusion queries ---------------------------------------------
+ * NV4097 counts the samples that pass the depth and stencil tests while
+ * SET_ZPASS_PIXEL_COUNT_ENABLE is on, from the last CLEAR_REPORT_VALUE, and
+ * GET_REPORT writes the running count. Every counted draw is one occlusion
+ * query around its draw call (each engine draw is its own render pass
+ * instance). A report is the sum of the queries since the clear, written into
+ * the guest's 16-byte record once the batch that ran them has completed --
+ * titles read a report a frame later, out of a double-buffered slot. */
+#define VK_ZP_QUERIES 1024u
+#define VK_ZP_REPORTS 64u
+/* `carry`: the report was recorded before any clear in its batch, so it also
+ * counts what the batches before had counted since the clear (s_zp_carry,
+ * known once they have completed -- with two frames in flight, after this
+ * one was recorded). */
+typedef struct { u8* dst; u64 base; u32 first, last; u8 carry; } vk_zp_rep;
+static vk_zp_rep s_zp_reps[2][VK_ZP_REPORTS];
+static struct {
+    VkQueryPool pool;
+    int  tried;
+    int  on;            /* the next draw is counted                           */
+    int  need_reset;    /* the pool has not been reset in this batch          */
+    int  known;         /* a clear happened in this batch                     */
+    u32  used;          /* queries recorded in this batch                     */
+    u32  first;         /* this batch's first query since the clear          */
+    u64  base;          /* counted in this batch's resolved part since the clear */
+    vk_zp_rep* rep;
+    u32  nrep;
+} s_zp = { .need_reset = 1, .rep = s_zp_reps[0] };
+/* The count since the last clear as of the last completed batch. */
+static u64 s_zp_carry;
+
+static u64 vk_zp_sum(u32 first, u32 last)
+{
+    if (!s_zp.pool || last <= first) return 0;
+    u64 v[VK_ZP_QUERIES];
+    if (pvkGetQueryPoolResults(s_vk.device, s_zp.pool, first, last - first, sizeof v, v,
+                               sizeof v[0], VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WAIT_BIT) != VK_SUCCESS)
+        return 0;
+    u64 sum = 0;
+    for (u32 i = 0; i < last - first; i++) sum += v[i];
+    return sum;
+}
+
+/* After the batch that recorded the queries has completed. */
+static void vk_zp_resolve(void)
+{
+    const u64 carry = s_zp_carry;
+    for (u32 i = 0; i < s_zp.nrep; i++) {
+        /* Samples of the scaled targets, counted in guest pixels, rounded up:
+         * a few visible image samples are still a visible guest pixel to a
+         * title that tests the count against 0 (flares, coronas). */
+        const u64 nn = (u64)vk_res_scale() * vk_res_scale();
+        const u64 sum = ((s_zp.rep[i].carry ? carry : 0u) + s_zp.rep[i].base +
+                         vk_zp_sum(s_zp.rep[i].first, s_zp.rep[i].last) + nn - 1u) / nn;
+        const u32 value = sum > 0xFFFFFFFFull ? 0xFFFFFFFFu : (u32)sum;
+        /* PS3RECOMP_VK_ZPLOG=<n>: the first n report values. */
+        { static long zl = -2; static long nz;
+          if (zl == -2) { const char* e = getenv("PS3RECOMP_VK_ZPLOG"); zl = e ? atol(e) : 0; }
+          if (nz < zl) { nz++; VK_LOG("zpass report %u (%u queries) -> %u samples\n", i,
+                                      s_zp.rep[i].last - s_zp.rep[i].first, value); } }
+        struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
+        const u64 t = (u64)ts.tv_sec * 1000000000ull + (u64)ts.tv_nsec;
+        u8* d = s_zp.rep[i].dst;
+        for (int k = 0; k < 8; k++) d[k] = (u8)(t >> (56 - 8 * k));
+        d[8] = (u8)(value >> 24); d[9] = (u8)(value >> 16); d[10] = (u8)(value >> 8); d[11] = (u8)value;
+        d[12] = d[13] = d[14] = d[15] = 0;
+    }
+    s_zp.nrep = 0;
+    /* The running count as this batch left it. */
+    s_zp_carry = (s_zp.known ? 0u : carry) + s_zp.base + vk_zp_sum(s_zp.first, s_zp.used);
+    s_zp.base = 0;
+    s_zp.known = 0;
+    s_zp.first = s_zp.used = 0;
+    s_zp.need_reset = 1;
+}
