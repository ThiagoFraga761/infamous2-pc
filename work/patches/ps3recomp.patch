+/* Both passes are what the game samples, the latest lighting job's lights
+ * are ones the passes do, and the GPU's lighting was sampled for the last
+ * pair. */
+static int eng_gb_both_live(void)
+{
+    return s_nao.d.mode == 1 && s_nlt.d.mode == 1 && eng_nlt_last_ok() &&
+           __atomic_load_n(&s_nao_live, __ATOMIC_ACQUIRE) &&
+           __atomic_load_n(&s_nlt_live, __ATOMIC_ACQUIRE) &&
+           s_nlt.latch_seq - s_nlt_sub_latch <= 1u;
+}
+
+/* The guest's copies of the G-buffer have no reader left: both SPU jobs that
+ * read them skip their work -- the occlusion kernels while the GPU's
+ * occlusion is sampled, the lighting job while its lights are ones the passes
+ * do -- and the jobs' own transfers of them move nothing (spu_dma_skip_range).
+ * Only after GOOD_PAIRS frames in a row of that: a frame that falls back to
+ * the SPU after the copies were left out lights whatever those addresses last
+ * held -- an old lit result, not a G-buffer -- so the copies stay on through
+ * any unsteady stretch. PS3RECOMP_NATIVE_GBUFFER_COPY=1 keeps copying. */
+static int eng_gb_copy_unneeded(void)
+{
+    enum { GOOD_PAIRS = 8 };
+    static int keep = -1;
+    if (keep < 0) keep = getenv("PS3RECOMP_NATIVE_GBUFFER_COPY") ? 1 : 0;
+    if (keep || s_gb.good_pairs < GOOD_PAIRS || !eng_gb_both_live()) return 0;
+    static u32 skipped;
+    if (!skipped++)
+        fprintf(stderr, "[rsx engine] G-buffer copies left out of guest memory from here on\n");
+    return 1;
+}
