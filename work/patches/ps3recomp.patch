+void spu_cold_dispatch(spu_cold_args* p)
+{
+    spu_context* ctx = (spu_context*)p->ctx;
+    switch (p->op) {
+    case SPU_COLD_LS_READ: {
+        const uint32_t lsa = p->lsa;
+        spu_ls_read_probe(ctx, lsa);
+        spu_ls_watch_hit2(ctx, lsa & (SPU_LS_MASK & ~0xFu), 0, &ctx->ls[lsa & (SPU_LS_MASK & ~0xFu)],
+                          (uint32_t)ctx->pc & SPU_LS_MASK, ctx->gpr[0]._u32[0] & SPU_LS_MASK);
+        return;
+    }
+    case SPU_COLD_LS_WRITE_PRE:
+        spu_ls_write_probe_pre(ctx, p->lsa, p->a);
+        return;
+    case SPU_COLD_LS_WRITE_POST:
+        spu_ls_watch_hit2(ctx, p->lsa, 1, p->p, (uint32_t)ctx->pc & SPU_LS_MASK,
+                          ctx->gpr[0]._u32[0] & SPU_LS_MASK);
