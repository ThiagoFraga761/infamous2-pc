+/* ---- the driver's pipeline cache, on disk --------------------------------
+ * A pipeline the driver has to compile costs ~10 ms, and a scene change asks
+ * for dozens: the 100 ms frames. Mesa keeps compiled shaders in its own disk
+ * cache, but that one is shared with every other Vulkan program and capped
+ * (1 GB by default, and full on the desktop), so this title's pipelines were
+ * evicted and built again. The port's own VkPipelineCache is loaded from
+ * <shader cache>/../vkpipe-<vendor>-<device>-<uuid>.bin at start (the driver
+ * checks the header and ignores data from another driver build) and written
+ * back from a thread of its own when it has grown, so a later session finds
+ * every pipeline an earlier one built. The pipelines are the same either way;
+ * only the time to make them changes. PS3RECOMP_VK_PIPECACHE=0 turns it off. */
+static char s_pcache_path[640];
+static u64 s_pcache_new;                 /* pipelines built since the last write */
+static u64 s_pcache_written_ns;
+static int s_pcache_writing;
