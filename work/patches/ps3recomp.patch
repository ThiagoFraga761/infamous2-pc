+    case 3: return sgn | 0x7FF0000000000000ull | (m ? m : 1);      /* NaN (quiet or signalling) */
+    case 4: return sgn | 0x7FEFFFFFFFFFFFFFull;                     /* max normal */
+    case 5: return sgn | 0x0010000000000000ull;                     /* min normal */
+    case 6: return sgn | 0x3FF0000000000000ull | (rnd() & 1 ? m : 0);
+    case 7: return rnd64();
+    case 8: return sgn | ((uint64_t)(1 + rnd() % 2046) << 52) | m;  /* random normal */
+    case 9: return sgn | ((uint64_t)(2040 + rnd() % 7) << 52) | m;  /* near overflow */
+    case 10: return sgn | ((uint64_t)(rnd() % 6) << 52) | m;        /* near underflow */
+    default: return sgn | ((uint64_t)(1000 + rnd() % 48) << 52) | m; /* tame */
+    }
+}
+/* operand class of an op: 0 integer, 1 single float, 2 double */
+static int op_kind(int op) {
+    switch (op) {
+    case R_FA: case R_FS: case R_FM: case R_FMA: case R_FMS: case R_FNMS: case R_FCEQ: case R_FCGT: case R_FCMEQ: case R_FCMGT:
+    case R_FREST: case R_FRSQEST: case R_FI: case R_CFLTS: case R_CFLTU: case R_FESD: return 1;
+    case R_DFA: case R_DFS: case R_DFM: case R_DFMA: case R_DFMS: case R_DFNMS: case R_DFNMA: case R_DFCEQ: case R_DFCGT:
+    case R_DFCMEQ: case R_DFCMGT: case R_DFTSV: case R_FRDS: return 2;
+    }
+    return 0;
+}
+
+static spu_context g_ctx;
+static u128 g_orig[128];
+static uint8_t g_gbe[128][16];
+static uint8_t g_ls0[0x40000];     /* pristine LS (never holds the test instruction) */
+
+static void bsw_store(uint8_t* o, const u128* v) { for (int i = 0; i < 4; i++) { uint32_t w = v->_u32[i]; o[4*i] = w >> 24; o[4*i+1] = w >> 16; o[4*i+2] = w >> 8; o[4*i+3] = w; } }
+static void set_reg(int r, uint32_t w0, uint32_t w1, uint32_t w2, uint32_t w3) {
+    g_orig[r]._u32[0] = w0; g_orig[r]._u32[1] = w1; g_orig[r]._u32[2] = w2; g_orig[r]._u32[3] = w3; bsw_store(g_gbe[r], &g_orig[r]);
+}
+static void fill_reg(int r, int kind) {
+    uint32_t w[4];
+    if (kind == 0) for (int i = 0; i < 4; i++) w[i] = int_word();
+    else if (kind == 1) for (int i = 0; i < 4; i++) w[i] = float_word();
+    else { for (int i = 0; i < 2; i++) { uint64_t d = double_word(); w[2*i] = (uint32_t)(d >> 32); w[2*i+1] = (uint32_t)d; } }
+    set_reg(r, w[0], w[1], w[2], w[3]);
+}
+
+/* ======================================================================================== */
+/* instruction construction                                                                 */
+/* ======================================================================================== */
+enum { F_NONE, F_I7, F_I8, F_I10, F_I16, F_I18 };
+static int op_magn(int op) { for (int i = 0; i < R_NTAB; i++) if (r_tab[i].op == op) return r_tab[i].magn; return -1; }
+static int op_imm_kind(int op) {
+    switch (op) {
+    case R_ROTI: case R_ROTMI: case R_ROTMAI: case R_SHLI: case R_ROTHI: case R_ROTHMI: case R_ROTMAHI: case R_SHLHI:
+    case R_CBD: case R_CHD: case R_CWD: case R_CDD: case R_ROTQBII: case R_ROTQMBII: case R_SHLQBII: case R_ROTQBYI: case R_ROTQMBYI: case R_SHLQBYI:
+        return F_I7;
+    }
+    switch (op_magn(op)) { case 1: return F_I8; case 2: return F_I16; case 3: return F_I10; case 4: return F_I18; }
+    return F_NONE;
+}
+static int op_is_rrr(int op) { return op_magn(op) == 7; }
+static uint32_t op_prefix_insn(int op) {
+    for (int i = 0; i < R_NTAB; i++) if (r_tab[i].op == op) { int pbits = 11 - r_tab[i].magn; return r_tab[i].val << (32 - pbits); }
+    return 0;
+}
+static int imm_bits(int k) { return k == F_I7 ? 7 : k == F_I8 ? 8 : k == F_I10 ? 10 : k == F_I16 ? 16 : k == F_I18 ? 18 : 0; }
+static int imm_shift(int k) { return (k == F_I16 || k == F_I18) ? 7 : 14; }
+#define NPAT_ALIAS 81
+#define NPAT_TOTAL (NPAT_ALIAS + 30)
+/* regs used by alias patterns */
+static const int ALIAS_REG[3] = { 5, 6, 7 };
+
+static uint32_t build_insn(int op, int pat, uint32_t imm, int* used_regs /*[4]: rt ra rb rc, -1 unused*/) {
+    int k = op_imm_kind(op), rrr = op_is_rrr(op);
+    uint32_t insn = op_prefix_insn(op);
+    int f[4];   /* rt, ra, rb, rc(=rt4 dest in RRR) */
+    if (pat < NPAT_ALIAS) { int p = pat; for (int i = 0; i < 4; i++) { f[i] = ALIAS_REG[p % 3]; p /= 3; } }
+    else for (int i = 0; i < 4; i++) { f[i] = (int)(rnd() % 128); if (f[i] == 1) f[i] = 2; }   /* r1: RPCS3's CBX family asserts on a misaligned SP */
+    for (int i = 0; i < 4; i++) used_regs[i] = -1;
+    /* low bits not otherwise assigned stay random */
+    uint32_t rest = rnd();
+    int lo_bits_top;                          /* bits below the opcode prefix */
+    { int pbits = 11 - op_magn(op); lo_bits_top = 32 - pbits; }
+    uint32_t lowmask = (lo_bits_top >= 32) ? ~0u : ((1u << lo_bits_top) - 1);
+    insn |= rest & lowmask;
+    if (rrr) {
+        insn = (insn & ~(0x7Fu << 21)) | ((uint32_t)f[0] << 21); used_regs[0] = f[0];
+        insn = (insn & ~(0x7Fu << 7))  | ((uint32_t)f[1] << 7);  used_regs[1] = f[1];
+        insn = (insn & ~(0x7Fu << 14)) | ((uint32_t)f[2] << 14); used_regs[2] = f[2];
+        insn = (insn & ~0x7Fu)         | (uint32_t)f[3];         used_regs[3] = f[3];
+    } else {
+        insn = (insn & ~0x7Fu) | (uint32_t)f[0]; used_regs[0] = f[0];
+        if (k != F_I16 && k != F_I18) { insn = (insn & ~(0x7Fu << 7)) | ((uint32_t)f[1] << 7); used_regs[1] = f[1]; }
+        if (k == F_NONE) { insn = (insn & ~(0x7Fu << 14)) | ((uint32_t)f[2] << 14); used_regs[2] = f[2]; }
+        if (k != F_NONE) { int b = imm_bits(k), s = imm_shift(k); uint32_t m = ((1u << b) - 1) << s; insn = (insn & ~m) | ((imm << s) & m); }
+    }
+    switch (op) { case R_BI: case R_BISL: case R_IRET: case R_BISLED: case R_BIZ: case R_BINZ: case R_BIHZ: case R_BIHNZ: case R_HBR:
+        if ((insn & (3u << 18)) == (3u << 18)) insn &= ~(1u << 19);   /* e&&d is architecturally undefined (RPCS3 throws) */ break; default: break; }
+    if (op == R_RDCH || op == R_WRCH || op == R_RCHCNT) { used_regs[1] = -1; insn = (insn & ~(0x7Fu << 7)) | ((rnd() % 128) << 7); }
+    return insn;
+}
+
+/* ======================================================================================== */
+/* comparison                                                                                */
+/* ======================================================================================== */
+typedef struct { long trials, fail, skipped_oracle, hand_fallback, audit_fail; } OpStat;
+static int g_audit;
+
+static void oracle_from_hand(const Ref* R, uint32_t insn, oracle_result* o) {
+    memset(o, 0, sizeof *o); o->ok = 1;
+    for (int r = 0; r < 128; r++) memcpy(o->gpr[r], g_gbe[r], 16);
+    if (R->dest >= 0) memcpy(o->gpr[R->dest], R->val.b, 16);
+    o->next_pc = R->next; o->halted = R->halt; o->stopped = R->stop; o->stop_code = R->stop_code;
+    if (R->ch_op) { o->ch_ops = 1; o->ch_no = R->ch_no; }
+    if (R->st) { o->mem = 1; o->mem_addr = R->st_addr; memcpy(o->mem_quad, R->st_val.b, 16); }
+    (void)insn;
+}
+
+static void qhex(char* b, const uint8_t* q) { sprintf(b, "%02X%02X%02X%02X_%02X%02X%02X%02X_%02X%02X%02X%02X_%02X%02X%02X%02X", q[0],q[1],q[2],q[3],q[4],q[5],q[6],q[7],q[8],q[9],q[10],q[11],q[12],q[13],q[14],q[15]); }
+
+/* returns 0 if equal, else writes a description */
+static int compare(const oracle_result* e, const oracle_result* g, char* why, size_t wn) {
+    if (e->halted != g->halted) { snprintf(why, wn, "halt: got %d exp %d", g->halted, e->halted); return 1; }
+    if (e->stopped != g->stopped || (e->stopped && e->stop_code != g->stop_code)) { snprintf(why, wn, "stop: got %d/%X exp %d/%X", g->stopped, g->stop_code, e->stopped, e->stop_code); return 1; }
+    for (int r = 0; r < 128; r++) if (memcmp(e->gpr[r], g->gpr[r], 16)) {
+        char a[64], b[64]; qhex(a, g->gpr[r]); qhex(b, e->gpr[r]); snprintf(why, wn, "r%d got %s exp %s", r, a, b); return 1; }
+    if (e->mem != g->mem || (e->mem && (e->mem_addr != g->mem_addr || memcmp(e->mem_quad, g->mem_quad, 16)))) {
+        char a[64], b[64]; qhex(a, g->mem_quad); qhex(b, e->mem_quad); snprintf(why, wn, "mem got %d@%05X %s exp %d@%05X %s", g->mem, g->mem_addr, a, e->mem, e->mem_addr, b); return 1; }
+    if (e->ch_ops != g->ch_ops || (e->ch_ops && (e->ch_no != g->ch_no || e->ch_out != g->ch_out))) { snprintf(why, wn, "channel: got n=%d ch=%u v=%08X exp n=%d ch=%u v=%08X", g->ch_ops, g->ch_no, g->ch_out, e->ch_ops, e->ch_no, e->ch_out); return 1; }
+    if (!e->halted && e->next_pc != g->next_pc) { snprintf(why, wn, "pc got %05X exp %05X", g->next_pc, e->next_pc); return 1; }
+    return 0;
+}
+
+/* backend: run one instruction on g_ctx (registers already loaded); return nonzero if it halted/stopped */
+typedef int (*backend_fn)(spu_context* ctx, uint32_t insn, uint32_t pc, void* user);
+static int backend_interp(spu_context* ctx, uint32_t insn, uint32_t pc, void* user) {
+    (void)user; uint32_t m = pc & 0x3FFFC;
+    ctx->ls[m] = insn >> 24; ctx->ls[m+1] = insn >> 16; ctx->ls[m+2] = insn >> 8; ctx->ls[m+3] = insn;
+    ctx->pc = pc; return spu_step(ctx);
+}
+
+static long g_total_trials, g_total_fail, g_total_skip, g_total_hand, g_total_audit;
+static int  g_ops_done;
+static char g_hand_ops[1024], g_skip_ops[1024];
+
+/* Execute one trial. Returns 1 on mismatch. */
+static int one_trial(int op, uint32_t insn, uint32_t pc, backend_fn be, void* user, OpStat* st, int* printed, const char* nm) {
+    uint32_t m = pc & 0x3FFFC; uint8_t patch[4] = { insn >> 24, insn >> 16, insn >> 8, insn }, sv[4];
+    uint32_t srr0 = rnd(), evt = rnd() & 1, ch_in = int_word(), ch_cnt = int_word();
+    memcpy(sv, g_ls0 + m, 4);
+    /* RPCS3 oracle */
+    oracle_result ex;
+    rpcs3_oracle_poke(m, patch, 4);
+    int ok = rpcs3_oracle_run(insn, pc, (const uint8_t (*)[16])g_gbe, srr0, ch_in, ch_cnt, evt, &ex);
+    rpcs3_oracle_poke(m, sv, 4);
+    if (ok && (op == R_CSFLT || op == R_CUFLT)) {
+        /* Known RPCS3 precise-path bug: a zero source lane is rescaled like a nonzero one, so for i8 > 155 it yields a
+         * nonzero float (exponent = i8-155). int->float of 0 is 0 for every scale; expect that. */
+        int ra = (insn >> 7) & 0x7F, rt = insn & 0x7F;
+        for (int i = 0; i < 4; i++) if (g_orig[ra]._u32[i] == 0) memset(&ex.gpr[rt][4*i], 0, 4);
+    }
+    /* hand-written ISA reference (fallback where RPCS3 has no implementation; --audit cross-check) */
+    memcpy(g_ls0 + m, patch, 4);
+    Ref R = ref_exec(op, insn, pc, g_orig, g_ls0, srr0, evt);
+    memcpy(g_ls0 + m, sv, 4);
+    oracle_result hr; int have_hand = (R.next != ~0u);
+    if (have_hand) oracle_from_hand(&R, insn, &hr);
+    char why[300]; why[0] = 0;
+    if (g_audit) {
+        if (!ok || !have_hand) return 0;
+        oracle_result g2 = hr;
+        if (R.ch_op == 1 || R.ch_op == 3) memcpy(g2.gpr[insn & 0x7F], ex.gpr[insn & 0x7F], 16);   /* payload not modelled */
+        if (R.ch_op == 2) g2.ch_out = ex.ch_out;
+        st->trials++;
+        if (compare(&ex, &g2, why, sizeof why)) { st->audit_fail++; if ((*printed)++ < 3) printf("  AUDIT %s insn=%08X pc=%05X: hand-ref vs RPCS3: %s\n", nm, insn, pc, why); return 1; }
+        return 0;
+    }
+    int hand = 0;
+    if (!ok) {
+        st->skipped_oracle++;
+        if (!have_hand) return 0;
+        ex = hr; hand = 1; st->hand_fallback++;
+    }
+    /* ours */
+    memcpy(g_ctx.gpr, g_orig, sizeof g_orig);
+    g_ctx.srr0 = srr0; g_ctx.event_mask = evt ? 0xFF : 0; g_ctx.event_status = 0xFF; g_ctx.status = SPU_STATUS_RUNNING; g_ctx.stop_code = 0;
+    g_ch_n = 0; memset(&g_ch_val, 0, sizeof g_ch_val); g_ch_val._u32[0] = ch_in; g_ch_cnt = ch_cnt;
+    int halted = be(&g_ctx, insn, pc, user);
+    oracle_result got; memset(&got, 0, sizeof got); got.ok = 1;
+    for (int r = 0; r < 128; r++) bsw_store(got.gpr[r], &g_ctx.gpr[r]);
+    got.halted = halted && (g_ctx.status & SPU_STATUS_STOPPED_BY_HALT);
+    got.stopped = halted && (g_ctx.status & SPU_STATUS_STOPPED_BY_STOP); got.stop_code = got.stopped ? g_ctx.stop_code : 0;
+    got.next_pc = (uint32_t)g_ctx.pc & 0x3FFFC;
+    got.ch_ops = (int)g_ch_n; got.ch_no = g_ch_n ? g_ch_last : 0; got.ch_out = (g_ch_n && op == R_WRCH) ? g_ch_val._u32[0] : 0;
+    oracle_result e = ex;
+    if (e.ch_ops && op != R_WRCH) e.ch_out = 0;
+    if (!e.ch_ops) { e.ch_no = 0; e.ch_out = 0; }
+    if (e.mem) { got.mem = 1; got.mem_addr = e.mem_addr; memcpy(got.mem_quad, g_ctx.ls + e.mem_addr, 16); }
+    st->trials++;
+    int bad = compare(&e, &got, why, sizeof why);
+    /* restore ours' LS from the pristine copy: instruction word + any touched quad */
+    memcpy(g_ctx.ls + m, sv, 4);
+    if (e.mem) memcpy(g_ctx.ls + e.mem_addr, g_ls0 + e.mem_addr, 16);
+    if (bad) { st->fail++; if ((*printed)++ < show_limit()) { printf("  MISMATCH %s insn=%08X pc=%05X%s: %s\n", nm, insn, pc, hand ? " [vs hand-ref]" : "", why);
+        char x[64], y[64], z[64], w[64]; qhex(x, g_gbe[(insn >> 7) & 0x7F]); qhex(y, g_gbe[(insn >> 14) & 0x7F]); qhex(z, g_gbe[insn & 0x7F]); qhex(w, g_gbe[(insn >> 21) & 0x7F]);
+        printf("      operands: ra=%s rb=%s rt/rc=%s rt4=%s\n", x, y, z, w); } }
+    return bad;
+}
+
+/* Run every trial of one op. */
+static int run_op(int op, long scale, backend_fn be, void* user) {
+    char nm[32]; lname(op, nm);
+    OpStat st; memset(&st, 0, sizeof st); int printed = 0;
+    int k = op_imm_kind(op), kind = op_kind(op);
+    long nimm = k == F_NONE ? 1 : (1L << imm_bits(k));
+    long reps = k == F_NONE ? (NPAT_TOTAL * 6L) : (k == F_I16 ? 1 : k == F_I18 ? 1 : 4);
+    if (kind != 0) reps *= (k == F_NONE ? 4 : 6);
+    reps *= scale;
+    if (k == F_I18 || k == F_I16) { if (scale > 1) reps = scale; }
+    long pat = 0;
+    for (long im = 0; im < nimm; im++) for (long rp = 0; rp < reps; rp++) {
+        int used[4]; int p = (int)(pat++ % NPAT_TOTAL);
+        uint32_t insn = build_insn(op, p, (uint32_t)im, used);
+        /* operands: refresh the registers named by the instruction and the alias registers */
+        for (int i = 0; i < 4; i++) if (used[i] >= 0) fill_reg(used[i], (op == R_CSFLT || op == R_CUFLT) ? 0 : kind);
+        for (int i = 0; i < 3; i++) if ((rnd() & 3) == 0) fill_reg(ALIAS_REG[i], kind);
+        if ((rnd() & 7) == 0 && used[1] >= 0 && used[2] >= 0) {   /* equal / near-equal operands exercise compares */
+            memcpy(&g_orig[used[2]], &g_orig[used[1]], 16); if (rnd() & 1) g_orig[used[2]]._u8[rnd() & 15] ^= (uint8_t)(1 + rnd() % 255);
+            bsw_store(g_gbe[used[2]], &g_orig[used[2]]); }
+        uint32_t pc = (rnd() % 8 == 0) ? ((rnd() & 1) ? 0x3FFFC : 0) : (rnd() & 0x3FFFC);
+        one_trial(op, insn, pc, be, user, &st, &printed, nm);
+    }
+    g_total_trials += st.trials; g_total_fail += st.fail + st.audit_fail; g_total_skip += st.skipped_oracle; g_total_hand += st.hand_fallback;
+    if (st.hand_fallback && strlen(g_hand_ops) < 900) { strcat(g_hand_ops, nm); strcat(g_hand_ops, " "); }
+    if (st.skipped_oracle && !st.hand_fallback && strlen(g_skip_ops) < 900) { strcat(g_skip_ops, nm); strcat(g_skip_ops, " "); }
+    g_ops_done++;
+    printf("%-9s %-10s %9ld trials  %ld mismatches%s\n", (st.fail || st.audit_fail) ? "FAIL" : "ok", nm, st.trials, st.fail + st.audit_fail,
+           st.hand_fallback ? "  (RPCS3 has no impl: compared to hand-written ISA reference)" : st.skipped_oracle ? "  (some trials skipped: RPCS3 undefined)" : "");
+    return st.fail + st.audit_fail != 0;
+}
+
+#ifdef LIFTED_CASES_INC
+/* backend: the lifter's emitted C for exactly this instruction word. user = case index. */
+static int backend_lifted(spu_context* ctx, uint32_t insn, uint32_t pc, void* user) {
+    long idx = (long)user;
+    uint32_t m = pc & 0x3FFFC; ctx->ls[m] = insn >> 24; ctx->ls[m+1] = insn >> 16; ctx->ls[m+2] = insn >> 8; ctx->ls[m+3] = insn;   /* code is in LS (lqr of own word) */
+    g_spu_trampoline_fn = 0; g_lc_called = 0; ctx->pc = pc;
+    g_lc_cases[idx].fn(ctx);
+    if (g_lc_called) ctx->pc = g_lc_target;               /* call / indirect-call: the callee entry */
+    else if (!g_spu_trampoline_fn && !(ctx->status & (SPU_STATUS_STOPPED_BY_STOP | SPU_STATUS_STOPPED_BY_HALT))) ctx->pc = pc + 4;
+    else if (ctx->status & SPU_STATUS_STOPPED_BY_STOP) ctx->pc = (pc + 4) & 0x3FFFC;
+    return (ctx->status & (SPU_STATUS_STOPPED_BY_STOP | SPU_STATUS_STOPPED_BY_HALT)) != 0;
+}
+static int run_lifted_cases(long scale) {
+    OpStat all; memset(&all, 0, sizeof all); int failing = 0;
+    int cur_op = -1; OpStat st; int printed = 0; char nm[32] = "";
+    for (long ci = 0; ci <= LC_NCASES; ci++) {
+        int op = ci < LC_NCASES ? ref_decode(g_lc_cases[ci].insn) : -2;
+        if (op != cur_op) {
+            if (cur_op > 0) { g_ops_done++; g_total_trials += st.trials; g_total_fail += st.fail; g_total_skip += st.skipped_oracle; g_total_hand += st.hand_fallback;
+                printf("%-9s %-10s %9ld lifted trials  %ld mismatches\n", st.fail ? "FAIL" : "ok", nm, st.trials, st.fail); failing += st.fail != 0; }
+            memset(&st, 0, sizeof st); printed = 0; cur_op = op; if (op > 0) lname(op, nm);
+        }
+        if (ci == LC_NCASES) break;
+        uint32_t insn = g_lc_cases[ci].insn, pc = g_lc_cases[ci].pc; int kind = op_kind(op);
+        for (long t = 0; t < 24 * scale * (kind ? 3 : 1); t++) {
+            int ra = (insn >> 7) & 0x7F, rb = (insn >> 14) & 0x7F, rt = insn & 0x7F, rt4 = (insn >> 21) & 0x7F;
+            int regs[4] = { ra, rb, rt, rt4 };
+            for (int i = 0; i < 4; i++) fill_reg(regs[i], (op == R_CSFLT || op == R_CUFLT) ? 0 : kind);
+            for (int i = 0; i < 3; i++) if ((rnd() & 3) == 0) fill_reg(ALIAS_REG[i], kind);
+            if ((rnd() & 7) == 0) { memcpy(&g_orig[rb], &g_orig[ra], 16); if (rnd() & 1) g_orig[rb]._u8[rnd() & 15] ^= (uint8_t)(1 + rnd() % 255); bsw_store(g_gbe[rb], &g_orig[rb]); }
+            one_trial(op, insn, pc, backend_lifted, (void*)ci, &st, &printed, nm);
+        }
+    }
+    return failing;
+}
+#endif
