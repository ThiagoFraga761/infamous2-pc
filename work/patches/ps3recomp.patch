diff --git a/runtime/memory/guest_mem_atomic.h b/runtime/memory/guest_mem_atomic.h
new file mode 100644
index 0000000..2097690
--- /dev/null
+++ b/runtime/memory/guest_mem_atomic.h
@@ -0,0 +1,140 @@
+/*
+ * ps3recomp - guest memory accesses with the Cell's single-copy atomicity.
+ *
+ * On Cell an aligned load or store of up to 8 bytes is single-copy atomic:
+ * another PPU thread or an SPU's DMA sees all of it or none of it. Guest code
+ * depends on that -- a spin flag read with a plain lwz while another thread
+ * stores it, a lock-free fast path reading a word a peer updates -- and does
+ * not wrap those accesses in anything. Emulated with memcpy they are C data
+ * races: undefined behaviour the compiler may tear, merge or cache, and what
+ * ThreadSanitizer reports on every SPURS suite.
+ *
+ * These helpers do aligned 1/2/4/8-byte guest accesses as relaxed atomics
+ * (the same single instruction on x86-64 and ARM64, so no cost) and fall back
+ * to memcpy only when the address is misaligned, where the guest access was
+ * not atomic either. Bulk copies (DMA, a 128-byte reservation line) move whole
+ * aligned doublewords atomically, which is at least as strong as the MFC.
+ * Values stay in guest (big-endian) byte order; callers byte-swap.
+ */
+#ifndef PS3RECOMP_GUEST_MEM_ATOMIC_H
+#define PS3RECOMP_GUEST_MEM_ATOMIC_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+#define GM_RELAXED __ATOMIC_RELAXED
+
+static inline uint8_t gm_load8(const uint8_t* p)
+{
+    return __atomic_load_n(p, GM_RELAXED);
+}
+static inline uint16_t gm_load16(const uint8_t* p)
+{
+    if (((uintptr_t)p & 1u) == 0) return __atomic_load_n((const uint16_t*)p, GM_RELAXED);
+    uint16_t v; memcpy(&v, p, 2); return v;
+}
+static inline uint32_t gm_load32(const uint8_t* p)
+{
+    if (((uintptr_t)p & 3u) == 0) return __atomic_load_n((const uint32_t*)p, GM_RELAXED);
+    uint32_t v; memcpy(&v, p, 4); return v;
+}
+static inline uint64_t gm_load64(const uint8_t* p)
+{
+    if (((uintptr_t)p & 7u) == 0) return __atomic_load_n((const uint64_t*)p, GM_RELAXED);
+    uint64_t v; memcpy(&v, p, 8); return v;
+}
+
+static inline void gm_store8(uint8_t* p, uint8_t v)
+{
+    __atomic_store_n(p, v, GM_RELAXED);
+}
+static inline void gm_store16(uint8_t* p, uint16_t v)
+{
+    if (((uintptr_t)p & 1u) == 0) { __atomic_store_n((uint16_t*)p, v, GM_RELAXED); return; }
+    memcpy(p, &v, 2);
+}
+static inline void gm_store32(uint8_t* p, uint32_t v)
+{
+    if (((uintptr_t)p & 3u) == 0) { __atomic_store_n((uint32_t*)p, v, GM_RELAXED); return; }
+    memcpy(p, &v, 4);
+}
+static inline void gm_store64(uint8_t* p, uint64_t v)
+{
+    if (((uintptr_t)p & 7u) == 0) { __atomic_store_n((uint64_t*)p, v, GM_RELAXED); return; }
+    memcpy(p, &v, 8);
+}
+
+/* Bulk copies move aligned 16-byte blocks on x86-64 with SSE: an aligned
+ * 16-byte access is atomic on every CPU with AVX (Intel SDM vol. 3 9.1.1, AMD
+ * APM vol. 2 7.3.2) and never splits an aligned 8-byte word on any of them,
+ * so no reader sees a torn word -- the guarantee the 8-byte atomics give --
+ * at twice the width and without a store per word. A thread-sanitizer build
+ * keeps the atomics, which it can see. */
+#if (defined(__x86_64__) || defined(_M_X64)) && !defined(__SANITIZE_THREAD__)
+#include <emmintrin.h>
+#define GM_COPY_SSE 1
+#endif
+
+/* guest -> host */
+static inline void gm_copy_from(void* dst, const uint8_t* g, size_t n)
+{
+    uint8_t* d = (uint8_t*)dst;
+    size_t i = 0;
+    for (; i < n && (((uintptr_t)(g + i)) & 7u); i++) d[i] = gm_load8(g + i);
+#ifdef GM_COPY_SSE
+    if (i + 8 <= n && (((uintptr_t)(g + i)) & 15u)) {
+        uint64_t v = gm_load64(g + i); memcpy(d + i, &v, 8); i += 8;
+    }
+    /* volatile: one MOVDQA per block, never folded into a memcpy */
+    for (; i + 16 <= n; i += 16)
+        _mm_storeu_si128((__m128i*)(d + i), *(const volatile __m128i*)(g + i));
+#endif
+    for (; i + 8 <= n; i += 8) { uint64_t v = gm_load64(g + i); memcpy(d + i, &v, 8); }
+    for (; i < n; i++) d[i] = gm_load8(g + i);
+}
+
+/* host -> guest */
+static inline void gm_copy_to(uint8_t* g, const void* src, size_t n)
+{
+    const uint8_t* s = (const uint8_t*)src;
+    size_t i = 0;
+    for (; i < n && (((uintptr_t)(g + i)) & 7u); i++) gm_store8(g + i, s[i]);
+#ifdef GM_COPY_SSE
+    if (i + 8 <= n && (((uintptr_t)(g + i)) & 15u)) {
+        uint64_t v; memcpy(&v, s + i, 8); gm_store64(g + i, v); i += 8;
+    }
+    for (; i + 16 <= n; i += 16)
+        *(volatile __m128i*)(g + i) = _mm_loadu_si128((const __m128i*)(s + i));
+#endif
+    for (; i + 8 <= n; i += 8) { uint64_t v; memcpy(&v, s + i, 8); gm_store64(g + i, v); }
+    for (; i < n; i++) gm_store8(g + i, s[i]);
+}
+
+/* A guest store of n bytes from a host buffer: one atomic access for the
+ * natural sizes, a word-wise copy otherwise. */
+static inline void gm_store_bytes(uint8_t* g, const void* src, size_t n)
+{
+    switch (n) {
+    case 1: gm_store8(g, *(const uint8_t*)src); return;
+    case 2: { uint16_t v; memcpy(&v, src, 2); gm_store16(g, v); return; }
+    case 4: { uint32_t v; memcpy(&v, src, 4); gm_store32(g, v); return; }
+    case 8: { uint64_t v; memcpy(&v, src, 8); gm_store64(g, v); return; }
+    default: gm_copy_to(g, src, n); return;
+    }
+}
+
+/* Compare n guest bytes against a host snapshot (a reservation line). */
+static inline int gm_equal(const uint8_t* g, const void* snap, size_t n)
+{
+    uint8_t buf[256];
+    while (n) {
+        size_t k = n < sizeof buf ? n : sizeof buf;
+        gm_copy_from(buf, g, k);
+        if (memcmp(buf, snap, k)) return 0;
+        g += k; snap = (const uint8_t*)snap + k; n -= k;
+    }
+    return 1;
+}
+
+#endif
diff --git a/runtime/memory/guest_wtrack.c b/runtime/memory/guest_wtrack.c
new file mode 100644
index 0000000..1e29dc7
--- /dev/null
+++ b/runtime/memory/guest_wtrack.c
@@ -0,0 +1,257 @@
+/* guest_wtrack.c -- see guest_wtrack.h.
+ *
+ * Ordering. gwt_arm takes its stamp, then marks the whole range protected,
+ * then makes it read-only -- always the whole range, so a page some other
+ * code made writable behind the tracking's back is caught again by the next
+ * arm. The fault handler counts the page in flight, makes it writable,
+ * clears the mark, stamps it from the clock, and only then drops the in-flight
+ * count. So:
+ *   - a write that faults after an arm always ends up with a stamp later than
+ *     the arm's;
+ *   - a write that lands before the arm's protection is in place is seen by
+ *     whatever reads the range after arming;
+ *   - between the handler making a page writable and stamping it, other
+ *     threads can write it without faulting -- gwt_clean says "written" for
+ *     any page in flight, so that window is never reported clean.
+ * Host code that has the kernel write a range (gwt_host_write_begin/end)
+ * holds those pages open: they are stamped at both ends, and gwt_arm leaves a
+ * range with an open page untracked rather than protect it under a syscall. */
+#include "guest_wtrack.h"
+
+#if defined(__linux__)
+#include <errno.h>
+#include <pthread.h>
+#include <signal.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <time.h>
+
+extern uint8_t* vm_base;
+
+#define GWT_EA     0xC0000000u            /* RSX local memory */
+#define GWT_SIZE   0x10000000u            /* 256 MB */
+#define GWT_PAGE   4096u
+#define GWT_PAGES  (GWT_SIZE / GWT_PAGE)
+#define GWT_OPEN_MAX 16
+
+static uint64_t        s_clock = 1;         /* stamps handed out; atomics only */
+static uint64_t        s_gen[GWT_PAGES];    /* last write stamp per page */
+static uint8_t         s_prot[GWT_PAGES];   /* the page is (or is being made) read-only */
+static uint8_t         s_inflight[GWT_PAGES];/* a fault handler is between RW and stamp */
+static uint8_t         s_open[GWT_PAGES];   /* inside a host-write bracket */
+static struct { size_t first, last; int used; } s_open_tab[GWT_OPEN_MAX];
+static uint8_t*        s_base;
+static uint64_t        s_faults;
+static pthread_mutex_t s_lock = PTHREAD_MUTEX_INITIALIZER;
+static struct sigaction s_prev;
+static int             s_mode = -1;
+
+static void gwt_stamp(size_t pg)
+{
+    const uint64_t t = __atomic_add_fetch(&s_clock, 1, __ATOMIC_SEQ_CST);
+    uint64_t cur = __atomic_load_n(&s_gen[pg], __ATOMIC_RELAXED);
+    while (cur < t && !__atomic_compare_exchange_n(&s_gen[pg], &cur, t, 1,
+                                                   __ATOMIC_SEQ_CST, __ATOMIC_RELAXED)) {}
+}
+
+/* Make [first, last] writable from the fault handler and stamp it. */
+static int gwt_reopen(size_t first, size_t last)
+{
+    for (size_t pg = first; pg <= last; pg++)
+        __atomic_add_fetch(&s_inflight[pg], 1, __ATOMIC_SEQ_CST);
+    const int ok = mprotect(s_base + first * GWT_PAGE, (last - first + 1) * GWT_PAGE,
+                            PROT_READ | PROT_WRITE) == 0;
+    for (size_t pg = first; pg <= last; pg++) {
+        if (ok) {
+            __atomic_store_n(&s_prot[pg], 0, __ATOMIC_SEQ_CST);
+            gwt_stamp(pg);
+        }
+        __atomic_sub_fetch(&s_inflight[pg], 1, __ATOMIC_SEQ_CST);
+    }
+    return ok;
+}
+
+/* Async-signal-safe: atomics, mprotect and sigaction only. */
+static void gwt_handler(int sig, siginfo_t* si, void* uc)
+{
+    const int saved_errno = errno;
+    uint8_t* const a = (uint8_t*)si->si_addr;
+    uint8_t* const base = s_base;
+    if (base && si->si_code == SEGV_ACCERR && a >= base && a < base + GWT_SIZE) {
+        const size_t pg = (size_t)(a - base) / GWT_PAGE;
+        /* One page; if the kernel cannot split the mapping that finely
+         * (vm.max_map_count), a 64 KB and then a 2 MB block around it, whose
+         * edges can merge with the writable mappings next to them. */
+        if (gwt_reopen(pg, pg) ||
+            gwt_reopen(pg & ~(size_t)15, (pg & ~(size_t)15) + 15) ||
+            gwt_reopen(pg & ~(size_t)511, (pg & ~(size_t)511) + 511)) {
+            __atomic_add_fetch(&s_faults, 1, __ATOMIC_RELAXED);
+            errno = saved_errno;
+            return;                                   /* the store runs again */
+        }
+    }
+    errno = saved_errno;
+    /* Not ours: whoever was installed before, else the default action (the
+     * faulting instruction runs again and takes it). */
+    if ((s_prev.sa_flags & SA_SIGINFO) && s_prev.sa_sigaction) {
+        s_prev.sa_sigaction(sig, si, uc);
+        return;
+    }
+    if (!(s_prev.sa_flags & SA_SIGINFO) && s_prev.sa_handler != SIG_DFL &&
+        s_prev.sa_handler != SIG_IGN) {
+        s_prev.sa_handler(sig);
+        return;
+    }
+    struct sigaction dfl;
+    memset(&dfl, 0, sizeof dfl);
+    dfl.sa_handler = SIG_DFL;
+    sigaction(sig, &dfl, NULL);
+}
+
+int gwt_mode(void)
+{
+    int m = __atomic_load_n(&s_mode, __ATOMIC_ACQUIRE);
+    if (m >= 0) return m;
+    if (!vm_base) return 0;                /* too early: ask again later */
+    pthread_mutex_lock(&s_lock);
+    if (s_mode < 0) {
+        const char* e = getenv("PS3RECOMP_WTRACK");
+        m = e ? atoi(e) : 0;
+        if (m > 0) {
+            struct sigaction sa;
+            memset(&sa, 0, sizeof sa);
+            sa.sa_sigaction = gwt_handler;
+            sa.sa_flags = SA_SIGINFO | SA_RESTART;
+            sigemptyset(&sa.sa_mask);
+            if (sigaction(SIGSEGV, &sa, &s_prev) == 0) {
+                s_base = vm_base + GWT_EA;
+                fprintf(stderr, "[wtrack] local memory write tracking on%s\n",
+                        m >= 2 ? " (verifying)" : "");
+            } else {
+                fprintf(stderr, "[wtrack] no SIGSEGV handler (%s): tracking off\n", strerror(errno));
+                m = 0;
+            }
+        }
+        __atomic_store_n(&s_mode, m, __ATOMIC_RELEASE);
+    }
+    m = s_mode;
+    pthread_mutex_unlock(&s_lock);
+    return m;
+}
+
+static int gwt_pages(const void* p, size_t n, size_t* first, size_t* last)
+{
+    const uint8_t* a = (const uint8_t*)p;
+    if (!s_base || !n || a < s_base || a + n > s_base + GWT_SIZE) return 0;
+    *first = (size_t)(a - s_base) / GWT_PAGE;
+    *last  = (size_t)(a + n - 1 - s_base) / GWT_PAGE;
+    return 1;
+}
+
+int gwt_trackable(const void* p, size_t n)
+{
+    size_t first, last;
+    return gwt_mode() > 0 && gwt_pages(p, n, &first, &last);
+}
+
+uint64_t gwt_arm(const void* p, size_t n)
+{
+    size_t first, last;
+    if (gwt_mode() <= 0 || !gwt_pages(p, n, &first, &last)) return 0;
+    pthread_mutex_lock(&s_lock);
+    for (size_t pg = first; pg <= last; pg++)
+        if (__atomic_load_n(&s_open[pg], __ATOMIC_SEQ_CST)) {   /* the kernel is writing it */
+            pthread_mutex_unlock(&s_lock);
+            return 0;
+        }
+    const uint64_t stamp = __atomic_load_n(&s_clock, __ATOMIC_SEQ_CST);
+    for (size_t pg = first; pg <= last; pg++) __atomic_store_n(&s_prot[pg], 1, __ATOMIC_SEQ_CST);
+    const int ok = mprotect(s_base + first * GWT_PAGE, (last - first + 1) * GWT_PAGE, PROT_READ) == 0;
+    if (!ok)
+        for (size_t pg = first; pg <= last; pg++) __atomic_store_n(&s_prot[pg], 0, __ATOMIC_SEQ_CST);
+    pthread_mutex_unlock(&s_lock);
+    return ok ? stamp : 0;
+}
+
+int gwt_clean(const void* p, size_t n, uint64_t stamp)
+{
+    size_t first, last;
+    if (!stamp || !gwt_pages(p, n, &first, &last)) return 0;
+    for (size_t pg = first; pg <= last; pg++)
+        if (__atomic_load_n(&s_inflight[pg], __ATOMIC_SEQ_CST) ||
+            __atomic_load_n(&s_open[pg], __ATOMIC_SEQ_CST) ||
+            __atomic_load_n(&s_gen[pg], __ATOMIC_SEQ_CST) > stamp) return 0;
+    return 1;
+}
+
+int gwt_host_write_begin(void* p, size_t n)
+{
+    size_t first, last;
+    if (gwt_mode() <= 0) return 0;
+    /* Clip to the tracked range: a buffer may straddle its edge. */
+    uint8_t* a = (uint8_t*)p;
+    uint8_t* b = a + n;
+    if (!s_base || b <= s_base || a >= s_base + GWT_SIZE) return 0;
+    if (a < s_base) a = s_base;
+    if (b > s_base + GWT_SIZE) b = s_base + GWT_SIZE;
+    if (!gwt_pages(a, (size_t)(b - a), &first, &last)) return 0;
+    int slot;
+    for (;;) {                             /* a free bracket: there are never many at once */
+        pthread_mutex_lock(&s_lock);
+        slot = 0;
+        while (slot < GWT_OPEN_MAX && s_open_tab[slot].used) slot++;
+        if (slot < GWT_OPEN_MAX) break;
+        pthread_mutex_unlock(&s_lock);
+        struct timespec ts = { 0, 200000 };
+        nanosleep(&ts, NULL);
+    }
+    s_open_tab[slot].first = first; s_open_tab[slot].last = last; s_open_tab[slot].used = 1;
+    for (size_t pg = first; pg <= last; pg++) {
+        __atomic_add_fetch(&s_open[pg], 1, __ATOMIC_SEQ_CST);
+        if (__atomic_load_n(&s_prot[pg], __ATOMIC_SEQ_CST))
+            mprotect(s_base + pg * GWT_PAGE, GWT_PAGE, PROT_READ | PROT_WRITE);
+        __atomic_store_n(&s_prot[pg], 0, __ATOMIC_SEQ_CST);
+        gwt_stamp(pg);
+    }
+    pthread_mutex_unlock(&s_lock);
+    return slot + 1;
+}
+
+void gwt_host_write_end(int token)
+{
+    if (token <= 0 || token > GWT_OPEN_MAX) return;
+    pthread_mutex_lock(&s_lock);
+    const size_t first = s_open_tab[token - 1].first, last = s_open_tab[token - 1].last;
+    for (size_t pg = first; pg <= last; pg++) {
+        gwt_stamp(pg);
+        __atomic_sub_fetch(&s_open[pg], 1, __ATOMIC_SEQ_CST);
+    }
+    s_open_tab[token - 1].used = 0;
+    pthread_mutex_unlock(&s_lock);
+}
+
+void gwt_note_unprotect(const void* p, size_t n)
+{
+    const int tok = gwt_host_write_begin((void*)p, n);
+    gwt_host_write_end(tok);
+}
+
+uint64_t gwt_faults(void)
+{
+    return __atomic_load_n(&s_faults, __ATOMIC_RELAXED);
+}
+
+#else  /* not Linux: tracking unavailable, every range is untracked */
+
+int      gwt_mode(void) { return 0; }
+int      gwt_trackable(const void* p, size_t n) { (void)p; (void)n; return 0; }
+uint64_t gwt_arm(const void* p, size_t n) { (void)p; (void)n; return 0; }
+int      gwt_clean(const void* p, size_t n, uint64_t s) { (void)p; (void)n; (void)s; return 0; }
+int      gwt_host_write_begin(void* p, size_t n) { (void)p; (void)n; return 0; }
+void     gwt_host_write_end(int token) { (void)token; }
+void     gwt_note_unprotect(const void* p, size_t n) { (void)p; (void)n; }
+uint64_t gwt_faults(void) { return 0; }
+
+#endif
diff --git a/runtime/memory/guest_wtrack.h b/runtime/memory/guest_wtrack.h
new file mode 100644
index 0000000..a430c55
--- /dev/null
+++ b/runtime/memory/guest_wtrack.h
@@ -0,0 +1,61 @@
+/* guest_wtrack.h -- which pages of RSX local memory were written, without
+ * reading them.
+ *
+ * A range that has been read (a texture hashed, say) is made read-only. The
+ * first write to one of its pages, by anything in the process, faults: the
+ * handler makes the page writable again and stamps it from a global clock.
+ * The range is unchanged since stamp S while every page in it carries a stamp
+ * no later than S. PPU stores (inline, out-of-line, vector, dcbz), SPU DMA,
+ * the RSX transfer engines and the HLE libraries are all covered without a
+ * hook of their own.
+ *
+ * The kernel is the exception. A read() into a read-only page fails with
+ * EFAULT instead of faulting, so host code that has the kernel write guest
+ * memory brackets it with gwt_host_write_begin/end.
+ *
+ * PS3RECOMP_WTRACK=1 turns it on (Linux only). =2 is the same plus a verify
+ * mode for callers: they keep their own check and report a change the
+ * tracking did not see. */
+#ifndef GUEST_WTRACK_H
+#define GUEST_WTRACK_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* 0 off, 1 on, 2 on and verifying. */
+int      gwt_mode(void);
+
+/* Make the pages of [p, p + n) read-only and return the stamp to test them
+ * against later. 0 when nothing could be armed: tracking off, the range not
+ * in local memory, or mprotect refused. */
+uint64_t gwt_arm(const void* p, size_t n);
+
+/* 1 when [p, p + n) is in the tracked range (and tracking is on), so a
+ * gwt_arm of it can succeed. */
+int      gwt_trackable(const void* p, size_t n);
+
+/* 1 when no page of [p, p + n) was written after `stamp` (a gwt_arm result);
+ * 0 otherwise, and always for stamp 0. */
+int      gwt_clean(const void* p, size_t n, uint64_t stamp);
+
+/* Around host code that has the kernel write [p, p + n) (fread, recv, ...):
+ * the pages are made writable and stamped, and stay so until the end call. A
+ * no-op, returning 0, for ranges outside local memory. */
+int      gwt_host_write_begin(void* p, size_t n);
+void     gwt_host_write_end(int token);
+
+/* mprotect is about to make [p, p + n) writable behind the tracking's back
+ * (vm_commit): stamp the pages as written. */
+void     gwt_note_unprotect(const void* p, size_t n);
+
+/* Write faults taken so far (for stats). */
+uint64_t gwt_faults(void);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/runtime/memory/vm.h b/runtime/memory/vm.h
index 9ea87db..ec6e542 100644
--- a/runtime/memory/vm.h
+++ b/runtime/memory/vm.h
@@ -21,6 +21,7 @@
 #include <stddef.h>
 #include <string.h>
 #include <assert.h>
+#include "guest_wtrack.h"
 
 #ifdef _WIN32
   #define WIN32_LEAN_AND_MEAN
@@ -285,7 +286,12 @@ static inline int32_t vm_commit(uint32_t addr, uint32_t size)
     if (!VirtualAlloc(vm_base + addr, size, MEM_COMMIT, PAGE_READWRITE))
         return CELL_ENOMEM;
 #else
-    if (vm__mprotect_pages(addr, size, PROT_READ | PROT_WRITE) != 0)
+    /* Inside a host-write bracket: the write tracking must neither miss
+     * pages this makes writable nor protect them again halfway. */
+    const int wt = gwt_host_write_begin(vm_base + addr, size);
+    const int rc = vm__mprotect_pages(addr, size, PROT_READ | PROT_WRITE);
+    gwt_host_write_end(wt);
+    if (rc != 0)
         return CELL_ENOMEM;
 #endif
 
diff --git a/runtime/platform/guest_vm.h b/runtime/platform/guest_vm.h
new file mode 100644
index 0000000..7b71868
--- /dev/null
+++ b/runtime/platform/guest_vm.h
@@ -0,0 +1,66 @@
+/*
+ * ps3recomp - the flat guest address space a per-game boot scaffold maps.
+ *
+ * One host region of `size` bytes, guest address == offset into it. Its base
+ * is 4 GB aligned, as vm_init (runtime/memory/vm.h) guarantees for its own
+ * reservation: the HLE recovers guest addresses by truncating host pointers to
+ * 32 bits (GUEST_EA in libs/guest_struct.h), which holds only while the low
+ * 32 bits of the base are zero.
+ *
+ *   Windows  reserved, not committed; the scaffold's vectored handler commits
+ *            each page on first touch. A reservation cannot be trimmed, so the
+ *            aligned window is found by over-reserving, releasing and
+ *            re-reserving there (another allocation can take it in between,
+ *            hence the retries).
+ *   POSIX    read/write with MAP_NORESERVE: there is no vectored handler, and
+ *            the OS backs only the pages the title touches. Over-mapped and
+ *            trimmed, which cannot race.
+ *
+ * Not calloc: glibc serves a request this size from its own mmap and returns a
+ * pointer 16 bytes past the page boundary, so every mprotect behind vm_commit
+ * failed with EINVAL -- sys_memory_allocate returned ENOMEM and the title built
+ * its heap on page 0.
+ *
+ * Returns NULL on failure.
+ */
+#ifndef PS3RECOMP_GUEST_VM_H
+#define PS3RECOMP_GUEST_VM_H
+
+#include "win32_compat.h"
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifndef _WIN32
+#include <sys/mman.h>
+#endif
+
+static inline uint8_t* guest_vm_map_flat(size_t size)
+{
+    const size_t align = (size_t)0x100000000ull;
+    size = (size + 0xFFFFu) & ~(size_t)0xFFFFu;   /* whole pages on any host (<= 64 KB) */
+    uint8_t* base = NULL;
+#ifdef _WIN32
+    for (int attempt = 0; attempt < 8 && !base; attempt++) {
+        uint8_t* probe = (uint8_t*)VirtualAlloc(NULL, size + align, MEM_RESERVE, PAGE_NOACCESS);
+        if (!probe) break;
+        uint8_t* aligned = (uint8_t*)(((uintptr_t)probe + align - 1u) & ~(uintptr_t)(align - 1u));
+        VirtualFree(probe, 0, MEM_RELEASE);
+        base = (uint8_t*)VirtualAlloc(aligned, size, MEM_RESERVE, PAGE_READWRITE);
+    }
+#else
+    uint8_t* raw = (uint8_t*)mmap(NULL, size + align, PROT_READ | PROT_WRITE,
+                                  MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0);
+    if (raw == MAP_FAILED)
+        return NULL;
+    base = (uint8_t*)(((uintptr_t)raw + align - 1u) & ~(uintptr_t)(align - 1u));
+    uint8_t* end = raw + size + align;
+    if (base > raw)
+        munmap(raw, (size_t)(base - raw));
+    if (end > base + size)
+        munmap(base + size, (size_t)(end - (base + size)));
+#endif
+    return base;
+}
+
+#endif /* PS3RECOMP_GUEST_VM_H */
diff --git a/runtime/platform/mingw_posix.h b/runtime/platform/mingw_posix.h
