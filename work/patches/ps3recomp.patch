+    "    vmovdqu64  128(%rsp), %zmm2\n    vmovdqu64  192(%rsp), %zmm3\n"
+    "    vmovdqu64  256(%rsp), %zmm4\n    vmovdqu64  320(%rsp), %zmm5\n"
+    "    vmovdqu64  384(%rsp), %zmm6\n    vmovdqu64  448(%rsp), %zmm7\n"
+    "    vmovdqu64  512(%rsp), %zmm8\n    vmovdqu64  576(%rsp), %zmm9\n"
+    "    vmovdqu64  640(%rsp), %zmm10\n    vmovdqu64  704(%rsp), %zmm11\n"
+    "    vmovdqu64  768(%rsp), %zmm12\n    vmovdqu64  832(%rsp), %zmm13\n"
+    "    vmovdqu64  896(%rsp), %zmm14\n    vmovdqu64  960(%rsp), %zmm15\n"
+    "    vmovdqu64 1024(%rsp), %zmm16\n    vmovdqu64 1088(%rsp), %zmm17\n"
+    "    vmovdqu64 1152(%rsp), %zmm18\n    vmovdqu64 1216(%rsp), %zmm19\n"
+    "    vmovdqu64 1280(%rsp), %zmm20\n    vmovdqu64 1344(%rsp), %zmm21\n"
+    "    vmovdqu64 1408(%rsp), %zmm22\n    vmovdqu64 1472(%rsp), %zmm23\n"
+    "    vmovdqu64 1536(%rsp), %zmm24\n    vmovdqu64 1600(%rsp), %zmm25\n"
+    "    vmovdqu64 1664(%rsp), %zmm26\n    vmovdqu64 1728(%rsp), %zmm27\n"
+    "    vmovdqu64 1792(%rsp), %zmm28\n    vmovdqu64 1856(%rsp), %zmm29\n"
+    "    vmovdqu64 1920(%rsp), %zmm30\n    vmovdqu64 1984(%rsp), %zmm31\n"
+    "    lea  -72(%rbp), %rsp\n"
+    "    pop %r11\n    pop %r10\n    pop %r9\n    pop %r8\n"
+    "    pop %rdi\n    pop %rsi\n    pop %rdx\n    pop %rcx\n    pop %rax\n"
+    "    pop %rbp\n"
+    "    ret\n"
+    ".size spu_cold_thunk_full, .-spu_cold_thunk_full\n");
+
+/* The float fix-ups, first without the full save. Nearly every call comes
+ * from an exponent-255 lane of a geometry job, and the double-precision forms
+ * settle all four lanes; the 2 KB of zmm/k saves and reloads cost more than the
+ * fix-up itself (~1.2% of the process in the city). spu_cold_fast has no
+ * caller-saved registers: clang saves only what it writes. It makes no call,
+ * so that is a handful of registers. It commits a result only when every lane
+ * settled, and clears op to say so; otherwise the full thunk runs the whole
+ * fix-up from the untouched arguments, as before. SPU_COLD_FAST=0, or
+ * SPU_FIX_STATS (counted in spu_cold_dispatch), always takes the full one. */
+_Static_assert(__builtin_offsetof(spu_cold_args, op) == 116, "spu_cold_thunk tests op at 116");
+unsigned char g_spu_cold_fast = 0;
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wexcessive-regsave"
+__attribute__((no_caller_saved_registers, used)) void spu_cold_fast(spu_cold_args* p)
+{
+    __m128i r, ok, a, b, c, xok;
+    memcpy(&r, &p->r, 16); memcpy(&ok, &p->ok, 16);
+    memcpy(&a, &p->a, 16); memcpy(&b, &p->b, 16); memcpy(&c, &p->c, 16);
+    switch (p->op) {
+    case SPU_COLD_FM:     /* spu__av_fm_fix: every lane settles */
+        r = _mm_blendv_epi8(spu__x_pack(_mm256_mul_pd(spu__x_d(a), spu__x_d(b))), r, ok);
+        break;
+    case SPU_COLD_FA: {   /* spu__av_fa_fix's vector part */
+        const __m128i xr = spu__x_sum(spu__x_d(a), spu__x_d(_mm_xor_si128(b, _mm_set1_epi32((int)p->negp))), &xok);
+        r = _mm_blendv_epi8(r, xr, _mm_andnot_si128(ok, xok));
+        if (!spu__av_all4(_mm_or_si128(ok, xok))) return;
+        break;
+    }
+    case SPU_COLD_FMA: {  /* spu__av_fma_fix's vector part */
+        const __m128i xr = spu__x_sum(_mm256_mul_pd(spu__x_d(_mm_xor_si128(a, _mm_set1_epi32((int)p->negp))), spu__x_d(b)),
+                                      spu__x_d(_mm_xor_si128(c, _mm_set1_epi32((int)p->negc))), &xok);
+        r = _mm_blendv_epi8(r, xr, _mm_andnot_si128(ok, xok));
+        if (!spu__av_all4(_mm_or_si128(ok, xok))) return;
+        break;
+    }
+    default:
+        return;
+    }
+    memcpy(&p->r, &r, 16);
+    p->op = 0;
+}
+#pragma clang diagnostic pop
+
+/* The lifted code calls spu_cold_thunk (spu_cold_call): rdi is the argument
+ * block, the stack below the red zone, alignment unknown, and every register
+ * but the flags must come back unchanged. */
+__asm__(
+    ".text\n"
+    ".globl spu_cold_thunk\n"
+    ".type spu_cold_thunk,@function\n"
+    "spu_cold_thunk:\n"
+    "    cmpb $0, g_spu_cold_fast(%rip)\n"
+    "    je   spu_cold_thunk_full\n"
+    "    push %rbp\n"
+    "    mov  %rsp, %rbp\n"
+    "    push %rdi\n"
+    "    and  $-64, %rsp\n"
+    "    call spu_cold_fast\n"
+    "    mov  -8(%rbp), %rdi\n"
+    "    mov  %rbp, %rsp\n"
+    "    pop  %rbp\n"
+    "    cmpl $0, 116(%rdi)\n"
+    "    jne  spu_cold_thunk_full\n"
+    "    ret\n"
+    ".size spu_cold_thunk, .-spu_cold_thunk\n");
