+static u32       s_img_ndead, s_img_capdead;
+static VkFramebuffer* s_fb_dead;
+static u32       s_fb_ndead, s_fb_capdead;
+static void vk_dead_images_free(void);
+static void vk_ga_release(u32 h);
+static u64       s_batch_flushes;
+static void vk_eng_batch_reset(void);    /* rings + descriptor pool, with the engine */
