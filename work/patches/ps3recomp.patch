+#if defined(__AVX512F__) && defined(__AVX512VL__)
+/* AVX-512: single precision, with round-toward-zero carried by the instruction
+ * ({rz-sae}), not by MXCSR. On ordinary operands the IEEE single operation IS
+ * the SPU's: both form the exact result (fma's product unrounded) and truncate
+ * it once to 24 bits. The formats part only at the edges, and each edge is a
+ * mask computed beside the operation, off its latency:
+ *  - an exponent-0 operand with a nonzero fraction (an IEEE denormal, an SPU
+ *    zero) or an exponent-255 one (IEEE Inf/NaN, an SPU number) takes the exact
+ *    lane path; +-0 is the same zero in both formats;
+ *  - a result below 2^-126 (IEEE denormal or zero, of either sign) is +0;
+ *  - a result at or above 2^128 is where IEEE overflows, and truncation pins it
+ *    to +-FLT_MAX: a FLT_MAX result takes the exact lane path (a true FLT_MAX
+ *    with it, rarely).
+ * The double-precision form this replaces widened, operated and narrowed: two
+ * conversions on every op's latency, ~3x the code. Embedded rounding exists
+ * only at 512 bits, so the lower four lanes are used and the rest are zero. */
+#define SPU__Z_RZ (_MM_FROUND_TO_ZERO | _MM_FROUND_NO_EXC)
+SPU__AV_INLINE __m512 spu__z_ps(__m128i x) { return _mm512_zextps128_ps512(_mm_castsi128_ps(x)); }
+/* lanes the vector cannot take as operands: exponent 255, or exponent 0 with a fraction.
+ * With SPU_FP_DAZ neither needs a test: the hardware reads an exponent-0 operand
+ * as zero (DAZ), and an exponent-255 operand -- IEEE Inf or NaN -- makes the
+ * result Inf or NaN, which spu__z_res catches with the overflows. */
+#ifdef SPU_FP_DAZ
+#  define SPU__Z_ODD(x) ((__mmask8)0)
+#else
+#  define SPU__Z_ODD(x) spu__z_odd(x)
+#endif
+static inline __attribute__((unused)) __mmask8 spu__z_odd(__m128i x) {
+    const __m128i e = _mm_and_si128(x, _mm_set1_epi32(0x7F800000));
+    return _mm_cmpeq_epi32_mask(e, _mm_set1_epi32(0x7F800000)) |
+           _mm_mask_test_epi32_mask(_mm_cmpeq_epi32_mask(e, _mm_setzero_si128()), x, _mm_set1_epi32(0x007FFFFF));
+}
+/* the SPU result: a lane at FLT_MAX or beyond (an overflow truncated to FLT_MAX,
+ * an Inf or NaN) is marked bad, an exponent-0 lane becomes +0 */
+SPU__AV_INLINE __m128i spu__z_res(__m512 v, __mmask8* bad) {
+    const __m128i r = _mm_castps_si128(_mm512_castps512_ps128(v));
+    *bad |= _mm_cmpge_epu32_mask(_mm_and_si128(r, _mm_set1_epi32(0x7FFFFFFF)), _mm_set1_epi32(0x7F7FFFFF));
+    return _mm_maskz_mov_epi32(_mm_test_epi32_mask(r, _mm_set1_epi32(0x7F800000)), r);
+}
+/* The fix-ups take an all-ones lane mask; build it from the k-mask. */
+SPU__AV_INLINE __m128i spu__z_okmask(__mmask8 bad) { return _mm_maskz_mov_epi32((__mmask8)~bad, _mm_set1_epi32(-1)); }
+/* A fix-up, through spu_cold_call where it can be (see SPU_COLD_THUNK). */
+SPU__AV_INLINE __m128i spu__z_fix(int op, __m128i r, __mmask8 bad, __m128i a, __m128i b, __m128i c,
+                                 uint32_t negp, uint32_t negc) {
+    const __m128i ok = spu__z_okmask(bad);
+#ifdef SPU_COLD_THUNK
+    spu_cold_args ca;
+    ca.op = op; ca.negp = negp; ca.negc = negc;
+    memcpy(&ca.r, &r, 16); memcpy(&ca.ok, &ok, 16);
+    memcpy(&ca.a, &a, 16); memcpy(&ca.b, &b, 16); memcpy(&ca.c, &c, 16);
+    spu_cold_call(&ca);
+    __m128i o; memcpy(&o, &ca.r, 16); return o;
+#else
+    switch (op) {
+    case SPU_COLD_FA: return spu__av_fa_fix(r, ok, a, b, negp);
+    case SPU_COLD_FM: return spu__av_fm_fix(r, ok, a, b);
+    default:          return spu__av_fma_fix(r, ok, a, b, c, negp, negc);
+    }
+#endif
+}
+SPU__AV_INLINE u128 spu__z_fa(u128 a, u128 b, uint32_t negb) {
+    const __m128i x = spu__av_ld(a), yb = spu__av_ld(b);
+    const __m128i y = _mm_xor_si128(yb, _mm_set1_epi32((int)negb));
+    __mmask8 bad = SPU__Z_ODD(x) | SPU__Z_ODD(y);
+    __m128i r = spu__z_res(_mm512_add_round_ps(spu__z_ps(x), spu__z_ps(y), SPU__Z_RZ), &bad);
+    bad &= 0xF;
+    if (bad) r = spu__z_fix(SPU_COLD_FA, r, bad, x, yb, x, negb, 0);
+    return spu__av_st(r);
+}
+SPU__AV_INLINE u128 spu_fa(u128 a, u128 b) { return spu__z_fa(a, b, 0); }
+SPU__AV_INLINE u128 spu_fs(u128 a, u128 b) { return spu__z_fa(a, b, 0x80000000u); }
+SPU__AV_INLINE u128 spu_fm(u128 a, u128 b) {
+    const __m128i x = spu__av_ld(a), y = spu__av_ld(b);
+    __mmask8 bad = SPU__Z_ODD(x) | SPU__Z_ODD(y);
+    __m128i r = spu__z_res(_mm512_mul_round_ps(spu__z_ps(x), spu__z_ps(y), SPU__Z_RZ), &bad);
+    bad &= 0xF;
+    if (bad) r = spu__z_fix(SPU_COLD_FM, r, bad, x, y, x, 0, 0);
+    return spu__av_st(r);
