+/* Ordering of MFC commands against other agents. On Cell, a command the SPU
+ * has seen complete is performed before any command it issues afterwards, and
+ * the PPU/SPU hand-off protocols (SPURS: PPU stores a job, lwsync, publishes
+ * it in a lock line; SPU GETLLARs the line, then GETs the job) rest on that.
+ * Our transfers are host loads and stores, which a weakly ordered host (ARM64)
+ * may reorder across addresses: the job GET could return data older than the
+ * flag the GETLLAR saw. A full fence on either side of every command restores
+ * the order -- stronger than the MFC requires (unfenced commands in one queue
+ * may complete out of order), never weaker; one barrier per DMA. */
+static inline int mfc_submit(mfc_engine* mfc, spu_context* spu, uint32_t cmd)
+{
+#if defined(__x86_64__) || defined(__i386__) || defined(_M_X64) || defined(_M_IX86)
+    /* x86 lets a load pass an earlier store and reorders nothing else.
+     * - Before a command: the loads and stores it does already stay behind
+     *   everything earlier (load-load, store-store, load-store), so no fence.
+     *   The one reordering left, a GET's loads passing an earlier PUT's
+     *   stores, the MFC allows too: a command without a fence or barrier may
+     *   be performed before an earlier one, and a fenced one is ordered within
+     *   its queue, which running each command to completion in turn already
+     *   is. The hand-offs (the SPURS lock line) go through the lock-line
+     *   commands, fenced on both sides (spu_mfc_atomic).
+     * - After a GET (loads only): nothing later can pass it.
+     * - After anything that stores: a full fence, so that a later load cannot
+     *   pass its stores.
+     * The fence before was a quarter of spu_wrch, which is ~4% of SPU time in
+     * the heavy views. */
+    __atomic_signal_fence(__ATOMIC_SEQ_CST);
+    int r = mfc_submit_body(mfc, spu, cmd);
+    if (((cmd & 0xFF) & 0xE0) == 0x40) { __atomic_signal_fence(__ATOMIC_SEQ_CST); return r; }
+#else
+    __atomic_thread_fence(__ATOMIC_SEQ_CST);
+    int r = mfc_submit_body(mfc, spu, cmd);
+#endif
+    __atomic_thread_fence(__ATOMIC_SEQ_CST);
+    return r;
+}
