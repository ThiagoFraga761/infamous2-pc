diff --git a/runtime/spu/tests/rpcs3_oracle/extract.py b/runtime/spu/tests/rpcs3_oracle/extract.py
new file mode 100644
index 0000000..3120366
--- /dev/null
+++ b/runtime/spu/tests/rpcs3_oracle/extract.py
@@ -0,0 +1,101 @@
+#!/usr/bin/env python3
+"""Assemble the RPCS3 SPU oracle source from the local RPCS3 tree.
+
+Reads rpcs3/rpcs3/Emu/Cell/SPUInterpreter.cpp (+ the LUT/imm-table definitions from
+SPUThread.cpp) and writes <out> = a translation unit that compiles RPCS3's own
+instruction functions unmodified, with three mechanical edits:
+  * the asmjit helper namespace and everything from `template <typename IT> struct
+    spu_interpreter_t` onward (the dispatch table / ctor) are dropped;
+  * the `#if 0` guarding RPCS3's precise-float implementation (spu_interpreter_precise::*)
+    is turned into `#if 1` so it is compiled;
+  * _mm_getcsr() is redirected to the host FP exception flags (x86 MXCSR bit layout), as the x86 build reads them.
+FI has no oracle here (RPCS3's interpreter FI is a TODO approximation); the
+harness skips it. Nothing from RPCS3 is in the repo: everything RPCS3 -- the
+interpreter, its tables, and the declarations they need (rpcs3_decls.h, written
+next to <out>) -- is read from the local RPCS3 tree at build time.
+usage: extract.py <rpcs3 root> <out.cpp>
+"""
+import re, sys
+root, out = sys.argv[1], sys.argv[2]
+L = open(f"{root}/rpcs3/Emu/Cell/SPUInterpreter.cpp", encoding="utf-8").read().split("\n")
+T = open(f"{root}/rpcs3/Emu/Cell/SPUThread.cpp", encoding="utf-8").read()
+TH = open(f"{root}/rpcs3/Emu/Cell/SPUThread.h", encoding="utf-8").read()
+
+
+def block(text, start):
+    """From the line starting with `start` through its matching closing brace (and `;`)."""
+    i = text.index("\n" + start) + 1
+    depth, j, opened = 0, i, False
+    while True:
+        c = text[j]
+        if c == "{": depth += 1; opened = True
+        elif c == "}": depth -= 1
+        j += 1
+        if opened and depth == 0:
+            return text[i:text.index(";", j) + 1]
+
+
+# Declarations the interpreter needs from SPUThread.h, taken from the tree
+decls = "\n".join([
+    "\n".join(l for l in TH.split("\n") if re.match(r"extern const u32 spu_fr(est|sqest)_(fraction|exponent)_lut", l)),
+    block(TH, "struct spu_imm_table_t"), "extern const spu_imm_table_t g_spu_imm;",
+    block(TH, "enum FPSCR_EX"), block(TH, "class SPU_FPSCR")])
+
+# drop includes (first 14 lines are #includes of heavy headers) and extern decoders
+start = next(i for i, l in enumerate(L) if l.startswith("#if !defined(_MSC_VER)"))
+body = L[start:]
+# remove `const extern spu_decoder...` lines
+body = [l for l in body if not l.startswith("const extern spu_decoder")]
+# drop asmjit namespace block
+i = next(i for i, l in enumerate(body) if l.startswith("namespace asmjit"))
+depth = 0; j = i
+while True:
+    depth += body[j].count("{") - body[j].count("}")
+    j += 1
+    if depth == 0 and "{" in "".join(body[i:j]): break
+body = body[:i] + body[j:]
+# drop spu_exec_select (needs RPCS3 bit-set machinery; only used by the dispatch ctor we skip)
+i = next(i for i, l in enumerate(body) if l.startswith("struct spu_exec_select"))
+i -= 1  # the template<> line above
+depth = 0; j = i
+while True:
+    depth += body[j].count("{") - body[j].count("}")
+    j += 1
+    if depth == 0 and "{" in "".join(body[i:j]): break
+body = body[:i] + body[j+1:]
+# cut at the dispatch-table struct
+k = next(i for i, l in enumerate(body) if l.startswith("template <typename IT>"))
+body = body[:k]
+src = "\n".join(body)
+assert src.count("\n#if 0\n") == 1
+src = src.replace("\n#if 0\n", "\n#if 1\n")
+# LUTs + imm tables from SPUThread.cpp
+m = re.search(r"const u32 spu_frest_fraction_lut\[32\].*?spu_frsqest_exponent_lut\[256\]\s*=\s*\{.*?\n\};\n", T, re.S)
+luts = m.group(0)
+m2 = re.search(r"const spu_imm_table_t g_spu_imm;.*?\n(?=void spu_thread::dump_regs)", T, re.S)
+imm = m2.group(0)
+hdr = '''#include "oracle_shim.h"
+#define _mm_getcsr() oracle_getcsr()
+'''
+# --- generated dispatch: RPCS3's own spu_decoder over a table of wrappers ---
+H = open(f"{root}/rpcs3/Emu/Cell/SPUOpcodes.h", encoding="utf-8").read()
+ents = re.findall(r"\{ (\d), (0x[0-9a-f]+), GET\((\w+)\) \}", H)
+names = [n for _, _, n in ents]
+PRECISE = set("FCGT FA FS FM FCMGT DFA DFS DFM DFMA DFMS DFNMS DFNMA FSCRRD FESD FRDS FSCRWR FCEQ FCMEQ "
+              "CFLTS CFLTU CSFLT CUFLT FNMS FMA FMS".split())
+d = ["struct oracle_ops {",
+     "  static bool UNK(spu_thread&, spu_opcode_t) { throw std::runtime_error(\"unk\"); }"]
+for n in names:
+    call = (f"spu_interpreter_precise::{n}(s, o)" if n in PRECISE else
+            "UNK(s, o)" if n == "FI" else f"::{n}<>(s, o)")
+    d.append(f"  static bool {n}(spu_thread& s, spu_opcode_t o) {{ return {call}; }}")
+d.append("};")
+dispatch = "\n".join(d) + "\n#include \"oracle_run.inc\"\n"
+tab = ["/* GENERATED by extract.py from RPCS3 SPUOpcodes.h. X(magn, value, NAME): insn>>21 == value<<magn | low magn bits */",
+       "#define SPU_OPTAB(X) \\"]
+tab.append(" \\\n".join(f"    X({m}, {v}, {n})" for m, v, n in ents))
+import os
+outdir = os.path.dirname(os.path.abspath(out))
+open(os.path.join(outdir, "spu_optab.h"), "w").write("\n".join(tab) + "\n")
+open(os.path.join(outdir, "rpcs3_decls.h"), "w").write("#pragma once\n/* GENERATED by extract.py from RPCS3 SPUThread.h */\n" + decls + "\n")
+open(out, "w", encoding="utf-8").write(hdr + luts + "\n" + imm + "\n" + src + "\n" + dispatch)
diff --git a/runtime/spu/tests/rpcs3_oracle/oracle.h b/runtime/spu/tests/rpcs3_oracle/oracle.h
new file mode 100644
index 0000000..bdf6c50
--- /dev/null
+++ b/runtime/spu/tests/rpcs3_oracle/oracle.h
@@ -0,0 +1,24 @@
+/* C ABI of the RPCS3 SPU oracle (rpcs3_oracle/oracle_run.inc). Registers are passed as
+ * 16 big-endian bytes (SPU byte order, byte 0 = most significant of word 0). */
+#ifndef SPU_ORACLE_H
+#define SPU_ORACLE_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+typedef struct {
+    int ok;                       /* 0: RPCS3 has no implementation / hit undefined behaviour -> skip */
+    uint8_t gpr[128][16];         /* register file after the instruction */
+    uint32_t next_pc;
+    int halted, stopped; uint32_t stop_code;
+    int ch_ops; uint32_t ch_no, ch_out;   /* channel accesses made (rdch/rchcnt/wrch) */
+    int mem; uint32_t mem_addr; uint8_t mem_quad[16];   /* quadword the instruction touched, after it ran */
+} oracle_result;
+void rpcs3_oracle_set_ls(const uint8_t* ls_256k);                     /* snapshot the LS the oracle reads */
+void rpcs3_oracle_poke(uint32_t addr, const uint8_t* p, uint32_t n);  /* patch bytes (the instruction word) */
+int  rpcs3_oracle_run(uint32_t insn, uint32_t pc, const uint8_t gpr[128][16], uint32_t srr0,
+                      uint32_t ch_in, uint32_t ch_cnt, uint32_t events, oracle_result* out);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/runtime/spu/tests/rpcs3_oracle/oracle_run.inc b/runtime/spu/tests/rpcs3_oracle/oracle_run.inc
new file mode 100644
index 0000000..f14ad6d
--- /dev/null
+++ b/runtime/spu/tests/rpcs3_oracle/oracle_run.inc
@@ -0,0 +1,38 @@
+/* included at the end of the generated oracle TU */
+#include "oracle.h"
+namespace utils { bool has_avx() { return false; } u64 _get_main_tid() { return 0; } }
+static spu_thread g_o_spu;
+static uint8_t g_o_ls[0x40000], g_o_ls0[0x40000];
+static const spu_decoder<oracle_ops> g_o_dec;
+namespace fmt { [[noreturn]] void raw_throw_exception(std::source_location, const char*, const fmt_type_info*, const u64*) { throw std::runtime_error("fmt"); } }
+
+extern "C" void rpcs3_oracle_set_ls(const uint8_t* ls) { memcpy(g_o_ls, ls, sizeof g_o_ls); memcpy(g_o_ls0, ls, sizeof g_o_ls0); }
+extern "C" void rpcs3_oracle_poke(uint32_t a, const uint8_t* p, uint32_t n) { memcpy(g_o_ls + a, p, n); memcpy(g_o_ls0 + a, p, n); }
+
+extern "C" int rpcs3_oracle_run(uint32_t insn, uint32_t pc, const uint8_t gpr[128][16], uint32_t srr0,
+                                uint32_t ch_in, uint32_t ch_cnt, uint32_t events, oracle_result* out)
+{
+	spu_thread& s = g_o_spu;
+	memset(out, 0, sizeof *out);
+	for (int r = 0; r < 128; r++) for (int k = 0; k < 16; k++) reinterpret_cast<u8*>(&s.gpr[r])[k] = gpr[r][15 - k];
+	s.fpscr.Reset(); s.pc = pc; s.srr0 = srr0; s.ls = g_o_ls; s.state = 0; s.last_ref = ~0u;
+	s.halted = s.stopped = 0; s.stop_code = 0; s.ch_ops = 0; s.ch_no = 0; s.ch_out_val = 0;
+	s.ch_in_val = ch_in; s.ch_cnt_val = ch_cnt; s.events = events;
+	fesetround(FE_TONEAREST);
+	spu_opcode_t op; op.opcode = insn;
+	bool adv;
+	try { adv = g_o_dec.decode(insn)(s, op); }
+	catch (...) { fesetround(FE_TONEAREST); return 0; }
+	fesetround(FE_TONEAREST);
+	out->ok = 1;
+	out->next_pc = adv ? ((pc + 4) & 0x3FFFC) : (s.pc & 0x3FFFC);
+	out->halted = s.halted; out->stopped = s.stopped; out->stop_code = s.stop_code;
+	out->ch_ops = s.ch_ops; out->ch_no = s.ch_no; out->ch_out = s.ch_out_val;
+	for (int r = 0; r < 128; r++) for (int k = 0; k < 16; k++) out->gpr[r][k] = reinterpret_cast<u8*>(&s.gpr[r])[15 - k];
+	if (s.last_ref != ~0u) {
+		out->mem = 1; out->mem_addr = s.last_ref;
+		memcpy(out->mem_quad, g_o_ls + s.last_ref, 16);
+		memcpy(g_o_ls + s.last_ref, g_o_ls0 + s.last_ref, 16);   /* undo the store */
+	}
+	return 1;
+}
diff --git a/runtime/spu/tests/rpcs3_oracle/shim/oracle_shim.h b/runtime/spu/tests/rpcs3_oracle/shim/oracle_shim.h
new file mode 100644
index 0000000..109d908
--- /dev/null
+++ b/runtime/spu/tests/rpcs3_oracle/shim/oracle_shim.h
@@ -0,0 +1,94 @@
+/* Minimal stand-in for the parts of RPCS3 (stdafx.h, SPUThread.h, SPUInterpreter.h, ...)
+ * that rpcs3/Emu/Cell/SPUInterpreter.cpp needs, so its per-instruction functions can be
+ * compiled unmodified into a standalone oracle. Uses RPCS3's real v128/simd/BitField
+ * headers; only the spu_thread state is a stub. */
+#pragma once
+#include <stdexcept>
+#include "util/types.hpp"
+#include "Utilities/StrFmt.h"
+#include "util/endian.hpp"
+#include "util/to_endian.hpp"
+#include "util/asm.hpp"
+#include "util/v128.hpp"
+#include "util/simd.hpp"
+#include "Utilities/BitField.h"
+#include "Emu/Cell/SPUOpcodes.h"
+#include "Emu/Cell/Common.h"
+#if defined(ARCH_ARM64)
+#include "Emu/CPU/sse2neon.h"
+#endif
+#include <array>
+#include <cmath>
+#include <cfenv>
+#include <cstdio>
+#include <stdexcept>
+#include <utility>
+
+struct spu_log_t { template <typename... A> void fatal(const char*, A&&...) { throw std::runtime_error("unk"); } } static spu_log;
+
+/* RPCS3's own declarations (LUT externs, spu_imm_table_t, FPSCR_EX, SPU_FPSCR),
+ * written from the RPCS3 tree by extract.py at build time. */
+#include "rpcs3_decls.h"
+
+namespace cpu_flag_stub { }
+namespace cpu_flag { constexpr u32 pending = 1; }
+struct spu_events_stub { u32 count; };
+
+/* The stub machine the instruction functions run against. */
+class spu_thread
+{
+public:
+	v128 gpr[128];
+	SPU_FPSCR fpscr;
+	u32 pc = 0, srr0 = 0;
+	u8* ls = nullptr;
+	u32 state = 0;
+	bool allow_interrupts_in_cpu_work = false;
+	/* oracle I/O */
+	int halted = 0, stopped = 0; u32 stop_code = 0;
+	int ch_ops = 0; u32 ch_no = 0; u32 ch_in_val = 0, ch_cnt_val = 0, ch_out_val = 0; u32 events = 0;
+	mutable u32 last_ref = ~0u;   /* LS address of the last load/store, for the harness */
+	template <typename T> to_be_t<T>& _ref(u32 lsa) const { last_ref = lsa; return *reinterpret_cast<to_be_t<T>*>(ls + lsa); }
+	void halt() { halted = 1; }
+	bool stop_and_signal(u32 code) { stopped = 1; stop_code = code; return true; }
+	s64 get_ch_value(u32 ch) { ch_ops++; ch_no = ch; return ch_in_val; }
+	u32 get_ch_count(u32 ch) { ch_ops++; ch_no = ch; return ch_cnt_val; }
+	bool set_ch_value(u32 ch, u32 v) { ch_ops++; ch_no = ch; ch_out_val = v; return true; }
+	spu_events_stub get_events() { return {events}; }
+	bool check_mfc_interrupts(u32) { return false; }
+	void do_mfc() {}
+	void set_interrupt_status(bool) {}
+};
+
+struct spu_interpreter { static void set_interrupt_status(spu_thread&, spu_opcode_t); };
+struct spu_interpreter_precise
+{
+#define PF(n) static bool n(spu_thread&, spu_opcode_t);
+	PF(FREST) PF(FRSQEST) PF(FCGT) PF(FA) PF(FS) PF(FM) PF(FCMGT) PF(DFA) PF(DFS) PF(DFM) PF(DFMA) PF(DFMS) PF(DFNMS) PF(DFNMA)
+	PF(FSCRRD) PF(FESD) PF(FRDS) PF(FSCRWR) PF(FCEQ) PF(FCMEQ) PF(FI) PF(CFLTS) PF(CFLTU) PF(CSFLT) PF(CUFLT) PF(FNMS) PF(FMA) PF(FMS)
+#undef PF
+};
+
+/* x86 MXCSR exception bits, used by the precise path only for FPSCR flags (never results);
+ * sse2neon's _mm_getcsr returns just the rounding mode, so these read as "no exception". */
+#ifndef _MM_EXCEPT_INVALID
+#define _MM_EXCEPT_INVALID 0x1u
+#define _MM_EXCEPT_OVERFLOW 0x8u
+#define _MM_EXCEPT_UNDERFLOW 0x10u
+#define _MM_EXCEPT_INEXACT 0x20u
+#endif
+
+/* sse2neon's _mm_srai_epi32 macro expands its count unparenthesised (`vdupq_n_s32(-imm)`), so RPCS3's
+ * `_mm_srai_epi32(a, (0 - op.i7) & 0x3f)` (ROTMAI) negates the wrong thing on arm64. x86 semantics: */
+#undef _mm_srai_epi32
+static inline __m128i _mm_srai_epi32(__m128i a, int imm) { return (imm & ~31) ? (__m128i)vshrq_n_s32((int32x4_t)a, 31) : (__m128i)vshlq_s32((int32x4_t)a, vdupq_n_s32(-(imm & 31))); }
+
+/* x86-layout view of the host FP exception flags (what RPCS3's precise path reads from MXCSR) */
+static inline unsigned oracle_getcsr() {
+	unsigned r = 0;
+	if (std::fetestexcept(FE_INVALID)) r |= _MM_EXCEPT_INVALID;
+	if (std::fetestexcept(FE_OVERFLOW)) r |= _MM_EXCEPT_OVERFLOW;
+	if (std::fetestexcept(FE_UNDERFLOW)) r |= _MM_EXCEPT_UNDERFLOW;
+	if (std::fetestexcept(FE_INEXACT)) r |= _MM_EXCEPT_INEXACT;
+	return r;
+}
