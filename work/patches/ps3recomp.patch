+/* spu_coh_is_reserved (spu_coherency.c) as an inline: every guest store asks
+ * it twice, and as a call it was ~7% of inFAMOUS 2's main thread. Same reads,
+ * same orders: acquire on the armed flag, relaxed on the bitmap. */
+#ifndef SPU_COH_INLINE_H
+#define SPU_COH_INLINE_H
+#include <stdint.h>
+
+#define SPU_COH_LINE_SHIFT 7    /* 128-byte lines */
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+extern unsigned char g_spu_coh_bitmap[];
+extern int           g_spu_coh_armed;
+#ifdef __cplusplus
+}
+#endif
+
+static inline int spu_coh_is_reserved_inl(uint32_t addr)
+{
+    if (!__atomic_load_n(&g_spu_coh_armed, __ATOMIC_ACQUIRE)) return 0;
+    const uint32_t line = addr >> SPU_COH_LINE_SHIFT;
+    return (__atomic_load_n(&g_spu_coh_bitmap[line >> 3], __ATOMIC_RELAXED) >> (line & 7)) & 1u;
+}
+#endif
