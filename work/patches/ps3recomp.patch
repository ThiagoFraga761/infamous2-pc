+        check("unnorm_scale", hlsl, "((input.tc0).xyzw).xy * rsx_texscale[2].xy + rsx_texscale[2].zw)");
+        check("unnorm_decl", hlsl, "float4 rsx_texscale[16];");
+        ops[2] = 0;
+        rsx_fp_decompile_buffered_ex2(prog, sizeof(prog), CTRL_32BIT, 0, ops, hlsl, sizeof(hlsl), &nk);
+        check_absent("unnorm_off_no_decl", hlsl, "rsx_texscale");
+    }
