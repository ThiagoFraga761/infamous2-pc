+/* Forced into every MinGW-w64 translation unit (CMakeLists.txt): the POSIX
+ * time and scheduling calls the Linux build takes from glibc headers. MinGW's
+ * winpthreads provides clock_gettime, nanosleep and sched_yield behind
+ * <pthread.h>/<sched.h>; files written for Linux include neither. */
+#ifndef PS3RECOMP_MINGW_POSIX_H
+#define PS3RECOMP_MINGW_POSIX_H
+#ifdef __MINGW32__
+#include <time.h>
+#include <pthread.h>
+#include <sched.h>
+#ifndef TIME_UTC
+#define TIME_UTC 1
+static inline int ps3_timespec_get(struct timespec* ts, int base)
+{
+    return base == TIME_UTC && clock_gettime(CLOCK_REALTIME, ts) == 0 ? base : 0;
+}
+#define timespec_get ps3_timespec_get
+#endif
+#endif
+#endif
diff --git a/runtime/platform/ps3_hot_pin.c b/runtime/platform/ps3_hot_pin.c
new file mode 100644
index 0000000..8d6e47f
--- /dev/null
+++ b/runtime/platform/ps3_hot_pin.c
@@ -0,0 +1,169 @@
+/*
+ * ps3_hot_pin.c -- PS3_HOT_PIN=1: a physical core for each hot host thread.
+ *
+ * The frame's work runs on a handful of threads that never really sleep: the
+ * guest's main PPU thread, the RSX FIFO thread, the Vulkan recording thread
+ * and the SPURS kernel SPUs. On an 8-core/16-thread CPU the scheduler often
+ * leaves two of them on the siblings of one core while another core idles
+ * (they spin rather than sleep, so it has no reason to move them), and the
+ * job a waiting thread needs runs at SMT speed. With this on, a placement
+ * thread gives each registered hot thread one logical CPU of a core of its
+ * own, and every other thread of the process the remaining CPUs (the other
+ * siblings), re-checked once a second so threads created later are placed
+ * too. Only affinity masks change: no guest-visible state, no ordering.
+ *
+ * Off unless PS3_HOT_PIN=1, and only when the machine has SMT and at least
+ * as many physical cores as there are hot threads.
+ */
+#if defined(__linux__)
+#define _GNU_SOURCE
+#include <dirent.h>
+#include <pthread.h>
+#include <sched.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <time.h>
+#include <unistd.h>
+
+enum { HP_MAIN, HP_RSX, HP_REC, HP_SPU0, HP_NROLES = HP_SPU0 + 5 };
+static int s_hp_tid[HP_NROLES];          /* 0: not registered */
+static int s_hp_on = -1;
+static pthread_once_t s_hp_once = PTHREAD_ONCE_INIT;
+
+static int hp_cpus[64], hp_ncores;       /* one logical CPU per physical core */
+static cpu_set_t hp_other;               /* everything not handed to a hot thread */
+
+static int hp_read_int_list(const char* path, int* out, int max)
+{
+    FILE* f = fopen(path, "r");
+    if (!f) return 0;
+    char b[256];
+    int n = 0;
+    if (fgets(b, sizeof b, f)) {
+        char* p = b;
+        while (*p && n < max) {
+            int a = (int)strtol(p, &p, 10), z = a;
+            if (*p == '-') z = (int)strtol(p + 1, &p, 10);
+            for (int i = a; i <= z && n < max; i++) out[n++] = i;
+            if (*p == ',') p++; else break;
+        }
+    }
+    fclose(f);
+    return n;
+}
+
+static int hp_topology(void)
+{
+    const int ncpu = (int)sysconf(_SC_NPROCESSORS_ONLN);
+    int seen[256] = {0}, smt = 0;
+    hp_ncores = 0;
+    for (int c = 0; c < ncpu && c < 256; c++) {
+        if (seen[c]) continue;
+        char path[128];
+        int sib[8];
+        snprintf(path, sizeof path, "/sys/devices/system/cpu/cpu%d/topology/thread_siblings_list", c);
+        const int n = hp_read_int_list(path, sib, 8);
+        if (n <= 0) return 0;
+        if (n > 1) smt = 1;
+        for (int i = 0; i < n; i++) if (sib[i] < 256) seen[sib[i]] = 1;
+        if (hp_ncores < 64) hp_cpus[hp_ncores++] = c;
+    }
+    if (!smt || hp_ncores < HP_NROLES) return 0;
+    CPU_ZERO(&hp_other);
+    for (int c = 0; c < ncpu && c < CPU_SETSIZE; c++) CPU_SET(c, &hp_other);
+    for (int r = 0; r < HP_NROLES; r++) CPU_CLR(hp_cpus[r], &hp_other);
+    return 1;
+}
+
+static int hp_comm(int tid, char* out, size_t n)
+{
+    char path[64];
+    snprintf(path, sizeof path, "/proc/self/task/%d/comm", tid);
+    FILE* f = fopen(path, "r");
+    if (!f) return 0;
+    const int ok = fgets(out, (int)n, f) != NULL;
+    fclose(f);
+    if (ok) out[strcspn(out, "\n")] = 0;
+    return ok;
+}
+
+static void* hp_thread(void* arg)
+{
+    (void)arg;
+    pthread_setname_np(pthread_self(), "hot-pin");
+    /* tid -> CPU it was last given (-1: the "other" set), so a thread is
+     * touched again only when its role changes */
+    enum { MAXT = 1024 };
+    static int t_tid[MAXT], t_cpu[MAXT], nt;
+    fprintf(stderr, "[hot-pin] %d cores: hot threads on CPUs", hp_ncores);
+    for (int r = 0; r < HP_NROLES; r++) fprintf(stderr, " %d", hp_cpus[r]);
+    fprintf(stderr, ", the rest elsewhere\n");
+    for (;;) {
+        /* the RSX threads are named by their creators; find them by name */
+        DIR* d = opendir("/proc/self/task");
+        if (!d) return NULL;
+        struct dirent* e;
+        while ((e = readdir(d))) {
+            const int tid = atoi(e->d_name);
+            if (tid <= 0) continue;
+            char comm[32];
+            if (!__atomic_load_n(&s_hp_tid[HP_RSX], __ATOMIC_RELAXED) && hp_comm(tid, comm, sizeof comm) &&
+                !strcmp(comm, "rsx"))
+                __atomic_store_n(&s_hp_tid[HP_RSX], tid, __ATOMIC_RELAXED);
+            if (!__atomic_load_n(&s_hp_tid[HP_REC], __ATOMIC_RELAXED) && hp_comm(tid, comm, sizeof comm) &&
+                !strcmp(comm, "rsx-record"))
+                __atomic_store_n(&s_hp_tid[HP_REC], tid, __ATOMIC_RELAXED);
+            int want = -1;
+            for (int r = 0; r < HP_NROLES; r++)
+                if (__atomic_load_n(&s_hp_tid[r], __ATOMIC_RELAXED) == tid) want = hp_cpus[r];
+            int k = 0;
+            while (k < nt && t_tid[k] != tid) k++;
+            if (k < nt && t_cpu[k] == want) continue;
+            cpu_set_t m;
+            if (want >= 0) { CPU_ZERO(&m); CPU_SET(want, &m); }
+            else m = hp_other;
+            if (sched_setaffinity(tid, sizeof m, &m) == 0) {
+                if (k == nt && nt < MAXT) t_tid[nt++] = tid;
+                if (k < nt) t_cpu[k] = want;
+            }
+        }
+        closedir(d);
+        struct timespec ts = { 1, 0 };
+        nanosleep(&ts, NULL);
+    }
+    return NULL;
+}
+
+static void hp_start(void)
+{
+    if (!hp_topology()) {
+        fprintf(stderr, "[hot-pin] needs SMT and at least %d physical cores: off\n", HP_NROLES);
+        __atomic_store_n(&s_hp_on, 0, __ATOMIC_RELAXED);
+        return;
+    }
+    pthread_t th;
+    pthread_attr_t a;
+    pthread_attr_init(&a);
+    pthread_attr_setdetachstate(&a, PTHREAD_CREATE_DETACHED);
+    pthread_attr_setstacksize(&a, 1u << 20);
+    if (pthread_create(&th, &a, hp_thread, NULL) != 0) __atomic_store_n(&s_hp_on, 0, __ATOMIC_RELAXED);
+    pthread_attr_destroy(&a);
+}
+
+/* role: 0 the main PPU thread, 1 rsx, 2 rsx-record, 3.. SPURS SPU n-3 of the
+ * first instance. The calling thread registers itself. */
+void ps3_hot_pin_register(int role)
+{
+    if (__builtin_expect(s_hp_on < 0, 0)) {
+        const char* e = getenv("PS3_HOT_PIN");
+        __atomic_store_n(&s_hp_on, e && atoi(e) > 0 ? 1 : 0, __ATOMIC_RELAXED);
+    }
+    if (!s_hp_on || role < 0 || role >= HP_NROLES) return;
+    __atomic_store_n(&s_hp_tid[role], (int)syscall(SYS_gettid), __ATOMIC_RELAXED);
+    pthread_once(&s_hp_once, hp_start);
+}
+#else
+void ps3_hot_pin_register(int role) { (void)role; }
+#endif
