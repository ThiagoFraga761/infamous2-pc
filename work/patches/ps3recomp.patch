+        check("nrm_helper", hlsl, "float3 rsx_nrm(float3 v) { return length(v) > 0.0 ? normalize(v) : v; }");
+        check_absent("nrm_no_bare_normalize", hlsl, "float4(normalize(");
+    }
+
+    /* A predicated write is a select, not a lerp: lerp(dst, _v, 0) is NaN
+     * when _v is Inf -- the bits PKB/PK4 often produce. */
+    {
+        u8 prog[16];
+        put_word(prog + 0, OPC(0x01) | OUTMASK_ALL | INSRC(1) | END);
+        put_word(prog + 4, T_INPUT | SWZ_IDENT | (1u << 18) | (0u << 21) | (1u << 23) | (2u << 25) | (3u << 27));
+        put_word(prog + 8, 0);
+        put_word(prog + 12, 0);
+        rsx_fp_decompile(prog, sizeof(prog), CTRL_32BIT, hlsl, sizeof(hlsl));
+        check("pred_select", hlsl, "r[0].xyzw = (_p.xyzw != 0.0) ? _v.xyzw : r[0].xyzw;");
+        check_absent("pred_no_lerp", hlsl, "lerp(r[0]");
+    }
+
+    /* TC8/TC9 are VP o15/o6, now forwarded: no more zero inputs. */
+    {
+        u8 prog[16];
+        put_word(prog + 0, OPC(0x01) | OUTMASK_ALL | INSRC(0xC) | END);
+        put_word(prog + 4, T_INPUT | SWZ_IDENT | EXEC_ALWAYS);
+        put_word(prog + 8, 0);
+        put_word(prog + 12, 0);
+        rsx_fp_decompile(prog, sizeof(prog), CTRL_32BIT, hlsl, sizeof(hlsl));
+        check("tc8_input", hlsl, "input.tc8");
+        check("tc8_decl", hlsl, "float4 tc8:TEXCOORD8; float4 tc9:TEXCOORD9;");
+    }
