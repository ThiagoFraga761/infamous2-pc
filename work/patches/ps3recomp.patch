+static void lv2_spu_printf_call(ppu_context* ctx, int which)
+{
+    const uint32_t cb = s_spu_printf_cb[which];
+    if (!cb) { ctx->gpr[3] = LV2_ESTAT; return; }
+    ctx->gpr[3] = (uint32_t)ppu_guest_call(cb, (uint32_t)ctx->gpr[3], 0, 0, 0, 0, 0, 0, 0);
