+            put_word(prog + 0, OPC(0x17) | OUTMASK_ALL | OUTREG(1) | INSRC(4) | TEXU(0) | (1u << 21));
+            rsx_fp_decompile_buffered_ex2(prog, sizeof(prog), CTRL_32BIT, 0, ops,
+                                          hlsl, sizeof(hlsl), &nk);
+            check("texop_bx2", hlsl,
+                  "rsx_texop(rsx_tex[0].Sample(rsx_samp[0], ((input.tc0).xyzw).xy), float4(0, 0, 0, 0), "
+                  "float4(0, 0, 0, 0), float4(1, 1, 1, 1), 1, 0)");
+            /* ...and on a unit whose format has no biased renormalisation
