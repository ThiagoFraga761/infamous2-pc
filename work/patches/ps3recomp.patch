+/*
+ * ps3recomp - what each thread spent between two presents (PS3RECOMP_VK_HITCH)
+ *
+ * Counters any thread adds time to; the present that closes a gap longer
+ * than PS3RECOMP_VK_HITCH ms prints them with the [vk hitch] line, so a slow
+ * frame can be put down to a class of work: the RSX walker waiting on an SPU
+ * label or on the PPU, the engine thread waiting for the recording thread,
+ * texture and target creation, the main PPU thread's polls, file reads.
+ * A thread that registers (rsx_hs_thread) also gets its CPU time in the gap.
+ *
+ * Header-only, with weak definitions, so that the runtime and the video
+ * library can both add to it without either owning it. With the variable
+ * unset every hook is one load and a branch.
+ */
+#ifndef RSX_HITCH_H
+#define RSX_HITCH_H
+
+#include <stdint.h>
+#include <stdlib.h>
+#include <time.h>
+#if defined(__linux__)
+#include <pthread.h>
+#endif
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum {
+    HS_RSX_SEMA, HS_RSX_PARK, HS_RSX_BEHIND, HS_RSX_IDLE, HS_RSX_DRAIN, HS_RSX_PRESENT,
+    HS_BQ_SYNC, HS_BQ_PRESENTQ, HS_BQ_ROOM,
+    HS_TEX_CREATE, HS_TEX_UPLOAD, HS_SURF_CREATE, HS_SNAP, HS_READBACK, HS_SLOT_WAIT,
+    HS_PPU_USLEEP, HS_PPU_REFPOLL, HS_FS_READ,
+    HS_ENG_TEXUP, HS_ENG_HASH, HS_ENG_TEXMISS, HS_DRAWS, HS_VK_ALLOC, HS_VK_FREE,
+    HS_N
+};
+#define RSX_HS_NAMES { "rsx_sema", "rsx_park", "rsx_behind", "rsx_idle", "rsx_drain", "rsx_present", \
+                       "bq_sync", "bq_presentq", "bq_room", \
+                       "tex_create", "tex_upload", "surf_create", "snap", "readback", "slot_wait", \
+                       "ppu_usleep", "ppu_refpoll", "fs_read", \
+                       "eng_texup", "eng_hash", "eng_texmiss", "draws", "vk_alloc", "vk_free" }
+
+#define RSX_HS_THREADS 16
+typedef struct {
+    int on;                              /* -1 unknown, 0 off, 1 on */
+    uint64_t ns[HS_N], n[HS_N];
+    uint64_t bytes[HS_N];
+    const char* sync_top;                /* the longest bq sync in the gap */
+    uint64_t sync_top_ns;
+    unsigned nthreads;
+#if defined(__linux__)
+    clockid_t clk[RSX_HS_THREADS];
+#endif
+    const char* tag[RSX_HS_THREADS];
+} rsx_hs_state;
+__attribute__((weak)) rsx_hs_state g_rsx_hs = { .on = -1 };
+
+static inline int rsx_hs_on(void)
+{
+    int on = __atomic_load_n(&g_rsx_hs.on, __ATOMIC_RELAXED);
+    if (__builtin_expect(on < 0, 0)) {
+        const char* e = getenv("PS3RECOMP_VK_HITCH");
+        on = e && *e && !(e[0] == '-' ) ? 1 : 0;
+        __atomic_store_n(&g_rsx_hs.on, on, __ATOMIC_RELAXED);
+    }
+    return on;
+}
+
+static inline uint64_t rsx_hs_now(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
+}
+
+static inline void rsx_hs_add(int k, uint64_t ns)
+{
+    __atomic_add_fetch(&g_rsx_hs.ns[k], ns, __ATOMIC_RELAXED);
+    __atomic_add_fetch(&g_rsx_hs.n[k], 1, __ATOMIC_RELAXED);
+}
+static inline void rsx_hs_bytes(int k, uint64_t b)
+{
+    __atomic_add_fetch(&g_rsx_hs.bytes[k], b, __ATOMIC_RELAXED);
+}
+
+/* t0 = RSX_HS_T0(); ...; RSX_HS_END(HS_x, t0); */
+#define RSX_HS_T0() (rsx_hs_on() ? rsx_hs_now() : 0ull)
+#define RSX_HS_END(k, t0) do { if (t0) rsx_hs_add((k), rsx_hs_now() - (t0)); } while (0)
+
+/* RSX_HS_SCOPE(HS_x); at the top of a block: its time, however it is left. */
+typedef struct { int k; uint64_t t0; } rsx_hs_scope_t;
+static inline void rsx_hs_scope_end(rsx_hs_scope_t* s) { if (s->t0) rsx_hs_add(s->k, rsx_hs_now() - s->t0); }
+#define RSX_HS_SCOPE_IF(k, cond) \
+    rsx_hs_scope_t rsx_hs_scope_ __attribute__((cleanup(rsx_hs_scope_end), unused)) = \
+        { (k), (cond) ? RSX_HS_T0() : 0ull }
+#define RSX_HS_SCOPE(k) RSX_HS_SCOPE_IF(k, 1)
+
+/* The calling thread's CPU time goes in the hitch line under `tag` (threads
+ * with the same tag are summed). Once per thread. */
+static inline void rsx_hs_thread(const char* tag)
+{
+#if defined(__linux__)
+    if (!rsx_hs_on()) return;
+    const unsigned i = __atomic_fetch_add(&g_rsx_hs.nthreads, 1u, __ATOMIC_RELAXED);
+    if (i >= RSX_HS_THREADS) return;
+    clockid_t c;
+    if (pthread_getcpuclockid(pthread_self(), &c)) return;
+    g_rsx_hs.clk[i] = c;
+    __atomic_store_n(&g_rsx_hs.tag[i], tag, __ATOMIC_RELEASE);
+#else
+    (void)tag;
+#endif
+}
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
