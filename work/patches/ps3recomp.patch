+        ti_put32(ls + 0x27C4, TASK_INTERP_SYSCALL_LS);
+        ti_put32(ls + TASK_INTERP_SYSCALL_LS, TASK_INTERP_STOP_SC);
+        ti_put32(ls + TASK_INTERP_RETURN_LS, TASK_INTERP_STOP_RET);
