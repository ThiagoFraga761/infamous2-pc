+    if (s_vk_fps_limit < 0) { const char* e = getenv("PS3RECOMP_FPS_LIMIT"); s_vk_fps_limit = e ? atoi(e) : 0; }
+    if (s_vk_fps_limit <= 0) return;
+    static u64 next;
+    const u64 period = 1000000000ull / (u64)s_vk_fps_limit;
+    u64 now = vk_now_ns();
+    if (next > now && next - now < 4 * period) {
+        const u64 d = next - now;
+        struct timespec ts = { (time_t)(d / 1000000000ull), (long)(d % 1000000000ull) };
+        nanosleep(&ts, NULL);
+        now = next;
+    }
+    next = (next > now && next - now < 4 * period) ? next + period : now + period;
+}
+
 void rsx_vulkan_backend_present(void)
 {
+    vk_fps_limit_wait();
+#ifdef PS3RECOMP_UI
+    if (s_vk.ui) rsx_ui_frame();          /* the window's thread: SDL and ImGui stay here */
+#endif
