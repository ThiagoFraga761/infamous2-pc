+        rsx_fp_decompile(prog, sizeof(prog), CTRL_16BIT | 0x0Eu, hlsl, sizeof(hlsl));
+        check("depth_export_half_colour", hlsl, "    float _d = r[1].z;\n");
+        check("depth_export_half_t0", hlsl, "float4 _o0 = h[0];");
+        /* r1 never written: the export is still made, of r1's initial 0. */
+        put_word(prog + 0, OPC(0x01) | OUTMASK_ALL | OUTREG(10) | INSRC(1));  /* MOV r10 instead */
+        rsx_fp_decompile(prog, sizeof(prog), CTRL_32BIT | 0x0Eu, hlsl, sizeof(hlsl));
+        check("depth_export_without_r1", hlsl, "    float _d = r[1].z;\n");
+        /* ...and the buffered path's alpha test still finds the colour. */
+        {
+            u32 nk = 0;
+            int bn = rsx_fp_decompile_buffered_ex(prog, sizeof(prog), CTRL_32BIT | 0x0Eu, 0,
+                                                  hlsl, sizeof(hlsl), &nk);
+            int ar = bn > 0 ? rsx_fp_apply_alpha_test_buffered(hlsl, sizeof(hlsl), 0x204u) : -1;
+            check_true("depth_export_alpha_test_applies", ar >= 0);
