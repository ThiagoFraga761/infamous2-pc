+        { RSX_SPIRV_TEXTURE_BINDING + 0u, VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, 1, VK_SHADER_STAGE_FRAGMENT_BIT, NULL },
+        { RSX_SPIRV_TEXTURE_BINDING + 1u, VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, 1, VK_SHADER_STAGE_FRAGMENT_BIT, NULL },
+    };
+    VkDescriptorSetLayoutCreateInfo lci = { .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO,
+                                            .bindingCount = 2, .pBindings = b };
+    if (pvkCreateDescriptorSetLayout(s_vk.device, &lci, NULL, &s_zc.set_layout) != VK_SUCCESS) return -1;
+    VkPipelineLayoutCreateInfo plci = { .sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO,
+                                        .setLayoutCount = 1, .pSetLayouts = &s_zc.set_layout };
+    if (pvkCreatePipelineLayout(s_vk.device, &plci, NULL, &s_zc.pipe_layout) != VK_SUCCESS) return -1;
+    VkDescriptorPoolSize ps = { VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, 2u * VK_ZC_SETS };
+    VkDescriptorPoolCreateInfo pci = { .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO,
+                                       .maxSets = VK_ZC_SETS, .poolSizeCount = 1, .pPoolSizes = &ps };
+    if (pvkCreateDescriptorPool(s_vk.device, &pci, NULL, &s_zc.pool) != VK_SUCCESS ||
+        pvkCreateDescriptorPool(s_vk.device, &pci, NULL, &s_park.zc) != VK_SUCCESS) return -1;
+
+    VkAttachmentDescription att = {
+        .format = VK_FORMAT_R8G8B8A8_UNORM, .samples = VK_SAMPLE_COUNT_1_BIT,
+        .loadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE, .storeOp = VK_ATTACHMENT_STORE_OP_STORE,
+        .stencilLoadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE, .stencilStoreOp = VK_ATTACHMENT_STORE_OP_DONT_CARE,
+        .initialLayout = VK_IMAGE_LAYOUT_GENERAL, .finalLayout = VK_IMAGE_LAYOUT_GENERAL };
+    VkAttachmentReference cref = { 0, VK_IMAGE_LAYOUT_GENERAL };
+    VkSubpassDescription sub = { .pipelineBindPoint = VK_PIPELINE_BIND_POINT_GRAPHICS,
+                                 .colorAttachmentCount = 1, .pColorAttachments = &cref };
+    VkRenderPassCreateInfo rci = { .sType = VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO,
+                                   .attachmentCount = 1, .pAttachments = &att,
+                                   .subpassCount = 1, .pSubpasses = &sub };
+    if (pvkCreateRenderPass(s_vk.device, &rci, NULL, &s_zc.rp) != VK_SUCCESS) return -1;
+
+    VkPipelineShaderStageCreateInfo st[2] = {
+        { .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, .stage = VK_SHADER_STAGE_VERTEX_BIT,
+          .module = s_zc.vs, .pName = "main" },
+        { .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, .stage = VK_SHADER_STAGE_FRAGMENT_BIT,
+          .module = s_zc.fs, .pName = "main" },
+    };
+    VkPipelineVertexInputStateCreateInfo vi = { .sType = VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO };
+    VkPipelineInputAssemblyStateCreateInfo ia = { .sType = VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO,
+                                                  .topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST };
+    VkPipelineViewportStateCreateInfo vps = { .sType = VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO,
+                                              .viewportCount = 1, .scissorCount = 1 };
+    VkPipelineRasterizationStateCreateInfo ras = { .sType = VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO,
+                                                   .polygonMode = VK_POLYGON_MODE_FILL, .cullMode = VK_CULL_MODE_NONE,
+                                                   .frontFace = VK_FRONT_FACE_COUNTER_CLOCKWISE, .lineWidth = 1.0f };
+    VkPipelineMultisampleStateCreateInfo ms = { .sType = VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO,
+                                                .rasterizationSamples = VK_SAMPLE_COUNT_1_BIT };
+    VkPipelineColorBlendAttachmentState cba = { .colorWriteMask = 0xFu };
+    VkPipelineColorBlendStateCreateInfo cb = { .sType = VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO,
+                                               .attachmentCount = 1, .pAttachments = &cba };
+    VkDynamicState dyn[2] = { VK_DYNAMIC_STATE_VIEWPORT, VK_DYNAMIC_STATE_SCISSOR };
+    VkPipelineDynamicStateCreateInfo dy = { .sType = VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO,
+                                            .dynamicStateCount = 2, .pDynamicStates = dyn };
+    VkGraphicsPipelineCreateInfo gci = {
+        .sType = VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO, .stageCount = 2, .pStages = st,
+        .pVertexInputState = &vi, .pInputAssemblyState = &ia, .pViewportState = &vps,
+        .pRasterizationState = &ras, .pMultisampleState = &ms, .pColorBlendState = &cb,
+        .pDynamicState = &dy, .layout = s_zc.pipe_layout, .renderPass = s_zc.rp, .subpass = 0 };
+    if (pvkCreateGraphicsPipelines(s_vk.device, s_pcache, 1, &gci, NULL, &s_zc.pipe) != VK_SUCCESS)
+        return -1;
+    if (vk_create_image(&s_zc.zero_stencil, VK_FORMAT_R8_UINT, 1, 1,
+                        VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT,
+                        VK_IMAGE_ASPECT_COLOR_BIT)) return -1;
+    if (vk_op_begin()) return -1;
+    vk_barrier_image(s_zc.zero_stencil.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_UNDEFINED);
+    VkClearColorValue zero = { .uint32 = { 0, 0, 0, 0 } };
+    VkImageSubresourceRange r = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 };
+    pvkCmdClearColorImage(s_vk.cmd, s_zc.zero_stencil.img, VK_IMAGE_LAYOUT_GENERAL, &zero, 1, &r);
+    vk_op_end();
+    s_zc.ok = 1;
+    return 0;
+}
+
+static void vk_zc_shutdown(void)
+{
+    if (s_zc.pipe) pvkDestroyPipeline(s_vk.device, s_zc.pipe, NULL);
+    if (s_zc.rp) pvkDestroyRenderPass(s_vk.device, s_zc.rp, NULL);
+    if (s_zc.pool) pvkDestroyDescriptorPool(s_vk.device, s_zc.pool, NULL);
+    if (s_park.zc) pvkDestroyDescriptorPool(s_vk.device, s_park.zc, NULL);
+    s_park.zc = VK_NULL_HANDLE; s_park.zcn = 0;
+    if (s_zc.pipe_layout) pvkDestroyPipelineLayout(s_vk.device, s_zc.pipe_layout, NULL);
+    if (s_zc.set_layout) pvkDestroyDescriptorSetLayout(s_vk.device, s_zc.set_layout, NULL);
+    if (s_zc.vs) pvkDestroyShaderModule(s_vk.device, s_zc.vs, NULL);
+    if (s_zc.fs) pvkDestroyShaderModule(s_vk.device, s_zc.fs, NULL);
+    vk_destroy_image(&s_zc.zero_stencil);
+    memset(&s_zc, 0, sizeof s_zc);
+}
+
+/* The stencil aspect of a depth target as an R8_UINT texture (one per
+ * target, refilled), or 0 when the format has none. */
+static u32 vk_eng_stencil_snapshot(void* user, u32 depth, u32 w, u32 h)
+{
+    vk_eng_obj* z = vk_eng_get(depth, VK_ENG_DEPTH);
+    if (!z || !(s_vk.depth_aspect & VK_IMAGE_ASPECT_STENCIL_BIT)) return 0;
+    u32 snap = z->snap_stencil;
+    vk_eng_obj* t = vk_eng_get(snap, VK_ENG_TEXTURE);
+    if (!t || t->w != w || t->h != h) {
+        if (t) vk_eng_release(user, snap);
+        z = vk_eng_get(depth, VK_ENG_DEPTH);
+        z->snap_stencil = 0;
+        snap = vk_eng_alloc();
+        if (!snap) return 0;
+        t = &s_eobj[snap];
+        if (vk_create_image(&t->im, VK_FORMAT_R8_UINT, w, h,
+                            VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT,
+                            VK_IMAGE_ASPECT_COLOR_BIT)) {
+            vk_destroy_image(&t->im); memset(t, 0, sizeof *t); return 0;
+        }
+        t->kind = VK_ENG_TEXTURE; t->fmt = VK_FORMAT_R8_UINT; t->bpp = 1; t->w = w; t->h = h;
+        z = vk_eng_get(depth, VK_ENG_DEPTH);
+        z->snap_stencil = snap;
+        if (vk_op_begin()) return 0;
+        vk_barrier_image(t->im.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_UNDEFINED);
+        vk_op_end();
+    }
+    const VkBuffer stb = vk_dev_scratch((VkDeviceSize)w * h);
+    if (!stb) return 0;
+    z = vk_eng_get(depth, VK_ENG_DEPTH);          /* growing it may have flushed */
+    t = vk_eng_get(snap, VK_ENG_TEXTURE);
+    if (!z || !t) return 0;
+    vk_buffer st = { .buf = stb };
+    int rc = vk_op_begin();
+    if (!rc) {
+        vk_dev_scratch_hazard(s_vk.cmd);
+        vk_barrier_image(z->im.img, s_vk.depth_aspect, VK_IMAGE_LAYOUT_GENERAL);
+        vk_barrier_image(t->im.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_GENERAL);
+        VkBufferImageCopy out = { .imageSubresource = { VK_IMAGE_ASPECT_STENCIL_BIT, 0, 0, 1 },
+                                  .imageExtent = { w, h, 1 } };
+        pvkCmdCopyImageToBuffer(s_vk.cmd, z->im.img, VK_IMAGE_LAYOUT_GENERAL, st.buf, 1, &out);
+        VkBufferMemoryBarrier bb = {
+            .sType = VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER,
+            .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT, .dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT,
+            .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED, .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+            .buffer = st.buf, .offset = 0, .size = VK_WHOLE_SIZE };
+        pvkCmdPipelineBarrier(s_vk.cmd, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                              0, 0, NULL, 1, &bb, 0, NULL);
+        VkBufferImageCopy in = { .imageSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+                                 .imageExtent = { w, h, 1 } };
+        pvkCmdCopyBufferToImage(s_vk.cmd, st.buf, t->im.img, VK_IMAGE_LAYOUT_GENERAL, 1, &in);
+        rc = vk_op_end();
+    }
+    return rc ? 0 : snap;
+}
+
+static u32 vk_eng_depth_snapshot_rgba8(void* user, u32 depth, u32 w, u32 h)
+{
+    VK_CS(CS_DEPTH_SNAPSHOT_RGBA8);
+    RSX_HS_SCOPE(HS_SNAP);
+    vk_eng_obj* z = vk_eng_get(depth, VK_ENG_DEPTH);
+    if (!z || !vk_depth_is_f32(s_vk.depth_format) || vk_zc_init()) return 0;
+    if (w > z->w) w = z->w;
+    if (h > z->h) h = z->h;
+    if (!w || !h) return 0;
+
+    /* The output first: creating it may release an older one. */
+    u32 snap = z->snap_rgba;
+    vk_eng_obj* o = vk_eng_get(snap, VK_ENG_TEXTURE);
+    if (!o || o->w != w || o->h != h || !o->fb) {
+        if (o) vk_eng_release(user, snap);
+        z = vk_eng_get(depth, VK_ENG_DEPTH);
+        z->snap_rgba = 0;
+        snap = vk_eng_alloc();
+        if (!snap) return 0;
+        o = &s_eobj[snap];
+        /* TRANSFER_SRC: native_latch copies it. */
+        if (vk_create_image(&o->im, VK_FORMAT_R8G8B8A8_UNORM, w, h,
+                            VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT |
+                            VK_IMAGE_USAGE_TRANSFER_SRC_BIT,
+                            VK_IMAGE_ASPECT_COLOR_BIT)) {
+            vk_destroy_image(&o->im); memset(o, 0, sizeof *o); return 0;
+        }
+        o->kind = VK_ENG_TEXTURE; o->fmt = VK_FORMAT_R8G8B8A8_UNORM; o->bpp = 4; o->w = w; o->h = h;
+        o->readable = 1;
+        VkFramebufferCreateInfo fci = { .sType = VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO,
+                                        .renderPass = s_zc.rp, .attachmentCount = 1,
+                                        .pAttachments = &o->im.view, .width = w, .height = h, .layers = 1 };
+        if (pvkCreateFramebuffer(s_vk.device, &fci, NULL, &o->fb) != VK_SUCCESS) {
+            vk_destroy_image(&o->im); memset(o, 0, sizeof *o); return 0;
+        }
+        /* Into GENERAL now, or not kept: a later call would find it the
+         * right size and use it in a layout it never got. */
+        if (vk_op_begin()) { vk_eng_release(user, snap); return 0; }
+        vk_barrier_image(o->im.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_UNDEFINED);
+        vk_op_end();
+        z = vk_eng_get(depth, VK_ENG_DEPTH);
+        z->snap_rgba = snap;
+    }
+
+    const u32 zs = vk_eng_depth_snapshot(user, depth, w, h);
+    vk_eng_obj* zt = vk_eng_get(zs, VK_ENG_TEXTURE);
+    if (!zt) return 0;
+    const u32 ss = vk_eng_stencil_snapshot(user, depth, w, h);
+    vk_eng_obj* sto = vk_eng_get(ss, VK_ENG_TEXTURE);
+    const VkImageView sview = sto ? sto->im.view : s_zc.zero_stencil.view;
+
+    if (s_zc.sets >= VK_ZC_SETS) vk_flush();
+    VkDescriptorSet set = VK_NULL_HANDLE;
+    VkDescriptorSetAllocateInfo dai = { .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO,
+                                        .descriptorPool = s_zc.pool, .descriptorSetCount = 1,
+                                        .pSetLayouts = &s_zc.set_layout };
+    if (pvkAllocateDescriptorSets(s_vk.device, &dai, &set) != VK_SUCCESS) return 0;
+    s_zc.sets++;
+    VkDescriptorImageInfo ii[2] = {
+        { VK_NULL_HANDLE, zt->im.view, VK_IMAGE_LAYOUT_GENERAL },
+        { VK_NULL_HANDLE, sview, VK_IMAGE_LAYOUT_GENERAL },
+    };
+    VkWriteDescriptorSet wr[2] = {
+        { .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, .dstSet = set,
+          .dstBinding = RSX_SPIRV_TEXTURE_BINDING + 0u, .descriptorCount = 1,
+          .descriptorType = VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, .pImageInfo = &ii[0] },
+        { .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, .dstSet = set,
+          .dstBinding = RSX_SPIRV_TEXTURE_BINDING + 1u, .descriptorCount = 1,
+          .descriptorType = VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, .pImageInfo = &ii[1] },
+    };
+    pvkUpdateDescriptorSets(s_vk.device, 2, wr, 0, NULL);
+
+    if (vk_op_begin()) return 0;
+    vk_global_barrier();
+    VkRenderPassBeginInfo rbi = { .sType = VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO,
+                                  .renderPass = s_zc.rp, .framebuffer = o->fb,
+                                  .renderArea = { { 0, 0 }, { w, h } } };
+    pvkCmdBeginRenderPass(s_vk.cmd, &rbi, VK_SUBPASS_CONTENTS_INLINE);
+    pvkCmdBindPipeline(s_vk.cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, s_zc.pipe);
+    VkViewport vp = { 0.0f, 0.0f, (float)w, (float)h, 0.0f, 1.0f };
+    VkRect2D sc = { { 0, 0 }, { w, h } };
+    pvkCmdSetViewport(s_vk.cmd, 0, 1, &vp);
+    pvkCmdSetScissor(s_vk.cmd, 0, 1, &sc);
+    pvkCmdBindDescriptorSets(s_vk.cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, s_zc.pipe_layout,
+                             0, 1, &set, 0, NULL);
+    pvkCmdDraw(s_vk.cmd, 3, 1, 0, 0);
+    pvkCmdEndRenderPass(s_vk.cmd);
+    return vk_op_end() ? 0 : snap;
+}
+
+/* ---- native ambient occlusion (rsx_draw_backend.native_ssao) -------------
+ * inFAMOUS 2's SSAO job on the GPU, from the two G-buffer images it copies to
+ * main memory: linear depth at half size, 12 occlusion samples a pixel, a
+ * depth-aware 5-tap blur each way, a depth-aware upsample to the 8-bit image
+ * the game samples. The job's parameters of the frame come in as push
+ * constants; its sample tables are fixed (the engine checks them). Distances
+ * the job has in pixels of a 640 wide image scale with the image. Five
+ * fullscreen passes into engine textures, so the engine samples them through
+ * surface_view like any other. */
+#define VK_AO_SETS 64u
+enum { VK_AO_Z, VK_AO_RAW, VK_AO_H, VK_AO_V, VK_AO_FULL, VK_AO_N };
+
+static struct {
+    int                   tried, ok;
+    VkDescriptorSetLayout set_layout;
+    VkPipelineLayout      pipe_layout;
+    VkDescriptorPool      pool;
+    u32                   sets;
+    VkRenderPass          rp_f32, rp_r8;
+    VkShaderModule        vs, fs[VK_AO_N];
+    VkPipeline            pipe[VK_AO_N];
+    u32                   img[VK_AO_N];      /* engine TEXTURE handles */
+    u32                   w, h;              /* of the depth image     */
+} s_ao;
+
+/* rsx_draw_backend.native_ssao's `params`. lin_z: depth packed into A,R,G
+ * of a colour texel as linear depth, 1/z = k * (d0 - d24). The 8-bit stages
+ * store whole levels as level / 255, which UNORM conversion keeps exact (a
+ * half level would be a rounding tie), and read them back rounded. */
+#define VK_AO_COMMON                                                            \
+    "[[vk::push_constant]] cbuffer AoConst {\n"                                 \
+    "    float4 m0, m1, m2;\n"                                                  \
+    "    float4 proj;\n"     /* scale across, down; radius; unoccluded total */ \
+    "    float4 fall;\n"     /* falloff factors; depth clamp near, far       */ \
+    "    float4 post;\n"     /* output scale, bias; blur, upsample weights   */ \
+    "    float4 zlin;\n"     /* k, fraction of d0, d0's integer part (bits)  */ \
+    "};\n"                                                                      \
+    "float lin_z(float4 t) {\n"                                                 \
+    "    int3 b = int3(t.arg * 255.0 + 0.5);\n"                                 \
+    "    int d = (b.x << 16) | (b.y << 8) | b.z;\n"                             \
+    "    return 1.0 / (zlin.x * (float(asint(zlin.z) - d) + zlin.y));\n"       \
+    "}\n"
+
+static const char kAoDownFS[] =
+    VK_AO_COMMON
+    "Texture2D<float4> dt : register(t0);\n"
+    "float4 main(float4 pos : SV_Position) : SV_Target {\n"
+    "    return lin_z(dt.Load(int3(int2(pos.xy) * 2, 0))).xxxx;\n"
+    "}\n";
+
+/* A sample is an offset in the image plane and the height of the sample
+ * sphere there; the sphere keeps its size on screen nearer than the depth
+ * clamp's near end and beyond its far end. */
+static const char kAoOccFS[] =
+    VK_AO_COMMON
+    "Texture2D<float>  zh : register(t0);\n"
+    "Texture2D<float4> nt : register(t1);\n"
+    "static const float SX[12] = { 0.0, 0.360393, 0.767721, 0.0606153, -0.347511, -0.37089,\n"
+    "    0.381673, -0.488981, -0.779765, -0.339852, 0.021904, 0.393308 };\n"
+    "static const float SY[12] = { 0.0, -0.221962, -0.0020895, -0.561965, 0.688986, 0.221229,\n"
+    "    0.682595, -0.294946, 0.0797645, -0.691509, 0.448074, 0.250064 };\n"
+    "static const float SH[12] = { 1.0, 0.906008, 0.640781, 0.824937, 0.63603, 0.901942,\n"
+    "    0.623209, 0.820917, 0.620971, 0.637428, 0.893728, 0.884747 };\n"
+    "float4 main(float4 pos : SV_Position) : SV_Target {\n"
+    "    int2 p = int2(pos.xy);\n"
+    "    uint w, h; zh.GetDimensions(w, h);\n"
+    "    int2 last = int2(w, h) - 1;\n"
+    "    float scale = float(w) / 640.0;\n"
+    "    float z = zh.Load(int3(p, 0));\n"
+    "    float3 n = floor(nt.Load(int3(p * 2, 0)).rgb * 255.0 + 0.5) * (2.007843137 / 256.0) - 1.0;\n"
+    "    float c0 = dot(n, m0.xyz), c1 = dot(n, m1.xyz), c2 = dot(n, m2.xyz);\n"
+    "    float zcl = clamp(z, fall.z, fall.w);\n"
+    "    float s = z / zcl;\n"
+    "    float zref = z + s * c2;\n"
+    "    float total = 0.0;\n"
+    "    [unroll] for (int i = 0; i < 12; ++i) {\n"
+    "        float2 o = float2(proj.x * SX[i] + c0, proj.y * SY[i] + c1) / zcl * scale;\n"
+    "        int2 q = clamp(int2(floor(float2(p) + 0.5 + o)), int2(0, 0), last);\n"
+    "        float hs = SH[i] * proj.z * s;\n"
+    "        float d = 0.5 * (zh.Load(int3(q, 0)) - zref + hs);\n"
+    "        total += clamp(d, 0.0, hs) + hs * saturate(d * fall.x / s + fall.y * s);\n"
+    "    }\n"
+    "    float vis = total / (proj.w * s);\n"
+    "    return (floor(saturate(post.x * vis + post.y) * 255.0) / 255.0).xxxx;\n"
+    "}\n";
+
+/* Binomial weights, cut where the depth differs; taps one pixel apart at 640
+ * wide. AO_DIR is prepended. */
+static const char kAoBlurFS[] =
+    VK_AO_COMMON
+    "Texture2D<float> ao : register(t0);\n"
+    "Texture2D<float> zh : register(t1);\n"
+    "float4 main(float4 pos : SV_Position) : SV_Target {\n"
+    "    const float G[5] = { 1.0, 6.0, 10.0, 6.0, 1.0 };\n"
+    "    int2 p = int2(pos.xy);\n"
+    "    uint w, h; ao.GetDimensions(w, h);\n"
+    "    int2 last = int2(w, h) - 1;\n"
+    "    float scale = float(w) / 640.0;\n"
+    "    float zc = zh.Load(int3(p, 0));\n"
+    "    float num = 0.0, den = 0.0;\n"
+    "    [unroll] for (int t = -2; t <= 2; ++t) {\n"
+    "        int2 q = p + int(round(float(t) * scale)) * AO_DIR;\n"
+    "        if (any(q < 0) || any(q > last)) continue;\n"
+    "        float a = floor(ao.Load(int3(q, 0)) * 255.0 + 0.5);\n"
+    "        float wt = G[t + 2] * saturate(1.0 - post.z * abs(zh.Load(int3(q, 0)) - zc) / zc);\n"
+    "        num += wt * a;\n"
+    "        den += wt;\n"
+    "    }\n"
+    "    return (floor(num / den) / 255.0).xxxx;\n"
+    "}\n";
+
+/* Bilinear weights cut where the depth differs; the nearest texel when no
+ * weight is left. */
+static const char kAoUpFS[] =
+    VK_AO_COMMON
+    "Texture2D<float>  ao : register(t0);\n"
+    "Texture2D<float>  zh : register(t1);\n"
+    "Texture2D<float4> dt : register(t2);\n"
+    "float4 main(float4 pos : SV_Position) : SV_Target {\n"
+    "    int2 p = int2(pos.xy);\n"
+    "    float zf = lin_z(dt.Load(int3(p, 0)));\n"
+    "    uint w, h; ao.GetDimensions(w, h);\n"
+    "    int2 last = int2(w, h) - 1;\n"
+    "    float2 uv = (float2(p) - 0.5) * 0.5;\n"
+    "    int2 b = int2(floor(uv));\n"
+    "    float2 f = uv - float2(b);\n"
+    "    float num = 0.0, den = 0.0, best = 0.0, bestw = -1.0;\n"
+    "    [unroll] for (int i = 0; i < 4; ++i) {\n"
+    "        int2 o = int2(i & 1, i >> 1);\n"
+    "        float wb = (o.x == 1 ? f.x : 1.0 - f.x) * (o.y == 1 ? f.y : 1.0 - f.y);\n"
+    "        int2 q = clamp(b + o, int2(0, 0), last);\n"
+    "        float a = floor(ao.Load(int3(q, 0)) * 255.0 + 0.5);\n"
+    "        float wt = wb * saturate(1.0 - post.w * abs(zh.Load(int3(q, 0)) - zf) / zf);\n"
+    "        num += wt * a;\n"
+    "        den += wt;\n"
+    "        if (wb > bestw) { bestw = wb; best = a; }\n"
+    "    }\n"
+    "    float v = den > 1e-9 ? num / den : best;\n"
+    "    return (floor(v) / 255.0).xxxx;\n"
+    "}\n";
+
+static int vk_ao_module(const char* what, const char* src, int stage, VkShaderModule* out)
+{
+    static u32 spv[16384];
+    u32 n = 0;
+    char log[512];
+    if (rsx_hlsl_to_spirv(src, stage, spv, 16384, &n, log, sizeof log)) {
+        VK_LOG("engine: native %s shader: %s\n", what, log);
+        return -1;
+    }
+    VkShaderModuleCreateInfo smi = { .sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO,
+                                     .codeSize = n * 4u, .pCode = spv };
+    return pvkCreateShaderModule(s_vk.device, &smi, NULL, out) == VK_SUCCESS ? 0 : -1;
+}
+
+static int vk_ao_render_pass(VkFormat fmt, VkRenderPass* out)
+{
+    VkAttachmentDescription att = {
+        .format = fmt, .samples = VK_SAMPLE_COUNT_1_BIT,
+        .loadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE, .storeOp = VK_ATTACHMENT_STORE_OP_STORE,
+        .stencilLoadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE, .stencilStoreOp = VK_ATTACHMENT_STORE_OP_DONT_CARE,
+        .initialLayout = VK_IMAGE_LAYOUT_GENERAL, .finalLayout = VK_IMAGE_LAYOUT_GENERAL };
+    VkAttachmentReference cref = { 0, VK_IMAGE_LAYOUT_GENERAL };
+    VkSubpassDescription sub = { .pipelineBindPoint = VK_PIPELINE_BIND_POINT_GRAPHICS,
+                                 .colorAttachmentCount = 1, .pColorAttachments = &cref };
+    VkRenderPassCreateInfo rci = { .sType = VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO,
+                                   .attachmentCount = 1, .pAttachments = &att,
+                                   .subpassCount = 1, .pSubpasses = &sub };
+    return pvkCreateRenderPass(s_vk.device, &rci, NULL, out) == VK_SUCCESS ? 0 : -1;
+}
+
+static int vk_ao_pipeline(VkShaderModule fs, VkRenderPass rp, VkPipeline* out)
+{
+    VkPipelineShaderStageCreateInfo st[2] = {
+        { .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, .stage = VK_SHADER_STAGE_VERTEX_BIT,
+          .module = s_ao.vs, .pName = "main" },
+        { .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, .stage = VK_SHADER_STAGE_FRAGMENT_BIT,
+          .module = fs, .pName = "main" },
+    };
+    VkPipelineVertexInputStateCreateInfo vi = { .sType = VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO };
+    VkPipelineInputAssemblyStateCreateInfo ia = { .sType = VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO,
+                                                  .topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST };
+    VkPipelineViewportStateCreateInfo vps = { .sType = VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO,
+                                              .viewportCount = 1, .scissorCount = 1 };
+    VkPipelineRasterizationStateCreateInfo ras = { .sType = VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO,
+                                                   .polygonMode = VK_POLYGON_MODE_FILL, .cullMode = VK_CULL_MODE_NONE,
+                                                   .frontFace = VK_FRONT_FACE_COUNTER_CLOCKWISE, .lineWidth = 1.0f };
+    VkPipelineMultisampleStateCreateInfo ms = { .sType = VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO,
+                                                .rasterizationSamples = VK_SAMPLE_COUNT_1_BIT };
+    VkPipelineColorBlendAttachmentState cba = { .colorWriteMask = 0xFu };
+    VkPipelineColorBlendStateCreateInfo cb = { .sType = VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO,
+                                               .attachmentCount = 1, .pAttachments = &cba };
+    VkDynamicState dyn[2] = { VK_DYNAMIC_STATE_VIEWPORT, VK_DYNAMIC_STATE_SCISSOR };
+    VkPipelineDynamicStateCreateInfo dy = { .sType = VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO,
+                                            .dynamicStateCount = 2, .pDynamicStates = dyn };
+    VkGraphicsPipelineCreateInfo gci = {
+        .sType = VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO, .stageCount = 2, .pStages = st,
+        .pVertexInputState = &vi, .pInputAssemblyState = &ia, .pViewportState = &vps,
+        .pRasterizationState = &ras, .pMultisampleState = &ms, .pColorBlendState = &cb,
+        .pDynamicState = &dy, .layout = s_ao.pipe_layout, .renderPass = rp, .subpass = 0 };
+    return pvkCreateGraphicsPipelines(s_vk.device, s_pcache, 1, &gci, NULL, out) == VK_SUCCESS ? 0 : -1;
+}
+
+static int vk_ao_init(void)
+{
+    if (s_ao.tried) return s_ao.ok ? 0 : -1;
+    s_ao.tried = 1;
+    if (!rsx_hlsl_to_spirv_available()) return -1;
+    static char blur_h[sizeof kAoBlurFS + 64], blur_v[sizeof kAoBlurFS + 64];
+    snprintf(blur_h, sizeof blur_h, "#define AO_DIR int2(1, 0)\n%s", kAoBlurFS);
+    snprintf(blur_v, sizeof blur_v, "#define AO_DIR int2(0, 1)\n%s", kAoBlurFS);
+    const char* fs[VK_AO_N] = { kAoDownFS, kAoOccFS, blur_h, blur_v, kAoUpFS };
+    if (vk_ao_module("SSAO", kZcVS, RSX_SHADER_STAGE_VERTEX, &s_ao.vs)) return -1;
+    for (int i = 0; i < VK_AO_N; i++)
+        if (vk_ao_module("SSAO", fs[i], RSX_SHADER_STAGE_FRAGMENT, &s_ao.fs[i])) return -1;
+
+    VkDescriptorSetLayoutBinding b[3];
+    for (u32 i = 0; i < 3; i++)
+        b[i] = (VkDescriptorSetLayoutBinding){ RSX_SPIRV_TEXTURE_BINDING + i, VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE,
+                                               1, VK_SHADER_STAGE_FRAGMENT_BIT, NULL };
+    VkDescriptorSetLayoutCreateInfo lci = { .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO,
+                                            .bindingCount = 3, .pBindings = b };
+    if (pvkCreateDescriptorSetLayout(s_vk.device, &lci, NULL, &s_ao.set_layout) != VK_SUCCESS) return -1;
+    VkPushConstantRange pcr = { VK_SHADER_STAGE_FRAGMENT_BIT, 0, 28u * sizeof(float) };
+    VkPipelineLayoutCreateInfo plci = { .sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO,
+                                        .setLayoutCount = 1, .pSetLayouts = &s_ao.set_layout,
+                                        .pushConstantRangeCount = 1, .pPushConstantRanges = &pcr };
+    if (pvkCreatePipelineLayout(s_vk.device, &plci, NULL, &s_ao.pipe_layout) != VK_SUCCESS) return -1;
+    VkDescriptorPoolSize ps = { VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, 3u * VK_AO_SETS };
+    VkDescriptorPoolCreateInfo pci = { .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO,
+                                       .maxSets = VK_AO_SETS, .poolSizeCount = 1, .pPoolSizes = &ps };
+    if (pvkCreateDescriptorPool(s_vk.device, &pci, NULL, &s_ao.pool) != VK_SUCCESS ||
+        pvkCreateDescriptorPool(s_vk.device, &pci, NULL, &s_park.ao) != VK_SUCCESS) return -1;
+    if (vk_ao_render_pass(VK_FORMAT_R32_SFLOAT, &s_ao.rp_f32) ||
+        vk_ao_render_pass(VK_FORMAT_R8_UNORM, &s_ao.rp_r8)) return -1;
+    for (int i = 0; i < VK_AO_N; i++)
+        if (vk_ao_pipeline(s_ao.fs[i], i == VK_AO_Z ? s_ao.rp_f32 : s_ao.rp_r8, &s_ao.pipe[i])) return -1;
+    s_ao.ok = 1;
+    VK_LOG("engine: native SSAO passes ready\n");
+    return 0;
+}
+
+static void vk_ao_shutdown(void)
+{
+    for (int i = 0; i < VK_AO_N; i++) {
+        if (s_ao.pipe[i]) pvkDestroyPipeline(s_vk.device, s_ao.pipe[i], NULL);
+        if (s_ao.fs[i]) pvkDestroyShaderModule(s_vk.device, s_ao.fs[i], NULL);
+    }
+    if (s_ao.vs) pvkDestroyShaderModule(s_vk.device, s_ao.vs, NULL);
+    if (s_ao.rp_f32) pvkDestroyRenderPass(s_vk.device, s_ao.rp_f32, NULL);
+    if (s_ao.rp_r8) pvkDestroyRenderPass(s_vk.device, s_ao.rp_r8, NULL);
+    if (s_ao.pool) pvkDestroyDescriptorPool(s_vk.device, s_ao.pool, NULL);
+    if (s_park.ao) pvkDestroyDescriptorPool(s_vk.device, s_park.ao, NULL);
+    s_park.ao = VK_NULL_HANDLE; s_park.aon = 0;
+    if (s_ao.pipe_layout) pvkDestroyPipelineLayout(s_vk.device, s_ao.pipe_layout, NULL);
+    if (s_ao.set_layout) pvkDestroyDescriptorSetLayout(s_vk.device, s_ao.set_layout, NULL);
+    memset(&s_ao, 0, sizeof s_ao);    /* the images go with the object table */
+}
+
+/* One pass target: an engine texture with a framebuffer, in GENERAL. */
+static u32 vk_ao_target(VkFormat fmt, u32 bpp, u32 w, u32 h, VkRenderPass rp)
+{
+    const u32 hd = vk_eng_alloc();
+    if (!hd) return 0;
+    vk_eng_obj* o = &s_eobj[hd];
+    if (vk_create_image(&o->im, fmt, w, h,
+                        VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT |
+                        VK_IMAGE_USAGE_TRANSFER_SRC_BIT, VK_IMAGE_ASPECT_COLOR_BIT)) {
+        vk_destroy_image(&o->im); memset(o, 0, sizeof *o); return 0;
+    }
+    o->kind = VK_ENG_TEXTURE; o->fmt = fmt; o->bpp = bpp; o->w = w; o->h = h;
+    o->readable = 1;
+    VkFramebufferCreateInfo fci = { .sType = VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO,
+                                    .renderPass = rp, .attachmentCount = 1,
+                                    .pAttachments = &o->im.view, .width = w, .height = h, .layers = 1 };
+    if (pvkCreateFramebuffer(s_vk.device, &fci, NULL, &o->fb) != VK_SUCCESS) {
+        vk_destroy_image(&o->im); memset(o, 0, sizeof *o); return 0;
+    }
+    if (vk_op_begin()) return hd;
+    vk_barrier_image(o->im.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_UNDEFINED);
+    vk_op_end();
+    return hd;
+}
+
+static int vk_eng_native_ssao(void* user, u32 normals, u32 depth, const float params[28], u32 out[3])
+{
+    VK_CS(CS_NATIVE_SSAO);
+    /* The depth is the RGBA8 snapshot of a zeta. */
+    vk_eng_obj* nt = vk_eng_get(normals, VK_ENG_COLOR);
+    vk_eng_obj* dt = vk_eng_get(depth, VK_ENG_TEXTURE);
+    if (!nt || !dt || nt->w != dt->w || nt->h != dt->h || dt->w < 4u || dt->h < 4u ||
+        nt->fmt != VK_FORMAT_R8G8B8A8_UNORM || dt->fmt != VK_FORMAT_R8G8B8A8_UNORM || vk_ao_init())
+        return -1;
+    const u32 w = dt->w, h = dt->h, hw = (w + 1u) / 2u, hh = (h + 1u) / 2u;
+
+    /* Targets first: an older set is released (and destroyed with its batch). */
+    if (s_ao.w != w || s_ao.h != h || !vk_eng_get(s_ao.img[VK_AO_FULL], VK_ENG_TEXTURE)) {
+        for (int i = 0; i < VK_AO_N; i++) {
+            if (vk_eng_get(s_ao.img[i], VK_ENG_TEXTURE)) vk_eng_release(user, s_ao.img[i]);
+            s_ao.img[i] = 0;
+        }
+        s_ao.w = s_ao.h = 0;
+        s_ao.img[VK_AO_Z] = vk_ao_target(VK_FORMAT_R32_SFLOAT, 4u, hw, hh, s_ao.rp_f32);
+        for (int i = VK_AO_RAW; i <= VK_AO_V; i++)
+            s_ao.img[i] = vk_ao_target(VK_FORMAT_R8_UNORM, 1u, hw, hh, s_ao.rp_r8);
+        s_ao.img[VK_AO_FULL] = vk_ao_target(VK_FORMAT_R8_UNORM, 1u, w, h, s_ao.rp_r8);
+        for (int i = 0; i < VK_AO_N; i++) if (!s_ao.img[i]) return -1;
+        s_ao.w = w; s_ao.h = h;
+        VK_LOG("engine: native SSAO at %ux%u\n", w, h);
+    }
+    nt = vk_eng_get(normals, VK_ENG_COLOR);
+    dt = vk_eng_get(depth, VK_ENG_TEXTURE);
+    if (!nt || !dt) return -1;
+
+    const VkImageView zv = s_eobj[s_ao.img[VK_AO_Z]].im.view;
+    const VkImageView src[VK_AO_N][3] = {
+        { dt->im.view, dt->im.view, dt->im.view },
+        { zv, nt->im.view, zv },
+        { s_eobj[s_ao.img[VK_AO_RAW]].im.view, zv, zv },
+        { s_eobj[s_ao.img[VK_AO_H]].im.view, zv, zv },
+        { s_eobj[s_ao.img[VK_AO_V]].im.view, zv, dt->im.view },
+    };
+    if (s_ao.sets + VK_AO_N > VK_AO_SETS) vk_flush();
+    VkDescriptorSet set[VK_AO_N];
+    VkDescriptorSetLayout layouts[VK_AO_N];
+    for (int i = 0; i < VK_AO_N; i++) layouts[i] = s_ao.set_layout;
+    VkDescriptorSetAllocateInfo dai = { .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO,
+                                        .descriptorPool = s_ao.pool, .descriptorSetCount = VK_AO_N,
+                                        .pSetLayouts = layouts };
+    if (pvkAllocateDescriptorSets(s_vk.device, &dai, set) != VK_SUCCESS) return -1;
+    s_ao.sets += VK_AO_N;
+    VkDescriptorImageInfo ii[VK_AO_N][3];
+    VkWriteDescriptorSet wr[VK_AO_N * 3];
+    for (int i = 0; i < VK_AO_N; i++)
+        for (int k = 0; k < 3; k++) {
+            ii[i][k] = (VkDescriptorImageInfo){ VK_NULL_HANDLE, src[i][k], VK_IMAGE_LAYOUT_GENERAL };
+            wr[i * 3 + k] = (VkWriteDescriptorSet){
+                .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, .dstSet = set[i],
+                .dstBinding = RSX_SPIRV_TEXTURE_BINDING + (u32)k, .descriptorCount = 1,
+                .descriptorType = VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, .pImageInfo = &ii[i][k] };
+        }
+    pvkUpdateDescriptorSets(s_vk.device, VK_AO_N * 3, wr, 0, NULL);
+
+    if (vk_op_begin()) return -1;
+    pvkCmdPushConstants(s_vk.cmd, s_ao.pipe_layout, VK_SHADER_STAGE_FRAGMENT_BIT,
+                        0, 28u * sizeof(float), params);
+    for (int i = 0; i < VK_AO_N; i++) {
+        const vk_eng_obj* o = &s_eobj[s_ao.img[i]];
+        vk_global_barrier();
+        VkRenderPassBeginInfo rbi = { .sType = VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO,
+                                      .renderPass = i == VK_AO_Z ? s_ao.rp_f32 : s_ao.rp_r8,
+                                      .framebuffer = o->fb, .renderArea = { { 0, 0 }, { o->w, o->h } } };
+        pvkCmdBeginRenderPass(s_vk.cmd, &rbi, VK_SUBPASS_CONTENTS_INLINE);
+        pvkCmdBindPipeline(s_vk.cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, s_ao.pipe[i]);
+        VkViewport vp = { 0.0f, 0.0f, (float)o->w, (float)o->h, 0.0f, 1.0f };
+        VkRect2D sc = { { 0, 0 }, { o->w, o->h } };
+        pvkCmdSetViewport(s_vk.cmd, 0, 1, &vp);
+        pvkCmdSetScissor(s_vk.cmd, 0, 1, &sc);
+        pvkCmdBindDescriptorSets(s_vk.cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, s_ao.pipe_layout,
+                                 0, 1, &set[i], 0, NULL);
+        pvkCmdDraw(s_vk.cmd, 3, 1, 0, 0);
+        pvkCmdEndRenderPass(s_vk.cmd);
+    }
+    if (vk_op_end()) return -1;
+    out[0] = s_ao.img[VK_AO_FULL];
+    out[1] = s_ao.img[VK_AO_Z];
+    out[2] = s_ao.img[VK_AO_V];
+    return 0;
+}
+
+/* ---- native lighting (rsx_draw_backend.native_lighting) ------------------
+ * inFAMOUS 2's tiled deferred lighting job (P071) on the GPU: 40x18 tiles,
+ * up to 256 point and spot lights, the diffuse light square-root encoded with
+ * a shared scale in A and the specular intensity in A of a second image.
+ * Five compute passes: per light, bounds of the view-space positions per
+ * fifth of a tile, the lights that reach each tile, the pixels, and the
+ * tiles none of whose pixels a light reached. The images may have any size;
+ * the tile grid divides them. */
+#define VK_LT_SETS 16u
+#define VK_LT_MAX_LIGHTS 256u
+enum { VK_LT_LIGHTS, VK_LT_BOUNDS, VK_LT_CULL, VK_LT_SHADE, VK_LT_CLEAR, VK_LT_N };
+
+static struct {
+    int                   tried, ok;
+    VkDescriptorSetLayout set_layout;
+    VkPipelineLayout      pipe_layout;
+    VkDescriptorPool      pool;
+    u32                   sets;
+    VkShaderModule        cs[VK_LT_N];
+    VkPipeline            pipe[VK_LT_N];
+    VkBuffer              buf[4];            /* words, block bounds, tiles, lights */
+    VkDeviceMemory        mem[4];
+    VkDeviceSize          size[4];
+    u32                   img[2];            /* engine TEXTURE handles: diffuse, specular */
+    u32                   w, h;              /* of img[]                                 */
+    u32                   in[2];             /* latched normals and depth (native_latch) */
+} s_lt;
+
+/* Declarations every pass shares; the passes' own text follows. */
+static const char kLtCommon[] =
+    "// words: 0-15 the matrix from (x / 1280, y / 720, d24 / 2^24, 1) to view space,\n"
+    "// by columns; 16 colour scale; 17 light count; 22 offset of the view-to-clip\n"
+    "// matrix; 24, 25 image size; 26, 27 its inverse; 28, 29 pixel centre offset;\n"
+    "// from 32, 16 words a light.\n"
+    "[[vk::binding(0)]] StructuredBuffer<uint> words;\n"
+    "[[vk::binding(1)]] RWStructuredBuffer<float4> block_bounds;   // lo, hi per block\n"
+    "[[vk::binding(2)]] RWStructuredBuffer<uint> tiles;            // TILE_WORDS per tile\n"
+    "struct Light { float4 pos_radius; float4 colour_mag; float4 dir_kind; float4 falloff; };\n"
+    "[[vk::binding(3)]] RWStructuredBuffer<Light> lights;\n"
+    "Texture2D<float4> normals_tex : register(t0);   // material in A, normal in RGB\n"
+    "Texture2D<float4> depth_tex : register(t1);     // 24-bit depth in A, R, G\n"
+    "[[vk::binding(6)]] [[spv::format_rgba8]] RWTexture2D<unorm float4> diffuse_img;\n"
+    "[[vk::binding(7)]] [[spv::format_rgba8]] RWTexture2D<unorm float4> specular_img;\n"
+    "\n"
+    "static const int TILES_X = 40, TILES_Y = 18, TILES = 720, BLOCKS = 5;\n"
+    "static const uint MASK_WORDS = 8, TILE_WORDS = 16, TILE_ANY = 8, TILE_LIT = 9;\n"
+    "static const uint SKY = 0xFFFFFF;\n"
+    "\n"
+    "float P(uint i) { return asfloat(words[i]); }\n"
+    "float4 P4(uint i) { return float4(P(i), P(i + 1), P(i + 2), P(i + 3)); }\n"
+    "int img_w() { return int(words[24]); }\n"
+    "int img_h() { return int(words[25]); }\n"
+    "uint light_count() { return min(words[17], MASK_WORDS * 32); }\n"
+    "\n"
+    "float3 view_position(int2 px, uint d24)\n"
+    "{\n"
+    "    float x = (float(px.x) + P(28)) * P(26), y = (float(px.y) + P(29)) * P(27);\n"
+    "    float4 p = P4(0) * x + P4(4) * y + P4(8) * (float(d24) * exp2(-24.0)) + P4(12);\n"
+    "    return p.xyz / p.w;\n"
+    "}\n"
+    "// first pixel of a tile column, of a block row (BLOCKS rows per tile)\n"
+    "int tile_left(int tx) { return (tx * img_w() + TILES_X - 1) / TILES_X; }\n"
+    "int block_top(int by) { return (by * img_h() + TILES_Y * BLOCKS - 1) / (TILES_Y * BLOCKS); }\n"
+    "uint depth24(int2 p)\n"
+    "{\n"
+    "    uint3 b = uint3(depth_tex.Load(int3(p, 0)).arg * 255.0 + 0.5);\n"
+    "    return (b.x << 16) | (b.y << 8) | b.z;\n"
+    "}\n"
+    "// inside the outer radius and, for a spot, inside the cone\n"
+    "bool in_range(Light l, float3 to_light, float d2, float inv_d)\n"
+    "{\n"
+    "    float r = l.pos_radius.w;\n"
+    "    if (d2 >= r * r) return false;\n"
+    "    if (l.dir_kind.w != 2.0) return true;\n"
+    "    return dot(to_light, -l.dir_kind.xyz) * inv_d > l.falloff.z;\n"
+    "}\n"
+    "void store(int2 p, float4 diffuse, float specular)\n"
+    "{\n"
+    "    diffuse_img[p] = diffuse;\n"
+    "    specular_img[p] = float4(0.0, 0.0, 0.0, specular);\n"
+    "}\n";
+
+static const char* const kLtPass[VK_LT_N] = {
+    "// per light, what does not depend on the pixel\n"
+    "[numthreads(64, 1, 1)]\n"
+    "void main(uint3 id : SV_DispatchThreadID)\n"
+    "{\n"
+    "    uint l = id.x;\n"
+    "    if (l >= light_count()) return;\n"
+    "    uint o = 32 + 16 * l;\n"
+    "    float3 colour = P4(o + 4).xyz * P(16);\n"
+    "    float inner = P(o + 7), outer = P(o + 8);\n"
+    "    Light r;\n"
+    "    r.pos_radius = float4(P4(o).xyz, outer);\n"
+    "    r.colour_mag = float4(colour, length(colour));\n"
+    "    r.dir_kind = float4(P4(o + 12).xyz, float(words[o + 3]));\n"
+    "    r.falloff = float4(1.0 / (outer - inner), P(o + 9), P(o + 10), P(o + 11));\n"
+    "    lights[l] = r;\n"
+    "}\n",
+    "// one group per block of a tile; each thread 1/16 of its width, 1/4 of its height\n"
+    "groupshared float3 g_lo[64], g_hi[64];\n"
+    "[numthreads(16, 4, 1)]\n"
+    "void main(uint3 gid : SV_GroupID, uint3 tid : SV_GroupThreadID, uint ti : SV_GroupIndex)\n"
+    "{\n"
+    "    float3 lo = 3.402823e38, hi = -3.402823e38;\n"
+    "    int2 org = int2(tile_left(int(gid.x)), block_top(int(gid.y)));\n"
+    "    int2 size = int2(tile_left(int(gid.x) + 1), block_top(int(gid.y) + 1)) - org;\n"
+    "    int2 first = org + int2(tid.xy) * size / int2(16, 4), end = org + (int2(tid.xy) + 1) * size / int2(16, 4);\n"
+    "    for (int y = first.y; y < end.y; y++)\n"
+    "        for (int x = first.x; x < end.x; x++) {\n"
+    "            uint d = depth24(int2(x, y));\n"
+    "            if (d == SKY) continue;\n"
+    "            float3 p = view_position(int2(x, y), d);\n"
+    "            lo = min(lo, p);\n"
+    "            hi = max(hi, p);\n"
+    "        }\n"
+    "    g_lo[ti] = lo;\n"
+    "    g_hi[ti] = hi;\n"
+    "    for (uint step = 32; step != 0; step >>= 1) {\n"
+    "        GroupMemoryBarrierWithGroupSync();\n"
+    "        if (ti < step) {\n"
+    "            g_lo[ti] = min(g_lo[ti], g_lo[ti + step]);\n"
+    "            g_hi[ti] = max(g_hi[ti], g_hi[ti + step]);\n"
+    "        }\n"
+    "    }\n"
+    "    if (ti == 0) {\n"
+    "        uint e = ((gid.y / BLOCKS) * TILES_X + gid.x) * BLOCKS + gid.y % BLOCKS;\n"
+    "        block_bounds[2 * e] = float4(g_lo[0], 0.0);\n"
+    "        block_bounds[2 * e + 1] = float4(g_hi[0], 0.0);\n"
+    "    }\n"
+    "}\n",
+    "// per tile: the lights whose volume can reach it -- the box of its pixels,\n"
+    "// the four side planes of its frustum, a spot's cone against the box's sphere\n"
+    "float3 tile_corner(uint o, float x, float y)\n"
+    "{\n"
+    "    float4 p = P4(o) * x + P4(o + 4) * y + P4(o + 12);\n"
+    "    return p.xyz / p.w;\n"
+    "}\n"
+    "bool cone_reaches_sphere(float3 c, float radius, float3 apex, float range, float3 dir, float cosine)\n"
+    "{\n"
+    "    float3 d = c - apex;\n"
+    "    float d2 = dot(d, d), r2 = radius * radius;\n"
+    "    if (d2 > (radius + range) * (radius + range)) return false;\n"
+    "    if (r2 > d2) return true;\n"
+    "    float dist = sqrt(d2), s = radius / dist, tangent = sqrt(max(1.0 - s * s, 0.0));\n"
+    "    float u = tangent * dist > range ? (d2 + range * range - r2) / (2.0 * dist * range) : tangent;\n"
+    "    float threshold = u * cosine - sqrt(max((1.0 - u * u) * (1.0 - cosine * cosine), 0.0));\n"
+    "    return dot(dir, d) / dist > threshold;\n"
+    "}\n"
+    "[numthreads(64, 1, 1)]\n"
+    "void main(uint3 id : SV_DispatchThreadID)\n"
+    "{\n"
+    "    uint t = id.x;\n"
+    "    if (t >= uint(TILES)) return;\n"
+    "    float3 lo = 3.402823e38, hi = -3.402823e38;\n"
+    "    for (uint b = t * BLOCKS; b < t * BLOCKS + BLOCKS; b++) {\n"
+    "        lo = min(lo, block_bounds[2 * b].xyz);\n"
+    "        hi = max(hi, block_bounds[2 * b + 1].xyz);\n"
+    "    }\n"
+    "    uint mask[MASK_WORDS];\n"
+    "    [unroll] for (uint i = 0; i < MASK_WORDS; i++) mask[i] = 0;\n"
+    "    if (all(hi > lo)) {\n"
+    "        float3 centre = (lo + hi) * 0.5;\n"
+    "        float sphere = length(hi - lo) * 0.5;\n"
+    "        uint o = words[22];\n"
+    "        float tx = float(t % uint(TILES_X)), ty = float(t / uint(TILES_X));\n"
+    "        float left = tx * (2.0 / 40.0) - 1.0, right = (tx + 1.0) * (2.0 / 40.0) - 1.0;\n"
+    "        float top = 1.0 - ty * (2.0 / 18.0), bottom = 1.0 - (ty + 1.0) * (2.0 / 18.0);\n"
+    "        float3 k[4] = { tile_corner(o, right, top), tile_corner(o, left, top),\n"
+    "                        tile_corner(o, left, bottom), tile_corner(o, right, bottom) };\n"
+    "        float3 pl[4];\n"
+    "        [unroll] for (int j = 0; j < 4; j++) pl[j] = normalize(cross(k[(j + 1) % 4], k[j]));\n"
+    "        uint n = light_count();\n"
+    "        for (uint l = 0; l < n; l++) {\n"
+    "            Light li = lights[l];\n"
+    "            float3 pos = li.pos_radius.xyz;\n"
+    "            float r = li.pos_radius.w;\n"
+    "            float3 near = pos - clamp(pos, lo, hi);\n"
+    "            if (dot(near, near) >= r * r) continue;\n"
+    "            if (any(float4(dot(pl[0], pos), dot(pl[1], pos), dot(pl[2], pos), dot(pl[3], pos)) + r < 0.0)) continue;\n"
+    "            if (li.dir_kind.w == 2.0 && !cone_reaches_sphere(centre, sphere, pos, r, li.dir_kind.xyz, li.falloff.z)) continue;\n"
+    "            mask[l / 32] |= 1u << (l % 32);\n"
+    "        }\n"
+    "    }\n"
+    "    uint any_light = 0;\n"
+    "    [unroll] for (uint w = 0; w < MASK_WORDS; w++) { tiles[TILE_WORDS * t + w] = mask[w]; any_light |= mask[w]; }\n"
+    "    tiles[TILE_WORDS * t + TILE_ANY] = any_light;\n"
+    "    tiles[TILE_WORDS * t + TILE_LIT] = 0;\n"
+    "}\n",
+    "// per pixel: the diffuse light (square-root encoded RGB with a shared scale in\n"
+    "// A) and the specular intensity, from the lights of its tile\n"
+    "[numthreads(8, 8, 1)]\n"
+    "void main(uint3 id : SV_DispatchThreadID)\n"
+    "{\n"
+    "    int2 px = int2(id.xy);\n"
+    "    if (px.x >= img_w() || px.y >= img_h()) return;\n"
+    "    uint t = uint((px.y * TILES_Y / img_h()) * TILES_X + px.x * TILES_X / img_w());\n"
+    "    if (tiles[TILE_WORDS * t + TILE_ANY] == 0) return;\n"
+    "    const float SCALE = 0.35355338;    // 1 / (2 sqrt 2)\n"
+    "    uint4 tex = uint4(normals_tex.Load(int3(px, 0)).argb * 255.0 + 0.5);\n"
+    "    float3 normal = normalize(float3(tex.yzw) * (2.0 / 255.0) - 1.0);\n"
+    "    float3 pos = view_position(px, depth24(px));\n"
+    "    float3 view = normalize(pos);\n"
+    "    float gloss = exp2(float(tex.x) * (8.0 / 255.0) - 0.88895999);\n"
+    "    float spec_gain = gloss * 0.92592591 + 1.0;\n"
+    "    float3 diffuse = 0.0;\n"
+    "    float specular = 0.0;\n"
+    "    bool lit = false;\n"
+    "    for (uint w = 0; w < MASK_WORDS; w++)\n"
+    "        for (uint bits = tiles[TILE_WORDS * t + w]; bits != 0; bits &= bits - 1) {\n"
+    "            Light l = lights[w * 32 + firstbitlow(bits)];\n"
+    "            float3 to_light = l.pos_radius.xyz - pos;\n"
+    "            float d2 = dot(to_light, to_light), inv_d = rsqrt(d2);\n"
+    "            if (!in_range(l, to_light, d2, inv_d)) continue;\n"
+    "            lit = true;\n"
+    "            float dist = d2 * inv_d;\n"
+    "            float att = saturate((l.pos_radius.w - dist) * l.falloff.x);\n"
+    "            if (l.dir_kind.w == 2.0) {\n"
+    "                float angle = dot(to_light, -l.dir_kind.xyz) * inv_d;\n"
+    "                att = dist > l.falloff.w ? att * saturate(l.falloff.y * (l.falloff.z - angle)) : 0.0;\n"
+    "            }\n"
+    "            float3 dir = to_light * inv_d;\n"
+    "            float intensity = max(dot(normal, dir), 0.0) * att * att;\n"
+    "            diffuse += l.colour_mag.xyz * intensity;\n"
+    "            float n_dot_h = max(dot(normal, normalize(dir - view)), 0.0);\n"
+    "            float shape = (1.0 - n_dot_h) * gloss + 1.0;\n"
+    "            shape *= shape; shape *= shape; shape *= shape;\n"
+    "            specular += spec_gain * intensity * l.colour_mag.w / shape;\n"
+    "        }\n"
+    "    if (lit && tiles[TILE_WORDS * t + TILE_LIT] == 0) InterlockedOr(tiles[TILE_WORDS * t + TILE_LIT], 1u);\n"
+    "    float3 v = sqrt(diffuse);\n"
+    "    float a = min(floor(max(max(max(v.x, v.y), v.z), 1.0) * (SCALE * 255.0)), 255.0);\n"
+    "    float3 rgb = min(floor(v * (SCALE * 255.0 * 255.0) / a), 255.0);\n"
+    "    store(px, float4(rgb, a) / 255.0, min(floor(sqrt(specular) * (SCALE * 255.0)), 255.0) / 255.0);\n"
+    "}\n",
+    "// per pixel row of a tile: a tile none of whose pixels is in a light's range\n"
+    "// stays empty, even when a light volume reaches it\n"
+    "[numthreads(64, 1, 1)]\n"
+    "void main(uint3 id : SV_DispatchThreadID)\n"
+    "{\n"
+    "    uint i = id.x;\n"
+    "    if (i >= uint(TILES_X * img_h())) return;\n"
+    "    int tx = int(i % uint(TILES_X)), y = int(i / uint(TILES_X));\n"
+    "    uint t = uint((y * TILES_Y / img_h()) * TILES_X + tx);\n"
+    "    if (tiles[TILE_WORDS * t + TILE_LIT] != 0 || tiles[TILE_WORDS * t + TILE_ANY] == 0) return;\n"
+    "    for (int x = tile_left(tx); x < tile_left(tx + 1); x++) store(int2(x, y), 0.0, 0.0);\n"
+    "}\n"
+};
+
+static int vk_lt_buffer(u32 i, VkDeviceSize size, VkBufferUsageFlags usage)
+{
+    VkBufferCreateInfo bci = { .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+                               .size = size, .usage = usage, .sharingMode = VK_SHARING_MODE_EXCLUSIVE };
+    if (pvkCreateBuffer(s_vk.device, &bci, NULL, &s_lt.buf[i]) != VK_SUCCESS) return -1;
+    VkMemoryRequirements req;
+    pvkGetBufferMemoryRequirements(s_vk.device, s_lt.buf[i], &req);
+    u32 type;
+    if (vk_find_memory_type(req.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT, &type) &&
+        vk_find_memory_type(req.memoryTypeBits, 0, &type))
+        return -1;
+    VkMemoryAllocateInfo mai = { .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+                                 .allocationSize = req.size, .memoryTypeIndex = type };
+    if (pvkAllocateMemory(s_vk.device, &mai, NULL, &s_lt.mem[i]) != VK_SUCCESS) return -1;
+    if (pvkBindBufferMemory(s_vk.device, s_lt.buf[i], s_lt.mem[i], 0) != VK_SUCCESS) return -1;
+    s_lt.size[i] = size;
+    return 0;
+}
+
+static int vk_lt_init(void)
+{
+    if (s_lt.tried) return s_lt.ok ? 0 : -1;
+    s_lt.tried = 1;
+    if (!rsx_hlsl_to_spirv_available() || !(s_vk_queue_flags & VK_QUEUE_COMPUTE_BIT)) return -1;
+    static char src[16384];
+    for (int i = 0; i < VK_LT_N; i++) {
+        snprintf(src, sizeof src, "%s%s", kLtCommon, kLtPass[i]);
+        if (vk_ao_module("lighting", src, RSX_SHADER_STAGE_COMPUTE, &s_lt.cs[i])) return -1;
+    }
+    VkDescriptorSetLayoutBinding b[8];
+    for (u32 i = 0; i < 4; i++)
+        b[i] = (VkDescriptorSetLayoutBinding){ i, VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 1,
+                                               VK_SHADER_STAGE_COMPUTE_BIT, NULL };
+    for (u32 i = 0; i < 2; i++) {
+        b[4 + i] = (VkDescriptorSetLayoutBinding){ 6u + i, VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, 1,
+                                                   VK_SHADER_STAGE_COMPUTE_BIT, NULL };
+        b[6 + i] = (VkDescriptorSetLayoutBinding){ RSX_SPIRV_TEXTURE_BINDING + i,
+                                                   VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, 1,
+                                                   VK_SHADER_STAGE_COMPUTE_BIT, NULL };
+    }
+    VkDescriptorSetLayoutCreateInfo lci = { .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO,
+                                            .bindingCount = 8, .pBindings = b };
+    if (pvkCreateDescriptorSetLayout(s_vk.device, &lci, NULL, &s_lt.set_layout) != VK_SUCCESS) return -1;
+    VkPipelineLayoutCreateInfo plci = { .sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO,
+                                        .setLayoutCount = 1, .pSetLayouts = &s_lt.set_layout };
+    if (pvkCreatePipelineLayout(s_vk.device, &plci, NULL, &s_lt.pipe_layout) != VK_SUCCESS) return -1;
+    VkDescriptorPoolSize ps[3] = {
+        { VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 4u * VK_LT_SETS },
+        { VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, 2u * VK_LT_SETS },
+        { VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, 2u * VK_LT_SETS } };
+    VkDescriptorPoolCreateInfo pci = { .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO,
+                                       .maxSets = VK_LT_SETS, .poolSizeCount = 3, .pPoolSizes = ps };
+    if (pvkCreateDescriptorPool(s_vk.device, &pci, NULL, &s_lt.pool) != VK_SUCCESS ||
+        pvkCreateDescriptorPool(s_vk.device, &pci, NULL, &s_park.lt) != VK_SUCCESS) return -1;
+    for (int i = 0; i < VK_LT_N; i++) {
+        VkComputePipelineCreateInfo cpi = {
+            .sType = VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO,
+            .stage = { .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
+                       .stage = VK_SHADER_STAGE_COMPUTE_BIT, .module = s_lt.cs[i], .pName = "main" },
+            .layout = s_lt.pipe_layout };
+        if (pvkCreateComputePipelines(s_vk.device, s_pcache, 1, &cpi, NULL, &s_lt.pipe[i]) != VK_SUCCESS)
+            return -1;
+    }
+    /* Words: a 32-word header, 16 a light, the 16-word clip matrix. */
+    const VkBufferUsageFlags st = VK_BUFFER_USAGE_STORAGE_BUFFER_BIT;
+    if (vk_lt_buffer(0, (32u + 16u * VK_LT_MAX_LIGHTS + 16u) * 4u, st | VK_BUFFER_USAGE_TRANSFER_DST_BIT) ||
+        vk_lt_buffer(1, 40u * 18u * 5u * 32u, st) || vk_lt_buffer(2, 40u * 18u * 64u, st) ||
+        vk_lt_buffer(3, VK_LT_MAX_LIGHTS * 64u, st))
+        return -1;
+    s_lt.ok = 1;
+    VK_LOG("engine: native lighting passes ready\n");
+    return 0;
+}
+
+static void vk_lt_shutdown(void)
+{
+    for (int i = 0; i < VK_LT_N; i++) {
+        if (s_lt.pipe[i]) pvkDestroyPipeline(s_vk.device, s_lt.pipe[i], NULL);
+        if (s_lt.cs[i]) pvkDestroyShaderModule(s_vk.device, s_lt.cs[i], NULL);
+    }
+    for (int i = 0; i < 4; i++) {
+        if (s_lt.buf[i]) pvkDestroyBuffer(s_vk.device, s_lt.buf[i], NULL);
+        if (s_lt.mem[i]) pvkFreeMemory(s_vk.device, s_lt.mem[i], NULL);
+    }
+    if (s_lt.pool) pvkDestroyDescriptorPool(s_vk.device, s_lt.pool, NULL);
+    if (s_park.lt) pvkDestroyDescriptorPool(s_vk.device, s_park.lt, NULL);
+    s_park.lt = VK_NULL_HANDLE; s_park.ltn = 0;
+    if (s_lt.pipe_layout) pvkDestroyPipelineLayout(s_vk.device, s_lt.pipe_layout, NULL);
+    if (s_lt.set_layout) pvkDestroyDescriptorSetLayout(s_vk.device, s_lt.set_layout, NULL);
+    memset(&s_lt, 0, sizeof s_lt);    /* the images go with the object table */
+}
+
+/* The engine TEXTURE handle `*hd` as an RGBA8 image of w x h with `usage`,
+ * created (or created again at another size) as needed, in GENERAL. */
+static int vk_lt_image(void* user, u32* hd, u32 w, u32 h, VkImageUsageFlags usage)
+{
+    vk_eng_obj* o = vk_eng_get(*hd, VK_ENG_TEXTURE);
+    if (o && o->w == w && o->h == h && o->fmt == VK_FORMAT_R8G8B8A8_UNORM) return 0;
+    if (o) vk_eng_release(user, *hd);   /* destroyed once the batch is done with it */
+    *hd = vk_eng_alloc();
+    if (!*hd) return -1;
+    o = &s_eobj[*hd];
+    if (vk_create_image(&o->im, VK_FORMAT_R8G8B8A8_UNORM, w, h, usage, VK_IMAGE_ASPECT_COLOR_BIT)) {
+        vk_destroy_image(&o->im); memset(o, 0, sizeof *o); *hd = 0; return -1;
+    }
+    o->kind = VK_ENG_TEXTURE; o->fmt = VK_FORMAT_R8G8B8A8_UNORM; o->bpp = 4; o->w = w; o->h = h;
+    o->readable = (usage & VK_IMAGE_USAGE_TRANSFER_SRC_BIT) != 0;
+    /* Into GENERAL now, or not kept: a later call would find it the right
+     * size and use it in a layout it never got. */
+    if (vk_op_begin()) { vk_eng_release(user, *hd); *hd = 0; return -1; }
+    vk_barrier_image(o->im.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_UNDEFINED);
+    return vk_op_end();
+}
+
+/* rsx_draw_backend.native_latch: a private copy of one G-buffer image as it
+ * stands now, for a lighting pass that runs later in the frame. */
+static int vk_eng_native_latch(void* user, u32 which, u32 src)
+{
+    /* A colour target, or a texture made to be copied from. */
+    vk_eng_obj* o = vk_eng_get(src, VK_ENG_COLOR);
+    if (!o) { o = vk_eng_get(src, VK_ENG_TEXTURE); if (o && !o->readable) o = NULL; }
+    if (which > 1u || !o || o->fmt != VK_FORMAT_R8G8B8A8_UNORM || o->block || o->cube) return -1;
+    const u32 w = o->w, h = o->h;
+    if (vk_lt_image(user, &s_lt.in[which], w, h, VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT))
+        return -1;
+    o = vk_eng_get(src, VK_ENG_COLOR);
+    if (!o) o = vk_eng_get(src, VK_ENG_TEXTURE);
+    if (!o) return -1;
+    if (vk_op_begin()) return -1;
+    vk_global_barrier();
+    VkImageCopy r = { .srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+                      .dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+                      .extent = { w, h, 1 } };
+    pvkCmdCopyImage(s_vk.cmd, o->im.img, VK_IMAGE_LAYOUT_GENERAL,
+                    s_eobj[s_lt.in[which]].im.img, VK_IMAGE_LAYOUT_GENERAL, 1, &r);
+    vk_global_barrier();
+    return vk_op_end();
+}
+
+static int vk_eng_native_lighting(void* user, const u32* words, u32 count, u32 out[2])
+{
+    VK_CS(CS_NATIVE_LIGHTING);
+    vk_eng_obj* nt = vk_eng_get(s_lt.in[0], VK_ENG_TEXTURE);
+    vk_eng_obj* dt = vk_eng_get(s_lt.in[1], VK_ENG_TEXTURE);
+    if (!nt || !dt || nt->w != dt->w || nt->h != dt->h || nt->w < 40u || nt->h < 18u ||
+        !count || vk_lt_init() || count * 4u > s_lt.size[0] || count * 4u > 65536u)
+        return -1;
+    const u32 w = nt->w, h = nt->h;
+    /* Outputs first: releasing an older pair flushes. */
+    if (s_lt.w != w || s_lt.h != h || !vk_eng_get(s_lt.img[0], VK_ENG_TEXTURE) ||
+        !vk_eng_get(s_lt.img[1], VK_ENG_TEXTURE)) {
+        s_lt.w = s_lt.h = 0;
+        for (int i = 0; i < 2; i++)
