+/* Whole-quadword bit shifts and rotates by 0..7: per 32-bit lane, with the bits
+ * that cross a lane boundary taken from the neighbouring lane (a byte shift or
+ * a lane rotate of the whole vector). The scalar forms assemble 64-bit halves in
+ * general registers, which took every operand out of and back into a vector
+ * register; a shift count of 32 is 0 in SSE, so a count of 0 needs no branch.
+ * tests/test_spu_int_neon.c checks them against spu_X_ref. */
+#if defined(__SSE4_1__) && !defined(SPU_SCALAR_HELPERS) && !defined(SPU_SCALAR_INT)
+static inline __m128i spu__q_ld(u128 a) { __m128i v; memcpy(&v, &a, 16); return v; }
+static inline u128 spu__q_st(__m128i v) { u128 r; memcpy(&r, &v, 16); return r; }
+/* SPU word i is host lane i, and word 0 is the most significant: shifting the
+ * quadword left moves bits from word i+1 into word i. */
+static inline u128 spu__q_shl(u128 a, int sh, int rotate) {
+    const __m128i A = spu__q_ld(a);
+    const __m128i next = rotate ? _mm_shuffle_epi32(A, _MM_SHUFFLE(0, 3, 2, 1)) : _mm_srli_si128(A, 4);
+    return spu__q_st(_mm_or_si128(_mm_sll_epi32(A, _mm_cvtsi32_si128(sh)),
+                                  _mm_srl_epi32(next, _mm_cvtsi32_si128(32 - sh))));
+}
+static inline u128 spu__q_shr(u128 a, int sh) {             /* logical, zero fill */
+    const __m128i A = spu__q_ld(a);
+    return spu__q_st(_mm_or_si128(_mm_srl_epi32(A, _mm_cvtsi32_si128(sh)),
+                                  _mm_sll_epi32(_mm_slli_si128(A, 4), _mm_cvtsi32_si128(32 - sh))));
+}
+static inline u128 spu_shlqbii(u128 a, int sh)   { return spu__q_shl(a, sh & 7, 0); }
+static inline u128 spu_rotqbii(u128 a, int sh)   { return spu__q_shl(a, sh & 7, 1); }
