+/* PS3RECOMP_VK_CALLSTATS=1: per 10 s, how often the engine called each
+ * backend entry that returns something, waits or creates -- what a thread
+ * recording beside the engine would have to wait for. */
+enum { CS_SURFACE_VIEW, CS_COLOR_SNAPSHOT, CS_DEPTH_SNAPSHOT, CS_DEPTH_SNAPSHOT_RGBA8, CS_TEXTURE_CREATE, CS_TEXTURE_UPLOAD, CS_COLOR_TARGET_CREATE, CS_DEPTH_TARGET_CREATE, CS_PIPELINE_CREATE, CS_READBACK, CS_READBACK_DEFERRED, CS_DEPTH_READBACK, CS_STENCIL_READBACK, CS_SUBMIT_AND_WAIT, CS_NATIVE_SSAO, CS_NATIVE_LIGHTING, CS_BIND_TARGETS, CS_RELEASE, CS_GEO_PUT, CS_CLEAR_COLOR, CS_CLEAR_DEPTH_STENCIL, CS_N };
+static const char* const s_cs_name[CS_N] = { "surface_view", "color_snapshot", "depth_snapshot", "depth_snapshot_rgba8", "texture_create", "texture_upload", "color_target_create", "depth_target_create", "pipeline_create", "readback", "readback_deferred", "depth_readback", "stencil_readback", "submit_and_wait", "native_ssao", "native_lighting", "bind_targets", "release", "geo_put", "clear_color", "clear_depth_stencil" };
+static u64 s_cs[CS_N];
+#define VK_CS(k) (s_cs[k]++)
+static void vk_cs_report(void)
+{
+    static int on = -1; static u64 t0; static u32 frames;
+    if (on < 0) { const char* e = getenv("PS3RECOMP_VK_CALLSTATS"); on = e && e[0] == '1'; }
+    if (!on) return;
+    frames++;
+    struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
+    const u64 now = (u64)ts.tv_sec;
+    if (!t0) t0 = now;
+    if (now - t0 < 10) return;
+    char line[1024]; int o = snprintf(line, sizeof line, "[vk calls] per frame (%u frames):", frames);
+    for (u32 k = 0; k < CS_N && o < (int)sizeof line - 40; k++)
+        if (s_cs[k]) o += snprintf(line + o, sizeof line - (size_t)o, " %s %.1f", s_cs_name[k], (double)s_cs[k] / frames);
+    VK_LOG("%s\n", line);
+    memset(s_cs, 0, sizeof s_cs); frames = 0; t0 = now;
+}
