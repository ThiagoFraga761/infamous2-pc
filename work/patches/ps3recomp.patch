+        spu_ls_write128(ctx, ctx->gpr[27]._u32[0] + ctx->gpr[12]._u32[0], ctx->gpr[36]);
+        ctx->gpr[37] = spu_selb(ctx->gpr[15], ctx->gpr[0], ctx->gpr[37]);
+        ctx->gpr[12] = spu_a(ctx->gpr[12], ctx->gpr[14]);
+        ctx->gpr[14] = spu_ai(ctx->gpr[9], 0);
+        ctx->pc = ctx->gpr[37]._u32[0]; g_spu_trampoline_fn = spu_indirect_branch; return;
+        /* nop */;
+        /* nop */;
+        /* nop */;
+        /* nop */;
