+    /* Cube units: TEX r1 <- unit 0 (2D) at tc0, TEX r0 <- unit 2 (cube) at
+     * tc1. Without RSX_FP_CUBE_BANK every unit is its own tN register; with it
+     * the 2D units stay in the rsx_tex array and the cubes go to rsx_texc. */
+    {
+        u8 prog[32];
+        put_word(prog + 0,  OPC(0x17) | OUTMASK_ALL | OUTREG(1) | INSRC(4) | TEXU(0));
+        put_word(prog + 4,  T_INPUT | SWZ_IDENT | EXEC_ALWAYS);
+        put_word(prog + 8,  0);
+        put_word(prog + 12, 0);
+        put_word(prog + 16, OPC(0x17) | OUTMASK_ALL | OUTREG(0) | INSRC(5) | TEXU(2) | END);
+        put_word(prog + 20, T_INPUT | SWZ_IDENT | EXEC_ALWAYS);
+        put_word(prog + 24, 0);
+        put_word(prog + 28, 0);
+
+        rsx_fp_decompile_ex(prog, sizeof(prog), CTRL_32BIT, 1u << 2, hlsl, sizeof(hlsl));
+        check("cube_units_decl", hlsl, "TextureCube rsx_tex2 : register(t2);");
+        check("cube_units_2d",   hlsl, "rsx_tex0.Sample(rsx_samp[0], ((input.tc0).xyzw).xy)");
+        check("cube_units_cube", hlsl, "rsx_tex2.Sample(rsx_samp[2], ((input.tc1).xyzw).xyz)");
+
+        rsx_fp_decompile_ex(prog, sizeof(prog), CTRL_32BIT, (1u << 2) | RSX_FP_CUBE_BANK,
+                            hlsl, sizeof(hlsl));
+        check("cube_bank_2d_decl",   hlsl, "Texture2D    rsx_tex[16] : register(t0);");
+        check("cube_bank_cube_decl", hlsl, "TextureCube  rsx_texc[16] : register(t48);");
+        check("cube_bank_2d",   hlsl, "rsx_tex[0].Sample(rsx_samp[0], ((input.tc0).xyzw).xy)");
+        check("cube_bank_cube", hlsl, "rsx_texc[2].Sample(rsx_samp[2], ((input.tc1).xyzw).xyz)");
+        check_absent("cube_bank_no_units", hlsl, "rsx_tex2");
+
+        /* OPDEST.exp_tex (bit 21): the fetch is expanded to [-1,1]. */
+        put_word(prog + 0, OPC(0x17) | OUTMASK_ALL | OUTREG(1) | INSRC(4) | TEXU(0) | (1u << 21));
+        rsx_fp_decompile_ex(prog, sizeof(prog), CTRL_32BIT, 0, hlsl, sizeof(hlsl));
+        check("exp_tex", hlsl, "(rsx_tex[0].Sample(rsx_samp[0], ((input.tc0).xyzw).xy)) * 2.0 - 1.0");
+        check_absent("exp_tex_only_that_fetch", hlsl, "(rsx_tex[2].Sample(rsx_samp[2], ((input.tc1).xyzw).xy)) * 2.0");
+        put_word(prog + 0, OPC(0x17) | OUTMASK_ALL | OUTREG(1) | INSRC(4) | TEXU(0));
+
+        /* Per-unit texture ops (RPCS3 format_ex / _process_texel). Unit 0:
+         * gamma on R,G,B, BIASED on all four -- gamma wins on R,G,B, so only
+         * A expands; unit 2: a depth compare (zfunc 4) -- TEX here, so ref
+         * is coord.z. */
+        {
+            u32 ops[16] = { 0 };
+            ops[0] = RSX_FP_TEXOP_GAMMA_R | RSX_FP_TEXOP_GAMMA_G | RSX_FP_TEXOP_GAMMA_B |
+                     (0xFu << RSX_FP_TEXOP_EXPAND_SHIFT) | (0xFu << RSX_FP_TEXOP_BX2_SHIFT);
+            ops[2] = RSX_FP_TEXOP_SHADOW | (4u << RSX_FP_TEXOP_ZFUNC_SHIFT);
+            u32 nk = 0;
+            rsx_fp_decompile_buffered_ex2(prog, sizeof(prog), CTRL_32BIT, 0, ops,
+                                          hlsl, sizeof(hlsl), &nk);
+            check("texop_gamma_then_expand", hlsl,
+                  "rsx_texop(rsx_tex[0].Sample(rsx_samp[0], ((input.tc0).xyzw).xy), float4(0, 0, 0, 0), "
+                  "float4(1, 1, 1, 0), float4(0, 0, 0, 1), 0, 0)");
+            check("texop_helper", hlsl, "float4 rsx_texop(float4 c, float4 ms, float4 mg, float4 me, int bx2, int w16)");
+            check("texop_shadow", hlsl, "rsx_shadow(rsx_tex[2], rsx_samp[2], ((input.tc1).xyzw).xyz, 4)");
+            check("texop_shadow_helper", hlsl, "float4 rsx_shadow(Texture2D t, SamplerState s, float3 p, uint f)");
+            check("texop_shadow_texel_first", hlsl, "rsx_zcmp(t.GatherRed(s, p.xy), saturate(p.zzzz), f)");
