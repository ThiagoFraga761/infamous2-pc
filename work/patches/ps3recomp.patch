+                        n * 1e9 / (double)(now - t0), ns / 1e6 * 1e9 / (double)(now - t0),
+                        n ? ns / 1e6 / (double)n : 0.0, (unsigned long long)s_vk_compiles,
+                        s_vk_compile_ns / 1e6);
