+def add_loop_ticks(lines: list[str]) -> list[str]:
+    """--loop-budget: a step tick at every loop head, i.e. every label a later
+    line branches back to. A loop inside one function never comes back to the
+    trampoline, so the step budget of a SPURS job (spu_run_spurs_job) cannot
+    see it otherwise. The tick only reads ctx and leaves through an exit, so
+    --local-regs keeps the loop's registers in locals."""
+    seen, heads = set(), set()
+    for line in lines:
+        st = line.strip()
+        if _LABEL_RE.fullmatch(st):
+            seen.add(st[:-1])
+            continue
