# Allowlist: everything is ignored unless it is named below. The game, the
# dumps, anything generated from them (lifted code, builds, logs, saves) and
# local tools never reach the repository, whatever lands in this directory.
/*
!/.gitignore
!/README.md
!/LICENSE
!/CREDITS.md
!/CHANGELOG.md
!/docs/
!/scripts/
!/.github/
!/rpi/
!/work/

/work/*
!/work/play.sh
!/work/port/
!/work/tools/
!/work/tests/
!/work/patches/

/work/port/*
!/work/port/CMakeLists.txt
!/work/port/main.cpp
!/work/port/stubs.cpp
!/work/port/port_cpu_check.c
!/work/port/native_passes.c
!/work/port/re_trace.c
!/work/port/ppu_native.cpp
!/work/port/ppu_native.h
!/work/port/job2025_kernels_native.c
!/work/port/ec5f_native.c
!/work/port/job2025_native.c
!/work/port/edge_kernels_native.c
!/work/port/jobbc11_native.c
!/work/port/job207_native.c
!/work/port/job220_native.c
!/work/port/windows/
!/work/port/config.toml
!/work/port/settings.cpp
!/work/port/settings.h
!/work/port/ui.cpp
!/work/port/ui.h
!/work/port/tests/
/work/port/tests/*
!/work/port/tests/*.cpp
!/work/port/tools/
/work/port/tools/*
!/work/port/tools/spu_cc.sh
!/work/port/tools/ppu_cxx.sh
!/work/port/tools/gen_anim_kernels.sh
!/work/port/tools/kgen.py
!/work/port/tools/kwide.py
!/work/port/tools/kabi.py
!/work/port/tools/kw/

/work/tools/*
!/work/tools/lift_spu.py
!/work/tools/ppu_native_entries.py
!/work/tools/ppm2png.py
!/work/tools/rsx_decode.py
!/work/tools/hitch_classify.py
!/work/tools/re/

/work/tests/*
!/work/tests/*.sh

/work/patches/*
!/work/patches/ps3recomp.patch

__pycache__/

# perf captures kept beside the design notes: samples of a local build
/rpi/**/*.data
/rpi/**/*.log

# player mods (docs/MODS.md)
/mods/
